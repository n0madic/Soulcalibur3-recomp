# Track only port sources and tooling. Game-derived material stays local.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/Makefile
!/README.md
!/launch.command
!/recomp/
/recomp/*
!/recomp/README.md
!/recomp/build.sh
!/recomp/run.sh
!/recomp/port.py
!/recomp/keys.ini
!/recomp/ps2-native-recomp.commit
!/recomp/series
!/recomp/patches/
!/recomp/tests/
/recomp/patches/*
!/recomp/patches/*.patch
/recomp/tests/*
!/recomp/tests/test_*.py
/recomp/work/
**/__pycache__/
**/.cache/
**/.ccache/
*.py[cod]
*.log
*.tmp
*.orig
*.rej
.DS_Store
._*
