@@ -1393,6 +1393,56 @@ void register_ps2_vu1_tests()
                      "XGKICK resource stalls should consume VU cycles");
         });
 
+        tc.Run("XGKICK in a later execute sends only its own packet bytes", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            std::vector<std::vector<uint8_t>> captured;
+            mem.setGifPacketCallback([&](const uint8_t *packet, uint32_t sizeBytes)
+            {
+                captured.emplace_back(packet, packet + sizeBytes);
+            });
+
+            std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0u);
+            GS gs;
+            gs.init(vram.data(), static_cast<uint32_t>(vram.size()), nullptr);
+            uint8_t *code = mem.getVU1Code();
+            uint8_t *data = mem.getVU1Data();
+            std::memset(code, 0, PS2_VU1_CODE_SIZE);
+            std::memset(data, 0, PS2_VU1_DATA_SIZE);
+
+            // A three-qword packet at qword 0, then a one-qword packet at qword 8.
+            const uint64_t longTag = makeGifTag(3u, GIF_FMT_IMAGE, 0u, true);
+            const uint64_t shortTag = makeGifTag(1u, GIF_FMT_IMAGE, 0u, true);
+            std::memcpy(data + 0u, &longTag, sizeof(longTag));
+            std::memset(data + 16u, 0x33, 48u);
+            std::memcpy(data + 128u, &shortTag, sizeof(shortTag));
+            std::memset(data + 144u, 0x44, 16u);
+            writeVuInstructionPair(code, 0u, makeVuLowerSpecial(0x6Cu, 1u), kVuUpperNop);
+            writeVuInstructionPair(code, 8u, 0u, kVuUpperNop);
+            writeVuInstructionPair(code, 16u, 0u, kVuUpperNop);
+            writeVuInstructionPair(code, 24u, 0u, kVuUpperNop);
+            writeVuInstructionPair(code, 32u, 0u, kVuUpperNop);
+
+            VU1Interpreter vu1;
+            vu1.state().vi[1] = 0;
+            vu1.execute(code, PS2_VU1_CODE_SIZE, data, PS2_VU1_DATA_SIZE, gs, &mem, 0u, 0u, 0u, 16u);
+            vu1.state().vi[1] = 8;
+            vu1.execute(code, PS2_VU1_CODE_SIZE, data, PS2_VU1_DATA_SIZE, gs, &mem, 0u, 0u, 0u, 16u);
+
+            t.Equals(captured.size(), static_cast<size_t>(2u), "each execute should deliver its packet");
+            if (captured.size() == 2u)
+            {
+                t.Equals(captured[0].size(), static_cast<size_t>(64u), "first packet is tag plus three qwords");
+                t.Equals(captured[1].size(), static_cast<size_t>(32u), "second packet is tag plus one qword");
+                std::vector<uint8_t> expected(32u, 0u);
+                std::memcpy(expected.data(), &shortTag, sizeof(shortTag));
+                std::memset(expected.data() + 16u, 0x44, 16u);
+                t.IsTrue(captured[1] == expected, "second packet must not carry bytes of the first");
+            }
+        });
+
         tc.Run("synthetic Code Veronica text packet preserves black-frame PATH1 data", [](TestCase &t)
