diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index 44c2494..3700ffb 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -1051,6 +1051,43 @@ int main()
     if (!expect(lowPriorityMarker == 1u,
                 "WaitVblankEnd returned immediately and starved a lower-priority IOP thread")) return 1;
 
+    // The EE runtime feeds the IOP one cycle per guest call; idle skipping
+    // must wake the VBlank waiter exactly as a single long run does.
+    const auto runVblankIrx = [&](bool stepped, uint64_t iopCycles)
+    {
+        iop.reset();
+        writeVblankSchedulingIrx(host, 0x100u);
+        const ModuleLoadResult module = iop.loadModuleBuffer(0x100u);
+        const DebugSnapshot before = iop.debugSnapshot();
+        if (stepped)
+        {
+            for (uint64_t step = 0; step < iopCycles; ++step)
+                iop.runEeCycles(8u);
+        }
+        else
+        {
+            iop.runEeCycles(8u * iopCycles);
+        }
+        DebugSnapshot after = iop.debugSnapshot();
+        after.emulatorCycles -= before.emulatorCycles;
+        after.emulatorInstructions -= before.emulatorInstructions;
+        return std::make_pair(module, after);
+    };
+    constexpr uint64_t kThreeVblanks = 2'000'000u; // a little over three VBlank periods
+    const auto [shortModule, shortRun] = runVblankIrx(false, 1000u);
+    const auto [bulkModule, bulkRun] = runVblankIrx(false, kThreeVblanks);
+    const auto [steppedModule, steppedRun] = runVblankIrx(true, kThreeVblanks);
+    if (!expect(shortModule.handled && shortModule.startResult == 0 &&
+                    bulkModule.handled && bulkModule.startResult == 0 &&
+                    steppedModule.handled && steppedModule.startResult == 0,
+                "Synthetic VBlank scheduling IRX did not start for the stepped comparison")) return 1;
+    if (!expect(steppedRun.emulatorCycles == bulkRun.emulatorCycles,
+                "Stepped IOP cycles did not match a single run of the same length")) return 1;
+    if (!expect(bulkRun.emulatorInstructions >= shortRun.emulatorInstructions + 6u,
+                "The VBlank waiter did not run again after each VBlank")) return 1;
+    if (!expect(steppedRun.emulatorInstructions == bulkRun.emulatorInstructions,
+                "Idle skipping changed how often the VBlank waiter ran")) return 1;
+
     iop.reset();
     host.logs.clear();
     writeMcmanRegistrationIrx(host, 0x100u);
