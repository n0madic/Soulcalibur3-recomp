-    for (uint32_t index = 0; index < usage.vfReadCount; ++index)
+    inline int nextSlot(uint32_t &bits)
     {
-        if (usage.vfRead[index].reg == reg)
-        {
-            usage.vfRead[index].lanes |= lanes;
-            return;
-        }
+        const int slot = std::countr_zero(bits);
+        bits &= bits - 1u;
+        return slot;
     }
