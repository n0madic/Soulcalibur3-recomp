+        tc.Run("sceGifPk CNT tag counts its A+D payload once, with a HLE or a guest terminate", [](TestCase &t)
+        {
+            // Soulcalibur III's movie chain: the runtime's sceGifPkAddGsAD appends A+D pairs, then the game's
+            // own sceGifPkTerminate adds (current - tag) / 16 - 1 to the open tag. Counting the payload while
+            // appending as well made that CNT 6 instead of 3.
+            constexpr uint32_t stateAddr = 0x1000u;
+            constexpr uint32_t baseAddr = 0x2000u;
+            auto buildCntWithTwoAd = [&](std::vector<uint8_t> &rdram, PS2Runtime &runtime)
+            {
+                R5900Context ctx{};
+                setRegU32(ctx, 4, stateAddr);
+                setRegU32(ctx, 5, baseAddr);
+                ps2_stubs::sceGifPkInit(rdram.data(), &ctx, &runtime);
