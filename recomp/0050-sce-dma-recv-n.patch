From 623ae78f7210f2e6fb76e25bd680f66957f444ab Mon Sep 17 00:00:00 2001
From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Fri, 23 Oct 2026 16:38:16 +0300
Subject: [PATCH] Implement sceDmaRecvN as a normal-mode transfer into memory

Soulcalibur III swaps the scratchpad when its main menu starts: it saves
16 KB over the fromSPR channel (sceDmaGetChan(8), sadr 0,
sceDmaRecvN(chan, 0x62be00, 0x400)) and loads another 16 KB over toSPR.
sceDmaRecvN was a TODO stub that stopped the runtime, so pressing Start on
the title screen ended the game. It now submits the transfer like
sceDmaSendN, with DIR = 0; the scratchpad DMA engine already moves the
data.
---
 ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp      |  2 +-
 .../src/lib/Kernel/Stubs/Helpers/Support.h    |  5 +++-
 ps2xTest/src/ps2_memory_tests.cpp             | 30 +++++++++++++++++++
 3 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp
index b32e44a..9168b65 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp
@@ -167,7 +167,7 @@ namespace ps2_stubs
 
     void sceDmaRecvN(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
-        TODO_NAMED("sceDmaRecvN", rdram, ctx, runtime);
+        setReturnS32(ctx, submitDmaSend(rdram, ctx, runtime, true, true));
     }
 
     void sceDmaReset(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
index b1bb6d8..ceb057d 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
@@ -1335,7 +1335,8 @@ namespace
         return 0;
     }
 
-    int32_t submitDmaSend(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime, bool preferNormalCount)
+    // `toMemory` submits a normal-mode transfer from the channel's peripheral into memory (sceDmaRecvN).
+    int32_t submitDmaSend(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime, bool preferNormalCount, bool toMemory = false)
     {
         if (!runtime)
         {
@@ -1365,6 +1366,8 @@ namespace
         {
             qwc = normalizeQwcFromArg(countArg);
             madr = payloadPhys;
+            if (toMemory)
+                chcr &= ~0x1u; // DIR=0
         }
         else
         {
diff --git a/ps2xTest/src/ps2_memory_tests.cpp b/ps2xTest/src/ps2_memory_tests.cpp
index cf86ad7..e38b939 100644
--- a/ps2xTest/src/ps2_memory_tests.cpp
+++ b/ps2xTest/src/ps2_memory_tests.cpp
@@ -2322,6 +2322,36 @@ void register_ps2_memory_tests()
             t.Equals(mem.readIORegister(kDstadr), 0u, "sceDmaReset should clear D_STADR");
         });
 
+        tc.Run("sceDmaRecvN copies the scratchpad into memory over the fromSPR channel", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            t.IsTrue(runtime.memory().initialize(), "PS2Memory initialize should succeed");
+
+            // Soulcalibur III swaps the scratchpad when its main menu starts:
+            // sceDmaGetChan(8), chan->sadr = 0, sceDmaRecvN(chan, buffer, 0x400).
+            constexpr uint32_t kFromSpr = 0x1000D000u;
+            constexpr uint32_t kBuffer = 0x0062BE00u;
+            constexpr uint32_t kQwc = 0x400u;
+
+            PS2Memory &mem = runtime.memory();
+            uint8_t *rdram = mem.getRDRAM();
+            for (uint32_t i = 0; i < kQwc * 16u; ++i)
+                mem.getScratchpad()[i] = static_cast<uint8_t>(i * 7u + 1u);
+            t.IsTrue(mem.writeIORegister(kFromSpr + 0x80u, 0u), "writing D8_SADR should succeed");
+
+            R5900Context ctx{};
+            setRegU32(ctx, 4, kFromSpr);
+            setRegU32(ctx, 5, kBuffer);
+            setRegU32(ctx, 6, kQwc);
+            ps2_stubs::sceDmaRecvN(rdram, &ctx, &runtime);
+
+            t.Equals(static_cast<int32_t>(::getRegU32(&ctx, 2)), 0, "sceDmaRecvN should return 0");
+            t.IsTrue(std::memcmp(rdram + kBuffer, mem.getScratchpad(), kQwc * 16u) == 0,
+                     "the whole scratchpad should arrive at the buffer");
+            t.Equals(mem.readIORegister(kFromSpr + 0x00u) & 0x100u, 0u, "the transfer should have ended");
+            t.Equals(mem.readIORegister(kFromSpr + 0x00u) & 0x1u, 0u, "fromSPR is a transfer to memory (DIR = 0)");
+        });
+
         tc.Run("sceDmaSend preserves guest-configured VIF1 TTE", [](TestCase &t)
         {
             PS2Runtime runtime;
-- 
