From f8f2cf8a6f22fcd923c93496633d35ff84eeb93c Mon Sep 17 00:00:00 2001
From: x <a@b>
Date: Tue, 27 Oct 2026 02:04:45 +0200
Subject: [PATCH] Tests: a fade and a split blit do not make the frame lose its
 parts

The paraLLEl-GS fix parallel-gs/gs/0002 stops the backbuffer promotion
from replacing the display buffer by the blit's source when the blit is
not a plain copy of a whole frame. Soulcalibur III fades the Demonstration
screen in with the blit's vertex colour while it builds the scene in the
buffer the blit copies, and its blit is sometimes split by a flush into
two render passes, the second of which lacks the first tile.

The tests draw a blit with a darkening vertex colour, and a blit split
after its first tile and after its top rows: the picture must come from
the display buffer, which has the fade and every part of the frame.
---
 ps2xTest/src/ps2_gs_parallel_tests.cpp | 80 ++++++++++++++++++++++++--
 1 file changed, 74 insertions(+), 6 deletions(-)

diff --git a/ps2xTest/src/ps2_gs_parallel_tests.cpp b/ps2xTest/src/ps2_gs_parallel_tests.cpp
index 3f3ca1e..83c521c 100644
--- a/ps2xTest/src/ps2_gs_parallel_tests.cpp
+++ b/ps2xTest/src/ps2_gs_parallel_tests.cpp
@@ -82,6 +82,8 @@ namespace
         uint32_t height = 0u;
         uint32_t partlyCoveredPixels = 0u; // neither the triangle's green nor the black around it
         uint8_t centreGreen = 0u;
+        uint8_t cornerGreen = 0u;   // near the top-left corner, which the triangle covers
+        uint8_t topRightGreen = 0u; // in the top rows, near where the triangle's tip is; black further down
     };
 
     // The way Soulcalibur III builds a frame: it renders into a 640x448 PSMCT32 buffer at page 0, then
@@ -96,7 +98,25 @@ namespace
         OwnPass,
     };
 
-    Presented presentBlittedFrame(TestCase &t, uint32_t superSampling, EdgeLines edgeLines = EdgeLines::None)
+    // How the blit's sprites are split over render passes, as the game's blits are when the GS flushes
+    // in the middle of one.
+    enum class BlitSplit
+    {
+        None,
+        FirstTile,  // the first tile in a pass of its own, the rest in another
+        TopStrip,   // the top rows in a pass of their own, the rest in another
+    };
+
+    // How the blit itself is drawn. The default is a plain copy (DECAL) in one sprite.
+    struct BlitStyle
+    {
+        // Non-zero modulates the texture by this vertex colour (0x80 is the identity), as a fade does.
+        uint32_t modulateColour = 0u;
+        BlitSplit split = BlitSplit::None;
+    };
+
+    Presented presentBlittedFrame(TestCase &t, uint32_t superSampling, EdgeLines edgeLines = EdgeLines::None,
+                                  const BlitStyle &style = {})
     {
         GsFixture f;
         if (!requireGpuGs(t, f.gs, GSParallelOptions{superSampling}))
@@ -120,16 +140,42 @@ namespace
                              {kRegXyz2, (440ull << 4) << 16}}));
         f.gs.onVsync(1u); // the game blits a finished frame at the start of the next one
         // TEX0: page 0, 640 wide, PSMCT24, 1024x512, TCC, DECAL. PRIM: sprite, TME, FST.
-        const uint64_t tex0 = (10ull << 14) | (1ull << 20) | (10ull << 26) | (9ull << 30) | (1ull << 34) | (1ull << 35);
+        uint64_t tex0 = (10ull << 14) | (1ull << 20) | (10ull << 26) | (9ull << 30) | (1ull << 34) | (1ull << 35);
+        if (style.modulateColour != 0u)
+            tex0 &= ~((1ull << 34) | (1ull << 35)); // MODULATE, no alpha from the texture
         send(f.gs, adPacket({{kRegPrmodecont, 1u}, // the attributes come from PRIM
                              {kRegFrame1, 0x8Cull | (8ull << 16) | (2ull << 24)},
                              {kRegScissor1, (511ull << 16) | (511ull << 48)},
                              {kRegTex01, tex0},
                              {kRegPrim, 0x116u},
-                             {kRegUv, 0u},
-                             {kRegXyz2, 0u},
-                             {kRegUv, (640ull << 4) | ((448ull << 4) << 16)},
-                             {kRegXyz2, (512ull << 4) | ((512ull << 4) << 16)}}));
+                             {kRegRgbaq, style.modulateColour * 0x010101ull | (0x80ull << 24)}}));
+        // A sprite of the blit from texels (u0,v0)-(u1,v1) to pixels (x0,y0)-(x1,y1); the 640x448 frame
+        // is drawn into the 512x512 buffer.
+        const auto sprite = [&](uint64_t u0, uint64_t v0, uint64_t u1, uint64_t v1, uint64_t x0, uint64_t y0,
+                                uint64_t x1, uint64_t y1)
+        {
+            send(f.gs, adPacket({{kRegUv, (u0 << 4) | (v0 << 20)},
+                                 {kRegXyz2, (x0 << 4) | (y0 << 20)},
+                                 {kRegUv, (u1 << 4) | (v1 << 20)},
+                                 {kRegXyz2, (x1 << 4) | (y1 << 20)}}));
+        };
+        switch (style.split)
+        {
+        case BlitSplit::None:
+            sprite(0, 0, 640, 448, 0, 0, 512, 512);
+            break;
+        case BlitSplit::FirstTile:
+            sprite(0, 0, 80, 56, 0, 0, 64, 64);
+            f.gs.onVsync(0u);
+            sprite(80, 0, 640, 448, 64, 0, 512, 512);
+            sprite(0, 56, 80, 448, 0, 64, 64, 512);
+            break;
+        case BlitSplit::TopStrip:
+            sprite(0, 0, 640, 56, 0, 0, 512, 64);
+            f.gs.onVsync(0u);
+            sprite(0, 56, 640, 448, 0, 64, 512, 512);
+            break;
+        }
         if (edgeLines == EdgeLines::OwnPass)
             f.gs.onVsync(0u);
         if (edgeLines != EdgeLines::None)
@@ -154,6 +200,8 @@ namespace
             if (frame[i + 1u] > 0x18u && frame[i + 1u] < 0xA8u)
                 ++presented.partlyCoveredPixels;
         presented.centreGreen = frame[(static_cast<size_t>(presented.height / 4u) * presented.width + presented.width / 4u) * 4u + 1u];
+        presented.cornerGreen = frame[(8u * static_cast<size_t>(presented.width) + 8u) * 4u + 1u];
+        presented.topRightGreen = frame[(23u * static_cast<size_t>(presented.width) + 400u) * 4u + 1u];
         return presented;
     }
 
@@ -302,6 +350,26 @@ void register_ps2_gs_parallel_tests()
                      "with no blit in the pass the 16-bit display buffer is scanned out");
         });
 
+        tc.Run("a blit that fades the frame presents the display buffer, which shows the fade (GPU GS)", [](TestCase &t)
+        {
+            const Presented plain = presentBlittedFrame(t, 1u, EdgeLines::None, BlitStyle{0x80u});
+            t.Equals(static_cast<uint32_t>(plain.centreGreen), kTriangleGreen,
+                     "a modulation by the identity colour is a plain copy: the 32-bit source is scanned out");
+            const Presented faded = presentBlittedFrame(t, 1u, EdgeLines::None, BlitStyle{0x40u});
+            t.IsTrue(faded.centreGreen < kTriangleGreen - 0x30u,
+                     "a darkening modulation is part of the picture, which the blit's source lacks: the display buffer is scanned out");
+        });
+
+        tc.Run("a blit split over two render passes presents the whole frame (GPU GS)", [](TestCase &t)
+        {
+            const Presented firstTile = presentBlittedFrame(t, 1u, EdgeLines::None, BlitStyle{0u, BlitSplit::FirstTile});
+            t.IsTrue(firstTile.cornerGreen > 0x80u,
+                     "the first tile, drawn in a pass of its own, is in the picture (the second pass's copy of the source lacks it)");
+            const Presented topStrip = presentBlittedFrame(t, 1u, EdgeLines::None, BlitStyle{0u, BlitSplit::TopStrip});
+            t.IsTrue(topStrip.topRightGreen > 0x80u,
+                     "the top rows, drawn in a pass of their own, are in the picture (the second pass's copy of the source lacks them)");
+        });
+
         tc.Run("the GIF arbiter reports the path each packet came on", [](TestCase &t)
         {
             std::vector<GifPathId> paths;
-- 
