+    // reads guest memory. False when the data is not one contiguous range.
+    bool snapshotTransfer(PendingTransfer &transfer);
+    // The end of a kick: DMA status, CHCR and the completion interrupt of the channels that ran.
+    void completeTransfers(bool gif, bool vif0, bool vif1);
