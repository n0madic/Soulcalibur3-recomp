+        {
+            GsPipeline pipeline(1024u);
+            std::vector<int> order;
+            std::vector<std::thread::id> threads;
+            std::atomic<bool> firstDone{false};
+            pipeline.submit([&]
+            {
+                std::this_thread::sleep_for(50ms);
+                order.push_back(1);
+                threads.push_back(std::this_thread::get_id());
+                firstDone.store(true);
+            }, 1u);
+            pipeline.submit([&] { order.push_back(2); }, 1u);
+            pipeline.submit([&] { order.push_back(3); }, 1u);
+
+            t.IsFalse(firstDone.load(), "submit returns before the first job has run");
+            t.IsFalse(pipeline.idle(), "the pipeline is busy");
+            pipeline.drain();
+            t.IsTrue(pipeline.idle(), "drain leaves the pipeline idle");
+            t.Equals(order.size(), static_cast<size_t>(3u), "all jobs ran");
+            t.IsTrue(order[0] == 1 && order[1] == 2 && order[2] == 3, "jobs run in submission order");
+            t.IsTrue(threads.size() == 1u && threads[0] != std::this_thread::get_id(), "jobs run on the worker thread");
+        });
+
+        tc.Run("drain on the worker thread returns at once", [](TestCase &t)
+        {
+            GsPipeline pipeline(1024u);
+            std::atomic<bool> returned{false};
+            pipeline.submit([&]
+            {
+                pipeline.drain();
+                returned.store(true);
+            }, 1u);
+            pipeline.drain();
+            t.IsTrue(returned.load(), "a job that drains does not wait for itself");
+        });
+
+        tc.Run("submit blocks while the queue holds more than its limit", [](TestCase &t)
+        {
+            GsPipeline pipeline(100u);
+            std::atomic<bool> release{false};
+            std::atomic<bool> secondSubmitted{false};
+            std::atomic<int> ran{0};
+            pipeline.submit([&]
+            {
+                while (!release.load())
+                    std::this_thread::sleep_for(1ms);
+                ran.fetch_add(1);
+            }, 100u);
+
+            std::thread submitter([&]
+            {
+                pipeline.submit([&] { ran.fetch_add(1); }, 100u);
+                secondSubmitted.store(true);
+            });
+            std::this_thread::sleep_for(50ms);
+            t.IsFalse(secondSubmitted.load(), "the second job waits for room");
+            release.store(true);
+            submitter.join();
+            pipeline.drain();
+            t.IsTrue(secondSubmitted.load(), "the second job is queued once the first has run");
+            t.Equals(ran.load(), 2, "both jobs ran");
+        });
+
+        tc.Run("destroying the pipeline runs the jobs still queued", [](TestCase &t)
+        {
+            std::atomic<int> ran{0};
+            {
+                GsPipeline pipeline(1024u);
+                for (int i = 0; i < 5; ++i)
+                {
+                    pipeline.submit([&]
+                    {
+                        std::this_thread::sleep_for(5ms);
+                        ran.fetch_add(1);
+                    }, 1u);
+                }
+            }
+            t.Equals(ran.load(), 5, "all queued jobs ran before the destructor returned");
+        });
+    });
+
+    MiniTest::Case("PS2Memory graphics pipeline", [](TestCase &tc)
+    {
+        tc.Run("a GIF DMA kick returns before the worker has run the packet and a GS register read waits for it", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            GifLog log;
+            log.firstPacketDelay = 60ms;
+            GifArbiter arbiter([&](GifPathId, const uint8_t *data, uint32_t sizeBytes) { log.add(data, sizeBytes); });
+            mem.setGifArbiter(&arbiter);
+            mem.startGraphicsPipeline();
+
+            uint8_t *rdram = mem.getRDRAM();
+            for (uint32_t i = 0; i < 16u; ++i)
+                rdram[0x22000u + i] = static_cast<uint8_t>(0x40u + i);
+            kickDma(mem, kGifChannel, 0x22000u, 1u);
+
+            t.IsFalse(log.firstPacketDone.load(), "the kick returned before the packet reached the GS");
+            (void)mem.read64(kGsCsr);
+            t.IsTrue(log.firstPacketDone.load(), "reading a GS register waited for the worker");
+            mem.syncGraphicsPipeline(); // keeps what follows sound should the check above fail
+            t.Equals(log.packets.size(), static_cast<size_t>(1u), "the packet arrived once");
+            t.IsTrue(log.threads[0] != std::this_thread::get_id(), "the packet was processed on the worker thread");
+            t.IsTrue(std::memcmp(log.packets[0].data(), rdram + 0x22000u, 16u) == 0, "the packet has the DMA's bytes");
+            t.IsTrue((mem.readIORegister(kGifChannel + 0x00u) & 0x100u) == 0u, "the kick completed the channel at once");
+        });
+
+        tc.Run("the guest can reuse the memory of a DMA as soon as it has been kicked", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            GifLog log;
+            log.firstPacketDelay = 60ms; // keeps the worker busy while the guest rewrites its buffer
+            GifArbiter arbiter([&](GifPathId, const uint8_t *data, uint32_t sizeBytes) { log.add(data, sizeBytes); });
+            mem.setGifArbiter(&arbiter);
+            mem.startGraphicsPipeline();
+
+            uint8_t *rdram = mem.getRDRAM();
+            std::vector<uint8_t> second(32u);
+            for (uint32_t i = 0; i < 16u; ++i)
+                rdram[0x22000u + i] = static_cast<uint8_t>(0x10u + i);
+            for (uint32_t i = 0; i < 32u; ++i)
+            {
+                second[i] = static_cast<uint8_t>(0x60u + i);
+                rdram[0x23000u + i] = second[i];
+            }
+            kickDma(mem, kGifChannel, 0x22000u, 1u);
+            kickDma(mem, kGifChannel, 0x23000u, 2u);
+            std::memset(rdram + 0x23000u, 0xFF, 32u);
+
+            mem.syncGraphicsPipeline();
+            t.Equals(log.packets.size(), static_cast<size_t>(2u), "both packets arrived");
+            t.IsTrue(log.packets.size() == 2u && log.packets[1] == second, "the second packet has the bytes of the kick, not the rewritten ones");
+        });
+
+        tc.Run("kicks reach the GS in the order they were made", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            GifLog log;
+            GifArbiter arbiter([&](GifPathId, const uint8_t *data, uint32_t sizeBytes) { log.add(data, sizeBytes); });
+            mem.setGifArbiter(&arbiter);
+            mem.startGraphicsPipeline();
+
+            uint8_t *rdram = mem.getRDRAM();
+            constexpr uint32_t kKicks = 40u;
+            for (uint32_t k = 0; k < kKicks; ++k)
+            {
+                std::memset(rdram + 0x30000u + k * 16u, static_cast<int>(k + 1u), 16u);
+                kickDma(mem, kGifChannel, 0x30000u + k * 16u, 1u);
+            }
+            mem.syncGraphicsPipeline();
+
+            t.Equals(log.packets.size(), static_cast<size_t>(kKicks), "every kick reached the GS");
+            bool inOrder = log.packets.size() == kKicks;
+            for (uint32_t k = 0; inOrder && k < kKicks; ++k)
+                inOrder = log.packets[k][0] == static_cast<uint8_t>(k + 1u);
+            t.IsTrue(inOrder, "the packets arrived in kick order");
+        });
+
+        tc.Run("a VIF1 UNPACK DMA is in VU1 memory by the time the guest reads it", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            GifLog log;
+            log.firstPacketDelay = 60ms; // the UNPACKs below queue up behind this packet
+            GifArbiter arbiter([&](GifPathId, const uint8_t *data, uint32_t sizeBytes) { log.add(data, sizeBytes); });
+            mem.setGifArbiter(&arbiter);
+            mem.startGraphicsPipeline();
+
+            uint8_t *rdram = mem.getRDRAM();
+            std::memset(rdram + 0x22000u, 0x11, 16u);
+            kickDma(mem, kGifChannel, 0x22000u, 1u);
+            // Three NOPs pad the UNPACK V4-32 (NUM 1, VU address 0x10) and its quadword to two quadwords.
+            const uint32_t words[8] = {0u, 0u, 0u, makeVifCmd(0x6Cu, 1u, 0x10u), 0x11111111u, 0x22222222u, 0x33333333u, 0x44444444u};
+            std::memcpy(rdram + 0x24000u, words, sizeof(words));
+            kickDma(mem, kVif1Channel, 0x24000u, 2u);
+
+            // The second kick overwrites the quadword; the guest must see the last one.
+            const uint32_t again[8] = {0u, 0u, 0u, makeVifCmd(0x6Cu, 1u, 0x10u), 0xAAAAAAAAu, 0xBBBBBBBBu, 0xCCCCCCCCu, 0xDDDDDDDDu};
+            std::memcpy(rdram + 0x25000u, again, sizeof(again));
+            kickDma(mem, kVif1Channel, 0x25000u, 2u);
+
+            const uint32_t vu1Qword = PS2_VU1_DATA_BASE + 0x10u * 16u;
+            t.Equals(mem.read32(vu1Qword + 0u), 0xAAAAAAAAu, "VU1 memory word 0 holds the last UNPACK");
+            t.Equals(mem.read32(vu1Qword + 12u), 0xDDDDDDDDu, "VU1 memory word 3 holds the last UNPACK");
+        });
+
+        tc.Run("the gate makes a kick run on the calling thread", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            GifLog log;
+            GifArbiter arbiter([&](GifPathId, const uint8_t *data, uint32_t sizeBytes) { log.add(data, sizeBytes); });
+            mem.setGifArbiter(&arbiter);
+            mem.startGraphicsPipeline();
+            bool open = false;
+            mem.setGraphicsPipelineGate([&] { return open; });
+
+            std::memset(mem.getRDRAM() + 0x22000u, 0x5A, 16u);
+            kickDma(mem, kGifChannel, 0x22000u, 1u);
+            t.Equals(log.packets.size(), static_cast<size_t>(1u), "a closed gate delivers the packet before the kick returns");
+            t.IsTrue(log.threads[0] == std::this_thread::get_id(), "a closed gate runs the kick on the calling thread");
+
+            open = true;
+            kickDma(mem, kGifChannel, 0x22000u, 1u);
+            mem.syncGraphicsPipeline();
+            t.Equals(log.packets.size(), static_cast<size_t>(2u), "an open gate delivers the next packet too");
+            t.IsTrue(log.threads[1] != std::this_thread::get_id(), "an open gate runs the kick on the worker");
+        });
+
+        tc.Run("a GS event the guest acknowledges before the interrupt is polled still raises it", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            mem.gs().imr = 0x7C00u; // SIGNAL and FINISH unmasked
+            t.IsFalse(mem.pollGsInterruptEdge(), "nothing was raised yet");
+
+            // The worker raises FINISH; the guest's own poll reads CSR, sees it and writes it back
+            // before the scheduler looks.
+            gsWriteFinish(mem.gs());
+            mem.write32(kGsCsr, 0x2u);
+            t.Equals(mem.gs().csr.load() & 0x2u, 0ull, "the guest cleared FINISH");
+            t.IsTrue(mem.pollGsInterruptEdge(), "the interrupt of the cleared FINISH is still raised");
+            t.IsFalse(mem.pollGsInterruptEdge(), "and raised once");
+
+            mem.gs().imr = 0x7F00u; // everything masked: an event raised now raises no interrupt
+            gsWriteFinish(mem.gs());
+            mem.write32(kGsCsr, 0x2u);
+            mem.gs().imr = 0x7C00u;
+            t.IsFalse(mem.pollGsInterruptEdge(), "a masked event raises nothing once it is unmasked and cleared");
+        });
+
+        tc.Run("a synchronous processPendingTransfers leaves nothing with the worker", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            GifLog log;
+            log.firstPacketDelay = 40ms;
+            GifArbiter arbiter([&](GifPathId, const uint8_t *data, uint32_t sizeBytes) { log.add(data, sizeBytes); });
+            mem.setGifArbiter(&arbiter);
+            mem.startGraphicsPipeline();
+
+            std::memset(mem.getRDRAM() + 0x22000u, 0x33, 16u);
+            kickDma(mem, kGifChannel, 0x22000u, 1u);
+            mem.processPendingTransfers();
+            t.IsTrue(log.firstPacketDone.load(), "the HLE entry point waits for the worker");
+        });
+    });
+}
