diff --git a/ps2xRuntime/src/lib/ps2_gs_pipeline.cpp b/ps2xRuntime/src/lib/ps2_gs_pipeline.cpp
new file mode 100644
index 0000000..d51f12c
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_gs_pipeline.cpp
@@ -0,0 +1,78 @@
+#include "runtime/ps2_gs_pipeline.h"
+
+#include <exception>
+#include <iostream>
+#include <utility>
+
+GsPipeline::GsPipeline(size_t maxQueuedBytes)
+    : m_maxQueuedBytes(maxQueuedBytes), m_thread([this] { run(); })
+{
+}
+
+GsPipeline::~GsPipeline()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_stop = true;
+    }
+    m_workCv.notify_all();
+    m_thread.join();
+}
+
+void GsPipeline::submit(Job job, size_t bytes)
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    // m_queuedBytes counts the job that is running too; an idle pipeline takes any job.
+    m_spaceCv.wait(lock, [&] { return m_queuedBytes == 0u || m_queuedBytes + bytes <= m_maxQueuedBytes; });
+    m_queue.push_back(Queued{std::move(job), bytes});
+    m_queuedBytes += bytes;
+    m_outstanding.fetch_add(1u, std::memory_order_release);
+    lock.unlock();
+    m_workCv.notify_one();
+}
+
+void GsPipeline::drain()
+{
+    if (m_outstanding.load(std::memory_order_acquire) == 0u || onWorkerThread())
+        return;
+    std::unique_lock<std::mutex> lock(m_mutex);
+    m_idleCv.wait(lock, [&] { return m_outstanding.load(std::memory_order_acquire) == 0u; });
+}
+
+void GsPipeline::run()
+{
+    for (;;)
+    {
+        Queued next;
+        {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_workCv.wait(lock, [&] { return m_stop || !m_queue.empty(); });
+            if (m_queue.empty())
+                return;
+            next = std::move(m_queue.front());
+            m_queue.pop_front();
+        }
+
+        try
+        {
+            next.job();
+        }
+        catch (const std::exception &error)
+        {
+            std::cerr << "[GsPipeline] job failed: " << error.what() << std::endl;
+        }
+        catch (...)
+        {
+            std::cerr << "[GsPipeline] job failed" << std::endl;
+        }
+        next.job = nullptr; // release what the job owns before anyone waits for it
+
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_queuedBytes -= next.bytes;
+            m_outstanding.fetch_sub(1u, std::memory_order_release);
+        }
+        m_spaceCv.notify_all();
+        m_idleCv.notify_all();
+    }
+}
