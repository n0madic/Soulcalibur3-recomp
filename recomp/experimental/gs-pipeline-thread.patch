+    constexpr uint32_t kVif1Channel = 0x10009000u;
+    constexpr uint32_t kGsCsr = 0x12001000u;
+
+    uint32_t makeVifCmd(uint8_t opcode, uint8_t num, uint16_t imm)
+    {
+        return (static_cast<uint32_t>(opcode) << 24) | (static_cast<uint32_t>(num) << 16) | static_cast<uint32_t>(imm);
+    }
+
+    // Kicks a mode 0 DMA of qwc quadwords at src on the channel.
+    void kickDma(PS2Memory &mem, uint32_t channel, uint32_t src, uint32_t qwc)
+    {
+        mem.writeIORegister(channel + 0x10u, src);
+        mem.writeIORegister(channel + 0x20u, qwc);
+        mem.writeIORegister(channel + 0x00u, 0x101u);
+    }
+
+    // What the GIF's packet callback saw, in order, and on which thread.
+    struct GifLog
+    {
+        std::mutex mutex;
+        std::vector<std::vector<uint8_t>> packets;
+        std::vector<std::thread::id> threads;
+        std::chrono::milliseconds firstPacketDelay{0};
+        std::atomic<bool> firstPacketDone{false};
+
+        void add(const uint8_t *data, uint32_t sizeBytes)
+        {
+            const bool first = [&]
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                return packets.empty();
+            }();
+            if (first)
+                std::this_thread::sleep_for(firstPacketDelay);
+            std::lock_guard<std::mutex> lock(mutex);
+            packets.emplace_back(data, data + sizeBytes);
+            threads.push_back(std::this_thread::get_id());
+            if (first)
+                firstPacketDone.store(true);
+        }
+    };
+}
