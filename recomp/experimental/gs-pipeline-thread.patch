diff --git a/ps2xRuntime/include/runtime/ps2_gs_pipeline.h b/ps2xRuntime/include/runtime/ps2_gs_pipeline.h
new file mode 100644
index 0000000..630c01a
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_gs_pipeline.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstddef>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+// A worker thread for the work the EE hands to VIF1, VU1 and the GIF. On the console they run beside
+// the EE; here a DMA kick used to run them on the calling EE thread before it could go on. Jobs run in
+// the order they were submitted. The EE thread calls drain() before it touches anything a job touches
+// (the VIF1, GIF and GS registers, VU memory, the GS itself), so what it sees is what it would have
+// seen had the job run at once.
+class GsPipeline
+{
+public:
+    using Job = std::function<void()>;
+
+    // The worker holds at most maxQueuedBytes of data, queued and running (the hardware's FIFOs are
+    // finite): submit() blocks while a new job would exceed that, except when nothing is outstanding.
+    explicit GsPipeline(size_t maxQueuedBytes);
+    // Runs the jobs still queued, then stops the worker.
+    ~GsPipeline();
+
+    GsPipeline(const GsPipeline &) = delete;
+    GsPipeline &operator=(const GsPipeline &) = delete;
+
+    // Queues a job; bytes is the size of the data it owns.
+    void submit(Job job, size_t bytes);
+
+    // Returns once every job submitted before the call has run. Does nothing on the worker thread, whose
+    // jobs may call code that drains.
+    void drain();
+
+    // True when no job is queued or running.
+    [[nodiscard]] bool idle() const noexcept { return m_outstanding.load(std::memory_order_acquire) == 0u; }
+    [[nodiscard]] bool onWorkerThread() const noexcept { return std::this_thread::get_id() == m_thread.get_id(); }
+
+private:
+    struct Queued
+    {
+        Job job;
+        size_t bytes = 0;
+    };
+
+    void run();
+
+    const size_t m_maxQueuedBytes;
+    std::mutex m_mutex;
+    std::condition_variable m_workCv;
+    std::condition_variable m_spaceCv;
+    std::condition_variable m_idleCv;
+    std::deque<Queued> m_queue;
+    size_t m_queuedBytes = 0;
+    bool m_stop = false;
+    std::atomic<size_t> m_outstanding{0}; // jobs queued or running
+    std::thread m_thread;                 // last: starts once the rest exists
+};
