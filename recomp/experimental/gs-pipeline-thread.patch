+    runGifTransfers(m_pendingGifTransfers);
+    m_pendingGifTransfers.clear();
+
+    const bool hadVif0 = !m_pendingVif0Transfers.empty();
+    runVifTransfers(m_pendingVif0Transfers, false);
+    m_pendingVif0Transfers.clear();
+
+    const bool hadVif1 = !m_pendingVif1Transfers.empty();
+    runVifTransfers(m_pendingVif1Transfers, true);
     m_pendingVif1Transfers.clear();
 
     if (m_gifArbiter)
         m_gifArbiter->drain();
 
+    completeTransfers(hadGif, hadVif0, hadVif1);
+}
+
+void PS2Memory::dispatchPendingTransfers()
+{
+    if (!m_pipeline || (m_pipelineGate && !m_pipelineGate()))
+    {
+        processPendingTransfers();
+        return;
+    }
+
+    // Transfers that name guest memory are copied now: the guest may reuse the memory as soon as the
+    // DMA is complete, and the worker runs later.
+    bool copied = true;
+    for (auto &transfer : m_pendingGifTransfers)
+        copied = snapshotTransfer(transfer) && copied;
+    for (auto &transfer : m_pendingVif1Transfers)
+        copied = snapshotTransfer(transfer) && copied;
+    if (!copied)
+    {
+        processPendingTransfers();
+        return;
+    }
+
+    const bool hadGif = !m_pendingGifTransfers.empty();
+    const bool hadVif0 = !m_pendingVif0Transfers.empty();
+    const bool hadVif1 = !m_pendingVif1Transfers.empty();
+    observeGifQueue();
+
+    if (hadGif || hadVif1)
+    {
+        size_t bytes = 0;
+        for (const auto &transfer : m_pendingGifTransfers)
+            bytes += transfer.chainData.size();
+        for (const auto &transfer : m_pendingVif1Transfers)
+            bytes += transfer.chainData.size();
+        m_pipeline->submit(
+            [this, gif = std::move(m_pendingGifTransfers), vif1 = std::move(m_pendingVif1Transfers)]() mutable
+            {
+                runGifTransfers(gif);
+                runVifTransfers(vif1, true);
+                if (m_gifArbiter)
+                    m_gifArbiter->drain();
+                if (m_pipelineNotify)
+                    m_pipelineNotify();
+            },
+            bytes);
+        m_pendingGifTransfers.clear();
+        m_pendingVif1Transfers.clear();
+    }
+
+    // VIF0 feeds VU0, which the EE thread shares, so it stays here.
+    runVifTransfers(m_pendingVif0Transfers, false);
+    m_pendingVif0Transfers.clear();
+
+    completeTransfers(hadGif, hadVif0, hadVif1);
+}
+
+void PS2Memory::startGraphicsPipeline()
+{
+    if (m_pipeline)
+        return;
+    // Enough for a few display lists; a kick blocks when the worker is further behind than that.
+    constexpr size_t kMaxQueuedBytes = 16u * 1024u * 1024u;
+    m_pipeline = std::make_unique<GsPipeline>(kMaxQueuedBytes);
+}
+
+void PS2Memory::stopGraphicsPipeline()
+{
+    m_pipeline.reset();
+}
+
+void PS2Memory::observeGifQueue()
+{
+    uint32_t observedGifQwc = 0u;
+    for (const auto &transfer : m_pendingGifTransfers)
+    {
+        const uint64_t transferQwc = !transfer.chainData.empty()
+                                         ? (transfer.chainData.size() / 16u)
+                                         : transfer.qwc;
+        observedGifQwc = static_cast<uint32_t>(std::min<uint64_t>(16u, static_cast<uint64_t>(observedGifQwc) + transferQwc));
+    }
+    if (observedGifQwc != 0u)
+    {
+        constexpr uint32_t kGifStat = 0x10003020u;
+        constexpr uint32_t kGifFqcMask = 0x1F000000u;
+        uint32_t &gifStat = m_ioRegisters[kGifStat];
+        gifStat = (gifStat & ~kGifFqcMask) | (observedGifQwc << 24u);
+    }
