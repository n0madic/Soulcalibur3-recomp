diff --git a/tests/poll_watchdog_test.cpp b/tests/poll_watchdog_test.cpp
new file mode 100644
index 0000000..d00b107
--- /dev/null
+++ b/tests/poll_watchdog_test.cpp
@@ -0,0 +1,26 @@
+#include "host/poll_watchdog.hpp"
+#include <cassert>
+#include <chrono>
+#include <thread>
+#include <cstdio>
+int main(int argc, char **argv) {
+    windowdiag::StallGate g;
+    assert(!g.capture(200000000, 0));
+    assert(!g.capture(200000000, 100000000));
+    assert(g.capture(230000000, 100000000));
+    assert(!g.capture(300000000, 100000000));
+    assert(!g.capture(800000000, 600000000));
+    for (int i=1; i<4; ++i) assert(g.capture(230000000 + i*11000000000ll, 100000000 + i*11000000000ll));
+    assert(!g.capture(50000000000ll, 49000000000ll));
+    std::puts("Stall threshold, once per poll, cooldown and capture limit passed");
+#ifdef __APPLE__
+    if (argc > 1) {
+        windowdiag::PollWatchdog watch;
+        watch.start(argv[1]);
+        watch.polling_since.store(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+        std::this_thread::sleep_for(std::chrono::milliseconds(700));
+        watch.polling_since.store(0);
+        std::this_thread::sleep_for(std::chrono::milliseconds(1400));
+    }
+#endif
+}
