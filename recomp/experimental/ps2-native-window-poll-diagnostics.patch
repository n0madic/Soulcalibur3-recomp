+        if (got && (e.type == SDL_KEYDOWN || e.type == SDL_KEYUP))
+            std::fprintf(stderr, "; key scancode %d repeat %u", e.key.keysym.scancode, e.key.repeat);
+        std::fputc('\n', stderr);
