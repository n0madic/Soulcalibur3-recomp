     }
 
-    // The keyboard always works, also with a gamepad connected.
-    if (input.isKeyDown(KEY_UP) || input.isKeyDown(KEY_W))
-        clearBit(PAD_UP);
-    if (input.isKeyDown(KEY_DOWN) || input.isKeyDown(KEY_S))
-        clearBit(PAD_DOWN);
-    if (input.isKeyDown(KEY_LEFT) || input.isKeyDown(KEY_A))
-        clearBit(PAD_LEFT);
-    if (input.isKeyDown(KEY_RIGHT) || input.isKeyDown(KEY_D))
-        clearBit(PAD_RIGHT);
-    if (input.isKeyDown(KEY_X) || input.isKeyDown(KEY_SPACE))
-        clearBit(PAD_CROSS);
-    if (input.isKeyDown(KEY_C) || input.isKeyDown(KEY_ESCAPE))
-        clearBit(PAD_CIRCLE);
-    if (input.isKeyDown(KEY_Z) || input.isKeyDown(KEY_KP_0))
-        clearBit(PAD_SQUARE);
-    if (input.isKeyDown(KEY_V) || input.isKeyDown(KEY_KP_1))
-        clearBit(PAD_TRIANGLE);
-    if (input.isKeyDown(KEY_Q))
-        clearBit(PAD_L1);
-    if (input.isKeyDown(KEY_E))
-        clearBit(PAD_R1);
-    if (input.isKeyDown(KEY_LEFT_SHIFT))
-        clearBit(PAD_L2);
-    if (input.isKeyDown(KEY_RIGHT_SHIFT))
-        clearBit(PAD_R2);
-    if (input.isKeyDown(KEY_ENTER))
-        clearBit(PAD_START);
-    if (input.isKeyDown(KEY_TAB))
-        clearBit(PAD_SELECT);
+    // Each PS2 port owns one host controller and a disjoint keyboard layout.
+    // Keep the existing P1 aliases, including keypad 0/1.
+    if (port == 0)
+    {
+        if (input.isKeyDown(KEY_UP) || input.isKeyDown(KEY_W)) clearBit(PAD_UP);
+        if (input.isKeyDown(KEY_DOWN) || input.isKeyDown(KEY_S)) clearBit(PAD_DOWN);
+        if (input.isKeyDown(KEY_LEFT) || input.isKeyDown(KEY_A)) clearBit(PAD_LEFT);
+        if (input.isKeyDown(KEY_RIGHT) || input.isKeyDown(KEY_D)) clearBit(PAD_RIGHT);
+        if (input.isKeyDown(KEY_X) || input.isKeyDown(KEY_SPACE)) clearBit(PAD_CROSS);
+        if (input.isKeyDown(KEY_C) || input.isKeyDown(KEY_ESCAPE)) clearBit(PAD_CIRCLE);
+        if (input.isKeyDown(KEY_Z) || input.isKeyDown(KEY_KP_0)) clearBit(PAD_SQUARE);
+        if (input.isKeyDown(KEY_V) || input.isKeyDown(KEY_KP_1)) clearBit(PAD_TRIANGLE);
+        if (input.isKeyDown(KEY_Q)) clearBit(PAD_L1);
+        if (input.isKeyDown(KEY_E)) clearBit(PAD_R1);
+        if (input.isKeyDown(KEY_LEFT_SHIFT)) clearBit(PAD_L2);
+        if (input.isKeyDown(KEY_RIGHT_SHIFT)) clearBit(PAD_R2);
+        if (input.isKeyDown(KEY_ENTER)) clearBit(PAD_START);
+        if (input.isKeyDown(KEY_TAB)) clearBit(PAD_SELECT);
+    }
+    else
+    {
+        if (input.isKeyDown(KEY_I)) clearBit(PAD_UP);
+        if (input.isKeyDown(KEY_K)) clearBit(PAD_DOWN);
+        if (input.isKeyDown(KEY_J)) clearBit(PAD_LEFT);
+        if (input.isKeyDown(KEY_L)) clearBit(PAD_RIGHT);
+        if (input.isKeyDown(KEY_G)) clearBit(PAD_CROSS);
+        if (input.isKeyDown(KEY_H)) clearBit(PAD_CIRCLE);
+        if (input.isKeyDown(KEY_F)) clearBit(PAD_SQUARE);
+        if (input.isKeyDown(KEY_T)) clearBit(PAD_TRIANGLE);
+        if (input.isKeyDown(KEY_R)) clearBit(PAD_L1);
+        if (input.isKeyDown(KEY_Y)) clearBit(PAD_R1);
+        if (input.isKeyDown(KEY_U)) clearBit(PAD_L2);
+        if (input.isKeyDown(KEY_O)) clearBit(PAD_R2);
+        if (input.isKeyDown(KEY_BACKSPACE)) clearBit(PAD_START);
+        if (input.isKeyDown(KEY_RIGHT_CONTROL)) clearBit(PAD_SELECT);
+    }
 
     data[2] = static_cast<uint8_t>(btns & 0xFF);
     data[3] = static_cast<uint8_t>(btns >> 8);
diff --git a/ps2xTest/src/pad_input_tests.cpp b/ps2xTest/src/pad_input_tests.cpp
index 508e5bc..eba63bc 100644
--- a/ps2xTest/src/pad_input_tests.cpp
+++ b/ps2xTest/src/pad_input_tests.cpp
@@ -91,6 +91,24 @@ namespace
         return key == KEY_ESCAPE;
     }
 
+    int heldKey = -1;
+    int connectedPads = 3;
+    bool routedKey(int key) { return key == heldKey; }
+    bool routedAvailable(int pad) { return (connectedPads & (1 << pad)) != 0; }
+    bool routedButton(int pad, int button)
+    {
+        return button == (pad == 0 ? GAMEPAD_BUTTON_RIGHT_FACE_DOWN : GAMEPAD_BUTTON_RIGHT_FACE_RIGHT);
+    }
+    float routedAxis(int pad, int axis)
+    {
+        const float sign = pad == 0 ? 1.0f : -1.0f;
+        if (axis == GAMEPAD_AXIS_LEFT_X) return -sign;
+        if (axis == GAMEPAD_AXIS_LEFT_Y) return sign * 0.5f;
+        if (axis == GAMEPAD_AXIS_RIGHT_X) return -sign * 0.5f;
+        if (axis == GAMEPAD_AXIS_RIGHT_Y) return sign;
+        return 0.0f;
+    }
+
     bool fakeNoGamepad(int /*gamepad*/)
     {
         return false;
@@ -121,6 +139,76 @@ void register_pad_input_tests()
             t.Equals(PSPadBackend::kHostExitKey, static_cast<int>(KEY_NULL), "no key may close the window");
         });
 
+        tc.Run("keyboard layouts never feed the other port", [](TestCase &t)
+               {
+            const PSPadBackend::HostInput input{routedKey, fakeNoGamepad, routedButton, routedAxis};
+            struct Binding { int key; uint16_t mask; int port; };
+            const Binding bindings[] = {
+                {KEY_UP, kPadBtnUp, 0}, {KEY_W, kPadBtnUp, 0},
+                {KEY_DOWN, kPadBtnDown, 0}, {KEY_S, kPadBtnDown, 0},
+                {KEY_LEFT, kPadBtnLeft, 0}, {KEY_A, kPadBtnLeft, 0},
+                {KEY_RIGHT, kPadBtnRight, 0}, {KEY_D, kPadBtnRight, 0},
+                {KEY_X, kPadBtnCross, 0}, {KEY_SPACE, kPadBtnCross, 0},
+                {KEY_C, kPadBtnCircle, 0}, {KEY_ESCAPE, kPadBtnCircle, 0},
+                {KEY_Z, kPadBtnSquare, 0}, {KEY_KP_0, kPadBtnSquare, 0},
+                {KEY_V, kPadBtnTriangle, 0}, {KEY_KP_1, kPadBtnTriangle, 0},
+                {KEY_Q, kPadBtnL1, 0}, {KEY_E, kPadBtnR1, 0},
+                {KEY_LEFT_SHIFT, kPadBtnL2, 0}, {KEY_RIGHT_SHIFT, kPadBtnR2, 0},
+                {KEY_ENTER, kPadBtnStart, 0}, {KEY_TAB, kPadBtnSelect, 0},
+                {KEY_I, kPadBtnUp, 1}, {KEY_K, kPadBtnDown, 1},
+                {KEY_J, kPadBtnLeft, 1}, {KEY_L, kPadBtnRight, 1},
+                {KEY_G, kPadBtnCross, 1}, {KEY_H, kPadBtnCircle, 1},
+                {KEY_F, kPadBtnSquare, 1}, {KEY_T, kPadBtnTriangle, 1},
+                {KEY_R, kPadBtnL1, 1}, {KEY_Y, kPadBtnR1, 1},
+                {KEY_U, kPadBtnL2, 1}, {KEY_O, kPadBtnR2, 1},
+                {KEY_BACKSPACE, kPadBtnStart, 1}, {KEY_RIGHT_CONTROL, kPadBtnSelect, 1}
+            };
+            for (const auto &binding : bindings)
+            {
+                heldKey = binding.key;
+                for (int port = 0; port < 2; ++port)
+                {
+                    uint8_t data[32]{};
+                    t.IsTrue(PSPadBackend::readState(input, data, sizeof(data), port, 0), "valid port");
+                    const uint16_t buttons = static_cast<uint16_t>(data[2] | (data[3] << 8));
+                    t.Equals(buttons, static_cast<uint16_t>(port == binding.port ? 0xFFFFu & ~binding.mask : 0xFFFFu),
+                             "key must reach only its assigned player");
+                }
+            }
+            heldKey = -1;
+        });
+
+        tc.Run("gamepad buttons and sticks stay on their own port", [](TestCase &t)
+               {
+            const PSPadBackend::HostInput input{routedKey, routedAvailable, routedButton, routedAxis};
+            heldKey = -1;
+            for (connectedPads = 0; connectedPads < 4; ++connectedPads)
+            {
+                for (int port = 0; port < 2; ++port)
+                {
+                    uint8_t data[32]{};
+                    t.IsTrue(PSPadBackend::readState(input, data, sizeof(data), port, 0), "valid port");
+                    const bool connected = (connectedPads & (1 << port)) != 0;
+                    const uint16_t mask = port == 0 ? kPadBtnCross : kPadBtnCircle;
+                    t.Equals(static_cast<uint16_t>(data[2] | (data[3] << 8)),
+                             static_cast<uint16_t>(connected ? 0xFFFFu & ~mask : 0xFFFFu), "no controller mirroring");
+                    t.Equals(static_cast<int>(data[6]), connected ? (port == 0 ? 1 : 255) : 128, "own left stick X only");
+                    t.Equals(static_cast<int>(data[7]), connected ? (port == 0 ? 191 : 64) : 128, "own left stick Y only");
+                    t.Equals(static_cast<int>(data[4]), connected ? (port == 0 ? 64 : 191) : 128, "own right stick X only");
+                    t.Equals(static_cast<int>(data[5]), connected ? (port == 0 ? 255 : 1) : 128, "own right stick Y only");
+                }
+            }
+        });
+
+        tc.Run("pad backend rejects unsupported ports and slots", [](TestCase &t)
+               {
+            const PSPadBackend::HostInput input{routedKey, routedAvailable, routedButton, routedAxis};
+            uint8_t data[32]{};
+            t.IsTrue(!PSPadBackend::readState(input, data, sizeof(data), -1, 0), "negative port rejected");
+            t.IsTrue(!PSPadBackend::readState(input, data, sizeof(data), 2, 0), "third port rejected");
+            t.IsTrue(!PSPadBackend::readState(input, data, sizeof(data), 0, 1), "multitap slot rejected");
+        });
+
         tc.Run("scePadRead uses override state", [](TestCase &t)
                {
             std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0);
