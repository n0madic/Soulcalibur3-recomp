             t.Equals(tall.y, 150.0f, "the picture should be centred vertically");
         });
 
+        tc.Run("PS2_HOST_FILTER names the window scaling filter", [](TestCase &t)
+        {
+            t.IsTrue(ps2ParseHostFilter("bicubic") == Ps2HostFilter::Bicubic, "bicubic");
