+// The emulated EE clock falls behind a real one: generated code charges a few
+// cycles per call or loop, and the host may take longer than the EE would.
+// A guest polling a timer waits for real time to pass, so a timer read brings
+// the clock up to the host time since the last VBlank, though never past the
+// next scheduled event, which the next checkpoint then handles, and by at most
+// maxCycles per read.
+void EeScheduler::catchUpWithHostTime(uint64_t maxCycles) noexcept
+{
+    const uint64_t nextEventCycle = m_nextDeadlineCycle.load(std::memory_order_acquire);
+    if (nextEventCycle == 0u || m_eeCycle >= nextEventCycle)
+        return;
+    const uint64_t hostCycle =
+        m_vblankCycle + hostDurationToEeCycles(std::chrono::steady_clock::now() - m_vblankHostTime);
+    uint64_t remaining = std::min(hostCycle, nextEventCycle);
+    if (remaining <= m_eeCycle)
+        return;
+    remaining = std::min(remaining - m_eeCycle, maxCycles);
+    while (remaining > 0u)
+    {
+        const uint32_t step = static_cast<uint32_t>(std::min<uint64_t>(remaining, std::numeric_limits<uint32_t>::max()));
+        accountCycles(step);
+        remaining -= step;
+    }
+}
