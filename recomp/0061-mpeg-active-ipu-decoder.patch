--- a/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
@@ -544,7 +544,7 @@ namespace ps2_stubs
             uint32_t isEndTraceCount = 0u;
             std::unordered_map<uint32_t, std::vector<MpegRegisteredCallback>> callbacksByMpeg;
             std::unordered_map<uint32_t, MpegPlaybackState> playbackByMpeg;
-            // The decoder that receives the toIPU DMA bitstream (the last one created).
+            // The decoder currently consuming the shared toIPU DMA bitstream.
             uint32_t ipuInputMpeg = 0u;
         };
 
@@ -1594,6 +1594,21 @@ namespace ps2_stubs
             return accepting;
         }
 
+        void installIpuInputSink(PS2Runtime *runtime)
+        {
+            runtime->memory().setIpuInputSink([runtime](const uint8_t *data, size_t size)
+            {
+                uint32_t active;
+                {
+                    std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
+                    active = g_mpeg_stub_state.ipuInputMpeg;
+                }
+                // The hardware FIFO stalls until a decoder consumes it. Creating
+                // another work area does not select that decoder for playback.
+                return active != 0u && feedIpuInput(runtime, active, data, size);
+            });
+        }
+
         bool libmpegInputEnded(uint8_t *rdram, uint32_t mpegAddr)
         {
             const uint8_t *mp = getConstMemPtr(rdram, mpegAddr);
@@ -2081,6 +2096,8 @@ namespace ps2_stubs
         {
             std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
             getPlaybackState(param_1) = makeFreshPlaybackState();
+            if (g_mpeg_stub_state.ipuInputMpeg == param_1)
+                g_mpeg_stub_state.ipuInputMpeg = 0u;
         }
 
         const uint32_t puVar4 = uVar3 + 0x108u;
@@ -2096,10 +2113,7 @@ namespace ps2_stubs
         }
         if (runtime)
         {
-            runtime->memory().setIpuInputSink([runtime, mpegAddr = param_1](const uint8_t *data, size_t size)
-                                              { return feedIpuInput(runtime, mpegAddr, data, size); });
-            std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
-            g_mpeg_stub_state.ipuInputMpeg = param_1;
+            installIpuInputSink(runtime);
         }
 
         const uint32_t a1_init = uVar3 + 0x118u;
@@ -2437,6 +2451,23 @@ namespace ps2_stubs
     {
         const uint32_t mpegAddr = getRegU32(ctx, 4);
         const uint32_t imageAddr = getRegU32(ctx, 5);
+        bool nativeInput = false;
+        {
+            std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
+            nativeInput = !getPlaybackState(mpegAddr).hleInput;
+            if (nativeInput)
+                g_mpeg_stub_state.ipuInputMpeg = mpegAddr;
+        }
+        if (nativeInput)
+        {
+            installIpuInputSink(runtime);
+            // Resume a DMA stalled on this FIFO, preserving its current address,
+            // remaining length and chain tag. Generic pending transfers are GIF/VIF.
+            constexpr uint32_t toIpuChcr = 0x1000B400u;
+            const uint32_t chcr = runtime->memory().readIORegister(toIpuChcr);
+            if ((chcr & 0x100u) != 0u)
+                runtime->memory().writeIORegister(toIpuChcr, chcr);
+        }
         uint32_t width = kStubMovieWidth;
         uint32_t height = kStubMovieHeight;
         uint32_t frameCount = 0u;
@@ -2681,6 +2712,8 @@ namespace ps2_stubs
                 resetState.cdStreamGeneration = playback.cdStreamGeneration;
             }
             playback = std::move(resetState);
+            if (g_mpeg_stub_state.ipuInputMpeg == param_1)
+                g_mpeg_stub_state.ipuInputMpeg = 0u;
         }
         uint8_t *base = getMemPtr(rdram, param_1);
         if (!base)
diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index 2d79f83..1fa2caf 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -2589,6 +2589,10 @@ uint32_t PS2Memory::readIORegister(uint32_t address)
         {
             if ((address & 0xFF) == 0x00)
             {
+                // Native IPU input can be backpressured. Polling CHCR must not
+                // complete a transfer that is still waiting for its decoder.
+                if (address == 0x1000B400u && m_ipuInputSink)
+                    return m_ioRegisters[address];
                 uint32_t channelStatus = m_ioRegisters[address] & ~0x100u;
                 m_ioRegisters[address] = channelStatus;
                 return channelStatus;
diff --git a/ps2xTest/src/ps2_runtime_expansion_tests.cpp b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
index 2941f87..c9d191f 100644
