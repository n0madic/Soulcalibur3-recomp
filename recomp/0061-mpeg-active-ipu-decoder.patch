 ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp    | 43 ++++++++++--
 ps2xRuntime/src/lib/ps2_memory.cpp           |  4 ++
 ps2xTest/src/ps2_runtime_expansion_tests.cpp | 71 ++++++++++++++++++++
 3 files changed, 113 insertions(+), 5 deletions(-)

