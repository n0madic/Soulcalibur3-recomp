+        bool nativeInput = false;
+        {
+            std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
+            nativeInput = !getPlaybackState(mpegAddr).hleInput;
+            if (nativeInput)
+                g_mpeg_stub_state.ipuInputMpeg = mpegAddr;
+        }
+        if (nativeInput)
+        {
+            installIpuInputSink(runtime);
+            // Resume a DMA stalled on this FIFO, preserving its current address,
+            // remaining length and chain tag. Generic pending transfers are GIF/VIF.
+            constexpr uint32_t toIpuChcr = 0x1000B400u;
+            const uint32_t chcr = runtime->memory().readIORegister(toIpuChcr);
+            if ((chcr & 0x100u) != 0u)
+                runtime->memory().writeIORegister(toIpuChcr, chcr);
