     }
 
+#if PS2X_HAS_FFMPEG
+    constexpr uint32_t kMultiMpeg = 0x140000u;
+    constexpr uint32_t kMultiMain = 0x125300u;
+    constexpr uint32_t kMultiResume = 0x125310u;
+    constexpr uint32_t kMultiWatchdog = 0x125320u;
+    int32_t multiMpegResult = -999;
+
+    void testMultiMpegMain(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        setRegU32(*ctx, 4, kMultiMpeg);
+        setRegU32(*ctx, 5, 0x190000u);
+        ctx->pc = kMultiResume;
+        ps2_stubs::sceMpegGetPicture(rdram, ctx, runtime);
+    }
+
+    void testMultiMpegResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        multiMpegResult = getRegS32(*ctx, 2);
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+#endif
+
 }
 
 void register_ps2_runtime_expansion_tests()
@@ -1072,6 +1095,54 @@ void register_ps2_runtime_expansion_tests()
                      "only the injected decoder frame should be counted as served");
         });
 
+#if PS2X_HAS_FFMPEG
+        tc.Run("native IPU input belongs to the decoder requesting a picture, not the last created", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            t.IsTrue(runtime.memory().initialize(), "memory initialization");
+            auto &mem = runtime.memory();
+            uint8_t *rdram = mem.getRDRAM();
+            ps2_stubs::resetMpegStubState();
+            multiMpegResult = -999;
+            // The menu preallocates two players, then starts the first one.
+            for (uint32_t i = 0; i < 2u; ++i)
+            {
+                R5900Context create{};
+                setRegU32(create, 4, kMultiMpeg + i * 0x1000u);
+                setRegU32(create, 5, 0x150000u + i * 0x10000u);
+                setRegU32(create, 6, 0x4000u);
+                ps2_stubs::sceMpegCreate(rdram, &create, &runtime);
+            }
+            constexpr uint32_t stream = 0x180000u;
+            const uint32_t qwc = (sizeof(kIpuFixtureM2v) + 31u) / 16u;
+            std::memcpy(rdram + stream, kIpuFixtureM2v, sizeof(kIpuFixtureM2v));
+            const uint8_t end[] = {0, 0, 1, 0xb7};
+            std::memcpy(rdram + stream + sizeof(kIpuFixtureM2v), end, sizeof(end));
+            mem.writeIORegister(0x1000b410u, stream);
+            mem.writeIORegister(0x1000b420u, qwc);
+            mem.writeIORegister(0x1000b400u, 0x101u);
+            t.Equals(mem.readIORegister(0x1000b420u), qwc,
+                     "IPU input must stay pending until a decoder consumes it");
+            t.Equals(mem.readIORegister(0x1000b400u) & 0x100u, 0x100u,
+                     "polling the stalled input must preserve the channel start bit");
+
+            runtime.registerFunction(kMultiMain, testMultiMpegMain);
+            runtime.registerFunction(kMultiResume, testMultiMpegResume);
+            runtime.registerFunction(kMultiWatchdog, testStopAfterMpegCallback);
+            R5900Context main{};
+            main.pc = kMultiMain;
+            auto &ee = runtime.eeScheduler();
+            ee.reset(rdram, main);
+            const int watchdog = ee.createThread(EeThreadCreateParams{0, kMultiWatchdog, 0, 0, 0, 10, 0});
+            ee.startThread(watchdog, 0, main, false);
+            ee.run();
+            t.Equals(multiMpegResult, 0, "the first player must receive its frame without waiting forever");
+            t.Equals(Ps2FastRead32(rdram, kMultiMpeg), 32u, "first player receives the decoded frame");
+            t.Equals(Ps2FastRead32(rdram, kMultiMpeg + 0x1000u), 0u, "idle second player stays unused");
+            t.Equals(mem.readIORegister(0x1000b420u), 0u, "selected decoder drains pending DMA");
+        });
+#endif
+
         tc.Run("sceMpegCreate clears the end-of-stream word that libmpeg's sceMpegIsEnd reads", [](TestCase &t)
         {
             PS2Runtime runtime;
