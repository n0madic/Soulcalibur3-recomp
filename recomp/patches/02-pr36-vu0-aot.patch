+    compare({{(0x24u << 25) | (1u << 11), tc::kUnop | tc::kEnd}, tc::kNop}, 17);
+    compare({{tc::iaddiu(1, 1, 1), tc::kUnop}, {tc::branch(0x20, 0, 0, 8, 0), tc::kUnop}, tc::kNop}, 17);
