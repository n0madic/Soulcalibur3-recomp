From 4a8d1681acd569069cd776a634ac6e330a6e48ae Mon Sep 17 00:00:00 2001
From: local <local@localhost>
Date: Thu, 22 Oct 2026 16:18:29 +0300
Subject: [PATCH] Hand in-flight VU results back in the interpreter's own view

Compiled routines write results at issue; the interpreter writes them when
their latency ends and only if no later write replaced them. A hand-back
now puts the in-flight VF and VI results into the interpreter's pipelines
and restores the registers to what it would show, tracked per lane at
each write. This showed when the interpreter stopped at once after a
hand-back, on a reserved instruction.
---
 ps2xRuntime/src/lib/vu/ps2_vu1_program.cpp | 12 +++++--
 ps2xRuntime/src/lib/vu/ps2_vu1_program.h   | 39 ++++++++++++++++++++++
 ps2xTest/data/vu_programs.py               | 12 +++----
 3 files changed, 53 insertions(+), 10 deletions(-)

diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_program.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_program.cpp
index 569d93b..6dcbe1b 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_program.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_program.cpp
@@ -173,8 +173,8 @@ int claimSlot(uint32_t &mask)
 }
 }
 
-// The value is already in the register file; the entry only makes the
-// interpreter stall on it, and rewrites the same value when it lands.
+// The entry takes the result from the register file, which handBack then
+// puts back to what the interpreter shows until the entry lands.
 void Access::pendVf(VU1Interpreter &vu, uint8_t reg, uint8_t lanes, uint64_t ready)
 {
     const int slot = claimSlot<VU1Interpreter::kMaxPendingVfWrites>(vu.m_vfWriteMask);
@@ -445,12 +445,20 @@ void Run::handBack()
                 if (m_vfReady[reg][other] == ready)
                     lanes |= lane(other);
             done |= lanes;
+            // The entry takes the result; the register goes back to what the
+            // interpreter would show until the entry lands.
             Access::pendVf(m_vu, reg, lanes, m_base + ready);
+            for (uint32_t other = component; other < 4u; ++other)
+                if ((lanes & lane(other)) != 0u)
+                    m_state.vf[reg][other] = m_vfVisible[reg][other];
         }
     }
     for (uint8_t reg = 1u; reg < 16u; ++reg)
         if (m_viReady[reg] > m_cycle)
+        {
             Access::pendVi(m_vu, reg, m_base + m_viReady[reg]);
+            m_state.vi[reg] = m_viVisible[reg];
+        }
     Access::finish(m_vu, m_base + m_cycle, m_workingClip, static_cast<uint8_t>(m_backupReg), m_backupValue,
                    m_pairs);
 }
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_program.h b/ps2xRuntime/src/lib/vu/ps2_vu1_program.h
index 9d219ef..b9d7d15 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_program.h
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_program.h
@@ -452,6 +452,12 @@ private:
     uint64_t m_generation;
     std::array<std::array<uint32_t, 4>, 32> m_vfReady{};
     std::array<uint32_t, 16> m_viReady{};
+    // What the interpreter's registers would hold while a write is in flight:
+    // it lands a write only if no later one replaced it, so a register reads
+    // as its last write that landed before the next one issued. Read only
+    // where a write is still in flight, so never cleared.
+    std::array<std::array<float, 4>, 32> m_vfVisible;
+    std::array<int32_t, 16> m_viVisible;
     // Not cleared: a run starts every MSCAL and only ever reads what it queued.
     std::array<PendingFlags, kFlagSlots> m_flags;
     ps2_vu_detail::upper::Result m_upper;
@@ -621,6 +627,9 @@ private:
     template <uint32_t Upper>
     PS2_VU_FORCE_INLINE void upper(float *value);
 
+    template <uint8_t Reg, uint8_t Lanes>
+    PS2_VU_FORCE_INLINE void keepVisible();
+
 #if PS2_VU_PROGRAM_NEON || PS2_VU_PROGRAM_SSE
     template <uint32_t Upper>
     PS2_VU_FORCE_INLINE bool fastUpper(float *value);
@@ -780,6 +789,7 @@ PS2_VU_FORCE_INLINE bool Frame::issue(uint32_t nextPc)
     {
         constexpr uint32_t latency = decoded.lowerUsage.vfLatency != 0u ? decoded.lowerUsage.vfLatency
                                                                         : decoded.lowerUsage.latency;
+        keepVisible<lowerReg, lowerLanes>();
         applyLanes<lowerLanes>(m_state.vf[lowerReg], lowerValue);
         setReady<lowerLanes>(m_run.m_vfReady[lowerReg].data(), m_cycle + latency);
     }
@@ -787,6 +797,7 @@ PS2_VU_FORCE_INLINE bool Frame::issue(uint32_t nextPc)
     {
         constexpr uint32_t latency = decoded.upperUsage.vfLatency != 0u ? decoded.upperUsage.vfLatency
                                                                         : decoded.upperUsage.latency;
+        keepVisible<upperReg, upperLanes>();
         applyLanes<upperLanes>(m_state.vf[upperReg], upperValue);
         setReady<upperLanes>(m_run.m_vfReady[upperReg].data(), m_cycle + latency);
     }
@@ -797,6 +808,8 @@ PS2_VU_FORCE_INLINE bool Frame::issue(uint32_t nextPc)
         constexpr uint32_t latency = decoded.lowerUsage.viLatency != 0u ? decoded.lowerUsage.viLatency
                                                                         : decoded.lowerUsage.latency;
         const int32_t old = m_state.vi[viReg];
+        if (m_run.m_viReady[viReg] <= m_cycle)
+            m_run.m_viVisible[viReg] = old;
         m_state.vi[viReg] = static_cast<int16_t>(viValue);
         m_run.m_viReady[viReg] = m_cycle + latency;
         // A conditional branch right after reads the value from before this write.
@@ -839,6 +852,32 @@ PS2_VU_FORCE_INLINE bool Frame::stale(uint32_t nextPc)
     return false;
 }
 
+template <uint8_t Reg, uint8_t Lanes>
+PS2_VU_FORCE_INLINE void Frame::keepVisible()
+{
+    // The register's last write landed unless it is still in flight.
+    const uint32_t *ready = m_run.m_vfReady[Reg].data();
+    float *visible = m_run.m_vfVisible[Reg].data();
+#if PS2_VU_PROGRAM_NEON
+    const uint32x4_t lanes = vmvnq_u32(fast::inactive<Lanes>());
+    const uint32x4_t landed = vandq_u32(lanes, vcleq_u32(vld1q_u32(ready), vdupq_n_u32(m_cycle)));
+    vst1q_f32(visible, vbslq_f32(landed, vld1q_f32(m_state.vf[Reg]), vld1q_f32(visible)));
+#elif PS2_VU_PROGRAM_SSE
+    // Relative cycles stay below 2^31, so the signed compare does.
+    const __m128i lanes = _mm_set_epi32((Lanes & 1u) ? -1 : 0, (Lanes & 2u) ? -1 : 0, (Lanes & 4u) ? -1 : 0,
+                                        (Lanes & 8u) ? -1 : 0);
+    const __m128i pending = _mm_cmpgt_epi32(_mm_loadu_si128(reinterpret_cast<const __m128i *>(ready)),
+                                            _mm_set1_epi32(static_cast<int32_t>(m_cycle)));
+    const __m128 landed = _mm_castsi128_ps(_mm_andnot_si128(pending, lanes));
+    _mm_storeu_ps(visible, _mm_or_ps(_mm_and_ps(landed, _mm_loadu_ps(m_state.vf[Reg])),
+                                     _mm_andnot_ps(landed, _mm_loadu_ps(visible))));
+#else
+    for (uint32_t component = 0; component < 4u; ++component)
+        if ((Lanes & lane(component)) != 0u && ready[component] <= m_cycle)
+            visible[component] = m_state.vf[Reg][component];
+#endif
+}
+
 template <uint32_t Upper>
 PS2_VU_FORCE_INLINE void Frame::upper(float *value)
 {
diff --git a/ps2xTest/data/vu_programs.py b/ps2xTest/data/vu_programs.py
index 287aa9a..d4cdcd0 100644
--- a/ps2xTest/data/vu_programs.py
+++ b/ps2xTest/data/vu_programs.py
@@ -390,16 +390,12 @@ def handed_back(generator):
 
 
 def stopped_by_xgkick(generator):
-    """XGKICK is reserved on VU0: the compiled routine leaves it to the interpreter, which stops.
-
-    The interpreter stops before results still in flight land, while the
-    compiled pairs wrote theirs at issue, so the pairs right before the stop
-    write nothing (see the README's known gaps).
-    """
+    """XGKICK is reserved on VU0: the compiled routine leaves it to the interpreter,
+    which stops at once, with the last pairs' results still in flight: an ADD
+    and an ILW, whose VI result takes four cycles too."""
     program = generator.start(16)
     generator.straight(program, 10)
-    for _ in range(4):
-        program.add()
+    program.add(memory(0x04, 8, 2, BASE, 3), upper(0x28, 0b1111, 2, 1, 3))  # ILW.x vi2 / ADD vf3, vf1, vf2
     program.add(lower_special(0x6C, KICK), UPPER_NOP)
     generator.straight(program, 4)
     generator.end(program)
