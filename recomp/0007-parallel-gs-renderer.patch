diff --git a/ps2xTest/src/ps2_gs_parallel_tests.cpp b/ps2xTest/src/ps2_gs_parallel_tests.cpp
new file mode 100644
index 0000000..8473622
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_parallel_tests.cpp
@@ -0,0 +1,214 @@
+#include "MiniTest.h"
+#include "gpu_gs_test_support.h"
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/gs/gs_parallel.h"
+#include "runtime/gs/ps2_gif_arbiter.h"
+#include "runtime/ps2_memory.h"
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+// The GPU GS (paraLLEl-GS) path: the layout helpers it shares with the dump recorder, and the GS
+// behaviour the game depends on, checked on the GPU renderer (and on the CPU one where both apply).
+
+namespace
+{
+    constexpr uint8_t kRegPrim = 0x00;
+    constexpr uint8_t kRegRgbaq = 0x01;
+    constexpr uint8_t kRegXyz2 = 0x05;
+    constexpr uint8_t kRegXyoffset1 = 0x18;
+    constexpr uint8_t kRegScissor1 = 0x40;
+    constexpr uint8_t kRegTest1 = 0x47;
+    constexpr uint8_t kRegFrame1 = 0x4C;
+    constexpr uint8_t kRegZbuf1 = 0x4E;
+    constexpr uint8_t kRegBitbltbuf = 0x50;
+    constexpr uint8_t kRegTrxpos = 0x51;
+    constexpr uint8_t kRegTrxreg = 0x52;
+    constexpr uint8_t kRegTrxdir = 0x53;
+    constexpr uint8_t kRegSignal = 0x60;
+    constexpr uint8_t kRegFinish = 0x61;
+    constexpr uint8_t kRegLabel = 0x62;
+
+    // A GS with its own local memory and privileged registers, on the CPU or the GPU renderer.
+    struct GsFixture
+    {
+        std::vector<uint8_t> vram = std::vector<uint8_t>(PS2_GS_VRAM_SIZE, 0u);
+        std::unique_ptr<GSRegisters> regs = std::make_unique<GSRegisters>();
+        GS gs;
+
+        GsFixture() { gs.init(vram.data(), static_cast<uint32_t>(vram.size()), regs.get()); }
+    };
+
+    // One A+D GIF packet writing the given registers.
+    std::vector<uint64_t> adPacket(const std::vector<std::pair<uint8_t, uint64_t>> &writes)
+    {
+        std::vector<uint64_t> packet{static_cast<uint64_t>(writes.size()) | (1ull << 15) | (1ull << 60), 0xEull};
+        for (const auto &[reg, value] : writes)
+        {
+            packet.push_back(value);
+            packet.push_back(reg);
+        }
+        return packet;
+    }
+
+    void send(GS &gs, const std::vector<uint64_t> &packet)
+    {
+        gs.processGIFPacket(reinterpret_cast<const uint8_t *>(packet.data()),
+                            static_cast<uint32_t>(packet.size() * sizeof(uint64_t)));
+    }
+
+    void runSignalFinishLabel(TestCase &t, bool gpu)
+    {
+        GsFixture f;
+        if (gpu && !requireGpuGs(t, f.gs))
+            return;
+        send(f.gs, adPacket({{kRegSignal, (0xFFFFull << 32) | 0x2u},
+                             {kRegFinish, 0u},
+                             {kRegLabel, (0xFFFFull << 32) | 0x1234u}}));
+        const uint64_t csr = f.regs->csr.load();
+        t.Equals(csr & 0x1u, 0x1ull, "SIGNAL raises CSR.SIGNAL");
+        t.Equals(csr & 0x2u, 0x2ull, "FINISH raises CSR.FINISH");
+        t.Equals(f.regs->siglblid & 0xFFFFFFFFull, 0x2ull, "SIGNAL sets the SIGLBLID signal id");
+        t.Equals(f.regs->siglblid >> 32, 0x1234ull, "LABEL sets the SIGLBLID label id");
+    }
+
+    void runLocalToHost(TestCase &t, bool gpu)
+    {
+        GsFixture f;
+        if (gpu && !requireGpuGs(t, f.gs))
+            return;
+
+        // 8x8 PSMCT32 block at block address 0x1000 (1 MiB), buffer width 64 pixels.
+        std::vector<uint8_t> pixels(8u * 8u * 4u);
+        for (size_t i = 0; i < pixels.size(); ++i)
+            pixels[i] = static_cast<uint8_t>(i * 7u + 3u);
+        const uint64_t trxreg = 8ull | (8ull << 32);
+        f.gs.uploadImageNative((0x1000ull << 32) | (1ull << 48), 0u, trxreg, 0u, pixels.data(),
+                               static_cast<uint32_t>(pixels.size()));
+
+        f.gs.writeRegister(kRegBitbltbuf, 0x1000ull | (1ull << 16));
+        f.gs.writeRegister(kRegTrxpos, 0u);
+        f.gs.writeRegister(kRegTrxreg, trxreg);
+        f.gs.writeRegister(kRegTrxdir, 1u);
+        std::vector<uint8_t> readBack(pixels.size(), 0u);
+        const uint32_t bytes = f.gs.consumeLocalToHostBytes(readBack.data(), static_cast<uint32_t>(readBack.size()));
+        t.Equals(bytes, static_cast<uint32_t>(pixels.size()), "the whole rectangle is read back");
+        t.IsTrue(readBack == pixels, "local->host returns what host->local wrote");
+    }
+}
+
+void register_ps2_gs_parallel_tests()
+{
+    MiniTest::Case("PS2GsParallel", [](TestCase &tc)
+    {
+        tc.Run("privileged registers are packed in the paraLLEl-GS layout", [](TestCase &t)
+        {
+            auto regs = std::make_unique<GSRegisters>();
+            regs->pmode = 0x11u;
+            regs->smode1 = 0x22u;
+            regs->dispfb1 = 0x33u;
+            regs->display2 = 0x44u;
+            regs->bgcolor = 0x55u;
+            regs->csr.store(0x66u);
+            regs->imr = 0x77u;
+            regs->busdir = 0x88u;
+            regs->siglblid = 0x99u;
+            uint64_t packed[kGsPrivStateQwords];
+            std::memset(packed, 0xCD, sizeof(packed));
+            gsPackPrivRegisters(*regs, packed);
+
+            t.Equals(packed[0x00], 0x11ull, "PMODE is at 0x12000000");
+            t.Equals(packed[0x02], 0x22ull, "SMODE1 is at 0x12000010");
+            t.Equals(packed[0x0E], 0x33ull, "DISPFB1 is at 0x12000070");
+            t.Equals(packed[0x14], 0x44ull, "DISPLAY2 is at 0x120000A0");
+            t.Equals(packed[0x1C], 0x55ull, "BGCOLOR is at 0x120000E0");
+            t.Equals(packed[0x200], 0x66ull, "CSR is at 0x12001000");
+            t.Equals(packed[0x202], 0x77ull, "IMR is at 0x12001010");
+            t.Equals(packed[0x208], 0x88ull, "BUSDIR is at 0x12001040");
+            t.Equals(packed[0x210], 0x99ull, "SIGLBLID is at 0x12001080");
+            t.Equals(packed[0x01], 0ull, "the upper half of each 128-bit register is zero");
+        });
+
+        tc.Run("an image upload is rebuilt as its GIF packet", [](TestCase &t)
+        {
+            uint8_t pixels[40];
+            for (uint8_t i = 0; i < sizeof(pixels); ++i)
+                pixels[i] = i;
+            const std::vector<uint64_t> packet = gsBuildImageUploadPacket(0xB1u, 0xB2u, 0xB3u, 0xB4u, pixels, sizeof(pixels));
+
+            t.Equals(packet.size(), static_cast<size_t>(12u + 4u), "A+D tag, 4 registers, IMAGE tag, 2 whole qwords");
+            t.Equals(packet[0], 4ull | (1ull << 60), "PACKED tag with NLOOP=4, NREG=1");
+            t.Equals(packet[1], 0xEull, "the register is A+D");
+            t.Equals(packet[2], 0xB1ull, "BITBLTBUF value");
+            t.Equals(packet[3], 0x50ull, "BITBLTBUF address");
+            t.Equals(packet[9], 0x53ull, "TRXDIR address comes last");
+            t.Equals(packet[10], 2ull | (1ull << 15) | (2ull << 58), "IMAGE tag with EOP and NLOOP=2");
+            t.IsTrue(std::memcmp(packet.data() + 12, pixels, 32) == 0, "the pixel qwords follow the IMAGE tag");
+        });
+
+        tc.Run("the GIF arbiter reports the path each packet came on", [](TestCase &t)
+        {
+            std::vector<GifPathId> paths;
+            GifArbiter arbiter([&](GifPathId path, const uint8_t *, uint32_t) { paths.push_back(path); });
+            const uint64_t packet[2] = {1ull << 15, 0u};
+            arbiter.submit(GifPathId::Path3, reinterpret_cast<const uint8_t *>(packet), sizeof(packet));
+            arbiter.submit(GifPathId::Path1, reinterpret_cast<const uint8_t *>(packet), sizeof(packet));
+            arbiter.drain();
+            const std::vector<GifPathId> expected{GifPathId::Path1, GifPathId::Path3};
+            t.IsTrue(paths == expected, "packets are delivered by path priority, each with its path");
+        });
+
+        tc.Run("SIGNAL, FINISH and LABEL reach CSR and SIGLBLID (CPU GS)", [](TestCase &t)
+               { runSignalFinishLabel(t, false); });
+        tc.Run("SIGNAL, FINISH and LABEL reach CSR and SIGLBLID (GPU GS)", [](TestCase &t)
+               { runSignalFinishLabel(t, true); });
+
+        tc.Run("local->host transfer reads back uploaded pixels (CPU GS)", [](TestCase &t)
+               { runLocalToHost(t, false); });
+        tc.Run("local->host transfer reads back uploaded pixels (GPU GS)", [](TestCase &t)
+               { runLocalToHost(t, true); });
+
+        tc.Run("a sprite drawn into the display buffer is presented (GPU GS)", [](TestCase &t)
+        {
+            GsFixture f;
+            if (!requireGpuGs(t, f.gs))
+                return;
+
+            // PAL display of a 512x512 PSMCT32 buffer at page 0, as Soulcalibur III sets it up.
+            f.regs->pmode = 0x1u | (1u << 2) | (1u << 5) | (0xFFu << 8); // EN1, CRTMD=1, MMOD, ALP=0xFF
+            f.regs->smode1 = (32ull << 3) | (3ull << 13);                 // LC=32, CMOD=PAL
+            f.regs->smode2 = 0x1u;
+            f.regs->dispfb1 = 8ull << 9;                                  // FBW=8 (512 pixels)
+            f.regs->display1 = 0x1FE9FF0204B296ull;
+
+            send(f.gs, adPacket({{kRegFrame1, 8ull << 16},
+                                 {kRegZbuf1, 0x100ull | (1ull << 32)},
+                                 {kRegTest1, (1ull << 16) | (1ull << 17)},
+                                 {kRegXyoffset1, 0u},
+                                 {kRegScissor1, (511ull << 16) | (511ull << 48)},
+                                 {kRegPrim, 6u},
+                                 {kRegRgbaq, 0x20u | (0xC0u << 8) | (0x40u << 16) | (0x80ull << 24)},
+                                 {kRegXyz2, 0u},
+                                 {kRegXyz2, (512ull << 4) | ((512ull << 4) << 16)}}));
+            // The picture of a vsync is read back asynchronously and published on the next one.
+            f.gs.onVsync(0u);
+            f.gs.onVsync(1u);
+            f.gs.latchHostPresentationFrame();
+
+            std::vector<uint8_t> frame;
+            uint32_t width = 0;
+            uint32_t height = 0;
+            t.IsTrue(f.gs.copyLatchedHostPresentationFrame(frame, width, height), "a frame is presented");
+            t.IsTrue(width >= 256u && height >= 256u, "the frame has the display's size");
+            if (width == 0u || height == 0u)
+                return;
+            const uint8_t *pixel = frame.data() + (static_cast<size_t>(height / 2u) * width + width / 2u) * 4u;
+            t.Equals(static_cast<uint32_t>(pixel[0]), 0x20u, "red of the sprite");
+            t.Equals(static_cast<uint32_t>(pixel[1]), 0xC0u, "green of the sprite");
+            t.Equals(static_cast<uint32_t>(pixel[2]), 0x40u, "blue of the sprite");
+        });
+    });
+}
