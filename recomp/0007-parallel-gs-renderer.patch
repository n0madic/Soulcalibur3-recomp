+// The CPU backend clears the whole frame buffer of a context directly. The GPU renderer does not track
+// contexts on the host; the clear sprite the HLE callers also send through writeRegister() does the job.
 bool GS::clearFramebufferContext(uint32_t contextIndex, uint32_t rgba)
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (m_parallel)
+        return false;
     return m_backend && m_backend->ClearFramebuffer(m_ctx[(contextIndex != 0u) ? 1 : 0], rgba);
 }
 
 bool GS::clearActiveFramebuffer(uint32_t rgba)
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (m_parallel)
+        return false;
     return m_backend && m_backend->ClearFramebuffer(activeContext(), rgba);
 }
 
 uint32_t GS::consumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (m_parallel)
+        return m_parallel->readLocalToHost(dst, maxBytes);
     return m_backend ? m_backend->ConsumeLocalToHostBytes(dst, maxBytes) : 0u;
 }
 
+bool GS::enableParallelRenderer(std::string &error)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (m_parallel)
+        return true;
+    if (!m_privRegs)
+    {
+        error = "GS::init() with the privileged registers must run first";
+        return false;
+    }
+    m_parallel = GSParallelRenderer::create(*m_privRegs, error);
+    return static_cast<bool>(m_parallel);
+}
+
+void GS::onVsync(uint32_t field)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (m_parallel)
+        m_parallel->vsync(field);
+}
