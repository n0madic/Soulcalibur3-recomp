new file mode 100644
index 0000000..790d4f8
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_priv_registers.cpp
@@ -0,0 +1,80 @@
+#include "runtime/ps2_memory.h"
+#include "ps2_log.h"
+
+#include <cstring>
+
+namespace
+{
+    constexpr uint64_t kCsrSignal = 0x1u;
+
+    void applySignal(GSRegisters &regs, uint64_t value)
+    {
+        const uint32_t id = static_cast<uint32_t>(value & 0xFFFFFFFFu);
+        const uint32_t mask = static_cast<uint32_t>(value >> 32);
+        uint32_t lo = static_cast<uint32_t>(regs.siglblid & 0xFFFFFFFFu);
+        lo = (lo & ~mask) | (id & mask);
+        regs.siglblid = (regs.siglblid & 0xFFFFFFFF00000000ull) | lo;
+        regs.csr.fetch_or(kCsrSignal);
+    }
+}
+
+void gsWriteSignal(GSRegisters &regs, uint64_t value)
+{
+    if ((regs.csr.load(std::memory_order_acquire) & kCsrSignal) == 0u)
+    {
+        applySignal(regs, value);
+        return;
+    }
+    if (regs.queuedSignalCount < GSRegisters::kMaxQueuedSignals)
+    {
+        regs.queuedSignals[regs.queuedSignalCount++] = value;
+        return;
+    }
+    RUNTIME_LOG("[gs:signal] queue full, dropping SIGNAL 0x" << std::hex << value << std::dec << std::endl);
+}
+
+void gsSetCrt(GSRegisters &regs, uint32_t interlaced, uint32_t videoMode, uint32_t frameMode)
+{
+    regs.smode2 = (static_cast<uint64_t>(interlaced) & 0x1ull) | ((static_cast<uint64_t>(frameMode) & 0x1ull) << 1);
+
+    // SMODE1's line clock (LC) and colour mode (CMOD) tell the scanout which video format the
+    // display registers are in.
+    uint64_t lineClock = 32u; // NTSC/PAL analog
+    uint64_t colourMode = (videoMode == 3u) ? 3u : 2u;
+    if (videoMode >= 0x50u)
+    {
+        lineClock = 22u; // HDTV
+        colourMode = 0u;
+    }
+    else if (videoMode >= 0x1Au)
+    {
+        lineClock = 15u; // VESA
+        colourMode = 0u;
+    }
+    constexpr uint64_t kSmode1Fields = (0x7Full << 3) | (0x3ull << 13);
+    regs.smode1 = (regs.smode1 & ~kSmode1Fields) | (lineClock << 3) | (colourMode << 13);
+}
+
+void gsWriteFinish(GSRegisters &regs)
+{
+    regs.csr.fetch_or(0x2u, std::memory_order_acq_rel);
+}
+
+void gsWriteLabel(GSRegisters &regs, uint64_t value)
+{
+    const uint32_t id = static_cast<uint32_t>(value & 0xFFFFFFFFu);
+    const uint32_t mask = static_cast<uint32_t>(value >> 32);
+    uint32_t hi = static_cast<uint32_t>(regs.siglblid >> 32);
+    hi = (hi & ~mask) | (id & mask);
+    regs.siglblid = (static_cast<uint64_t>(hi) << 32) | (regs.siglblid & 0xFFFFFFFFu);
+}
+
+void gsApplyQueuedSignal(GSRegisters &regs)
+{
+    if (regs.queuedSignalCount == 0u || (regs.csr.load(std::memory_order_acquire) & kCsrSignal) != 0u)
+        return;
+    const uint64_t value = regs.queuedSignals[0];
+    regs.queuedSignalCount--;
+    std::memmove(regs.queuedSignals, regs.queuedSignals + 1, regs.queuedSignalCount * sizeof(uint64_t));
+    applySignal(regs, value);
+}
