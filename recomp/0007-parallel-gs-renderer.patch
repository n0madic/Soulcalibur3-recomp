+std::unique_ptr<GSParallelRenderer> GSParallelRenderer::create(GSRegisters &privRegs, std::string &error)
+{
+    auto renderer = std::make_unique<ParallelRenderer>(privRegs);
+    if (!renderer->init(error))
+        return nullptr;
+    return renderer;
+}
