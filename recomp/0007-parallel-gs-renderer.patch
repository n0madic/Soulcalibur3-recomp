+// PS2_GS_BACKEND picks the GS renderer: "parallel" (paraLLEl-GS on Vulkan, the default) or "cpu".
+// When the default cannot start (no Vulkan, built without paraLLEl-GS) the CPU GS takes over; an
+// explicit "parallel" that cannot start is an error.
+bool PS2Runtime::selectGsRenderer()
+{
+    const char *choice = std::getenv("PS2_GS_BACKEND");
+    const std::string backend = choice ? choice : "";
+    if (backend == "cpu")
+    {
+        std::cout << "[gs] renderer: CPU (PS2_GS_BACKEND=cpu)" << std::endl;
+        return true;
+    }
+    if (!backend.empty() && backend != "parallel")
+    {
+        std::cerr << "[gs] unknown PS2_GS_BACKEND '" << backend << "' (expected parallel or cpu)" << std::endl;
+        return false;
+    }
+
+    std::string error;
+    if (m_gs.enableParallelRenderer(error))
+    {
+        std::cout << "[gs] renderer: paraLLEl-GS (Vulkan)" << std::endl;
+        return true;
+    }
+    if (backend == "parallel")
+    {
+        std::cerr << "[gs] paraLLEl-GS unavailable: " << error << std::endl;
+        return false;
+    }
+    std::cerr << "[gs] paraLLEl-GS unavailable (" << error << "), falling back to the CPU GS" << std::endl;
+    return true;
+}
