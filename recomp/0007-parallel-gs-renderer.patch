+    std::memset(out, 0, sizeof(out));
+    const uint64_t displayRegs[] = {regs.pmode, regs.smode1, regs.smode2, regs.srfsh, regs.synch1,
+                                    regs.synch2, regs.syncv, regs.dispfb1, regs.display1, regs.dispfb2,
+                                    regs.display2, regs.extbuf, regs.extdata, regs.extwrite, regs.bgcolor};
+    for (size_t i = 0; i < sizeof(displayRegs) / sizeof(displayRegs[0]); ++i)
+        out[i * 2u] = displayRegs[i];
+    uint64_t *const control = out + kGsPrivStateQwords / 2u;
+    control[0] = regs.csr.load(std::memory_order_acquire);
+    control[2] = regs.imr;
+    control[8] = regs.busdir;
+    control[16] = regs.siglblid;
+}
+
+std::vector<uint64_t> gsBuildImageUploadPacket(uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg, uint64_t trxdir,
+                                               const uint8_t *data, uint32_t sizeBytes)
+{
+    const uint32_t qwords = sizeBytes / 16u;
+    std::vector<uint64_t> packet;
+    packet.reserve(12u + static_cast<size_t>(qwords) * 2u);
+    packet.push_back(4ull | (1ull << 60));                       // PACKED, NLOOP=4, NREG=1
+    packet.push_back(0xEull);                                    // REGS = A+D
+    const uint64_t setup[4][2] = {{bitbltbuf, GS_REG_BITBLTBUF}, {trxpos, GS_REG_TRXPOS},
+                                  {trxreg, GS_REG_TRXREG}, {trxdir, GS_REG_TRXDIR}};
+    for (const auto &reg : setup)
+    {
+        packet.push_back(reg[0]);
+        packet.push_back(reg[1]);
+    }
+    packet.push_back(static_cast<uint64_t>(qwords) | (1ull << 15) | (2ull << 58)); // IMAGE, EOP
+    packet.push_back(0u);
+    const size_t header = packet.size();
+    packet.resize(header + static_cast<size_t>(qwords) * 2u);
+    if (qwords != 0u)
+        std::memcpy(packet.data() + header, data, static_cast<size_t>(qwords) * 16u);
+    return packet;
+}
