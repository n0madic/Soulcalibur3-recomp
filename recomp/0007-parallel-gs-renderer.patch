new file mode 100644
index 0000000..edd6108
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_parallel.cpp
@@ -0,0 +1,270 @@
+#include "runtime/gs/gs_parallel.h"
+#include "runtime/ps2_memory.h"
+
+#include "context.hpp"
+#include "device.hpp"
+#include "gs_interface.hpp"
+#include "thread_id.hpp"
+
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <mutex>
+
+namespace
+{
+    // The Vulkan loader is not on the default dyld path on macOS (Homebrew installs it under
+    // /opt/homebrew/lib), so look in the usual places; PS2_VULKAN_LIBRARY overrides the search.
+    PFN_vkGetInstanceProcAddr loadVulkan(std::string &error)
+    {
+        static void *module = nullptr;
+        if (!module)
+        {
+            std::vector<std::string> candidates;
+            if (const char *path = std::getenv("PS2_VULKAN_LIBRARY"); path && *path)
+                candidates.emplace_back(path);
+#if defined(__APPLE__)
+            candidates.insert(candidates.end(), {"libvulkan.1.dylib", "/opt/homebrew/lib/libvulkan.1.dylib",
+                                                 "/usr/local/lib/libvulkan.1.dylib", "libMoltenVK.dylib",
+                                                 "/opt/homebrew/lib/libMoltenVK.dylib",
+                                                 "/usr/local/lib/libMoltenVK.dylib"});
+#else
+            candidates.insert(candidates.end(), {"libvulkan.so.1", "libvulkan.so"});
+#endif
+            for (const std::string &candidate : candidates)
+            {
+                module = dlopen(candidate.c_str(), RTLD_LOCAL | RTLD_LAZY);
+                if (module)
+                    break;
+            }
+            if (!module)
+            {
+                error = "no Vulkan loader found (install molten-vk and vulkan-loader, or set PS2_VULKAN_LIBRARY)";
+                return nullptr;
+            }
+        }
+        auto addr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(module, "vkGetInstanceProcAddr"));
+        if (!addr)
+            error = "the Vulkan library has no vkGetInstanceProcAddr";
+        return addr;
+    }
+
+    // SIGNAL, FINISH and LABEL as the GS reports them to the EE: through CSR and SIGLBLID, from which
+    // the runtime raises the GS interrupt.
+    class SignalSink final : public ParallelGS::SignalInterface
+    {
+    public:
+        explicit SignalSink(GSRegisters &regs) : m_regs(regs) {}
+
+        bool on_signal(uint64_t payload) override
+        {
+            gsWriteSignal(m_regs, payload);
+            return false;
+        }
+        bool on_finish(uint64_t) override
+        {
+            gsWriteFinish(m_regs);
+            return false;
+        }
+        bool on_label(uint64_t payload) override
+        {
+            gsWriteLabel(m_regs, payload);
+            return false;
+        }
+
+    private:
+        GSRegisters &m_regs;
+    };
+
+    // Granite keys per-thread command pools by a registered thread index. The GS frontend serialises
+    // all calls, which come from the game thread and (in tests) the main thread, so all share index 0.
+    void bindGraniteThread()
+    {
+        Util::register_thread_index(0);
+    }
+
+    class ParallelRenderer final : public GSParallelRenderer
+    {
+    public:
+        explicit ParallelRenderer(GSRegisters &privRegs) : m_privRegs(privRegs), m_signals(privRegs) {}
+
+        ~ParallelRenderer() override
+        {
+            bindGraniteThread();
+            if (m_ready)
+                m_device.wait_idle();
+        }
+
+        bool init(std::string &error)
+        {
+            bindGraniteThread();
+            PFN_vkGetInstanceProcAddr addr = loadVulkan(error);
+            if (!addr || !Vulkan::Context::init_loader(addr))
+            {
+                if (error.empty())
+                    error = "cannot initialise the Vulkan loader";
+                return false;
+            }
+            m_context.set_num_thread_indices(1);
+            if (!m_context.init_instance_and_device(nullptr, 0, nullptr, 0,
+                                                    Vulkan::CONTEXT_CREATION_ENABLE_PUSH_DESCRIPTOR_BIT |
+                                                        Vulkan::CONTEXT_CREATION_ENABLE_DESCRIPTOR_HEAP_BIT |
+                                                        Vulkan::CONTEXT_CREATION_ENABLE_DESCRIPTOR_BUFFER_BIT))
+            {
+                error = "cannot create a Vulkan device";
+                return false;
+            }
+            m_device.set_context(m_context);
+            m_device.init_frame_contexts(4);
+
+            ParallelGS::GSOptions options = {};
+            if (!m_gs.init(&m_device, options))
+            {
+                error = "the Vulkan device lacks features paraLLEl-GS needs";
+                return false;
+            }
+            m_gs.set_signal_interface(&m_signals);
+            m_ready = true;
+            return true;
+        }
+
+        void transfer(uint32_t path, const uint8_t *data, uint32_t sizeBytes) override
+        {
+            bindGraniteThread();
+            m_gs.gif_transfer(path, data, sizeBytes & ~15u);
+        }
+
+        void writeRegister(uint8_t regAddr, uint64_t value) override
+        {
+            bindGraniteThread();
+            m_gs.write_register(static_cast<ParallelGS::RegisterAddr>(regAddr), value);
+        }
+
+        uint32_t readLocalToHost(uint8_t *dst, uint32_t maxBytes) override
+        {
+            bindGraniteThread();
+            const uint32_t qwords = maxBytes / 16u;
+            m_gs.read_transfer_fifo(dst, qwords);
+            return qwords * 16u;
+        }
+
+        void vsync(uint32_t field) override
+        {
+            bindGraniteThread();
+            static_assert(sizeof(ParallelGS::PrivRegisterState) == kGsPrivStateQwords * sizeof(uint64_t),
+                          "paraLLEl-GS privileged register layout changed");
+            uint64_t priv[kGsPrivStateQwords];
+            gsPackPrivRegisters(m_privRegs, priv);
+            std::memcpy(&m_gs.get_priv_register_state(), priv, sizeof(priv));
+
+            ParallelGS::VSyncInfo info = {};
+            info.phase = field;
+            info.dst_layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+            info.dst_stage = VK_PIPELINE_STAGE_2_COPY_BIT;
+            info.dst_access = VK_ACCESS_2_TRANSFER_READ_BIT;
+            info.force_progressive = true;
+            info.anti_blur = true;
+            info.adapt_to_internal_horizontal_resolution = true;
+
+            m_gs.flush();
+            ParallelGS::ScanoutResult result = m_gs.vsync(info);
+
+            // The previous picture has had a whole vsync to finish; publish it before queueing this one.
+            publishPendingReadback();
+            if (result.image)
+                startReadback(*result.image);
+            m_device.next_frame_context();
+        }
+
+        bool copyLatestFrame(std::vector<uint8_t> &rgba, uint32_t &width, uint32_t &height) override
+        {
+            std::lock_guard<std::mutex> lock(m_frameMutex);
+            if (m_frame.empty())
+                return false;
+            rgba = m_frame;
+            width = m_frameWidth;
+            height = m_frameHeight;
+            return true;
+        }
+
+        void finish() override
+        {
+            bindGraniteThread();
+            m_gs.flush();
+            m_device.wait_idle();
+            publishPendingReadback();
+        }
+
+    private:
+        struct Readback
+        {
+            Vulkan::BufferHandle buffer;
+            Vulkan::Fence fence;
+            uint32_t width = 0;
+            uint32_t height = 0;
+        };
+
+        void startReadback(const Vulkan::Image &image)
+        {
+            Readback readback;
+            readback.width = image.get_width();
+            readback.height = image.get_height();
+
+            Vulkan::BufferCreateInfo info = {};
+            info.size = VkDeviceSize(readback.width) * readback.height * 4u;
+            info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+            info.domain = Vulkan::BufferDomain::CachedHost;
+            readback.buffer = m_device.create_buffer(info);
+
+            auto cmd = m_device.request_command_buffer();
+            cmd->copy_image_to_buffer(*readback.buffer, image, 0, {}, {readback.width, readback.height, 1}, 0, 0,
+                                      {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1});
+            cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                         VK_PIPELINE_STAGE_2_HOST_BIT, VK_ACCESS_2_HOST_READ_BIT);
+            m_device.submit(cmd, &readback.fence);
+            m_pending = std::move(readback);
+        }
+
+        void publishPendingReadback()
+        {
+            if (!m_pending.buffer)
+                return;
+            m_pending.fence->wait();
+            const size_t bytes = size_t(m_pending.width) * m_pending.height * 4u;
+            const auto *pixels = static_cast<const uint8_t *>(
+                m_device.map_host_buffer(*m_pending.buffer, Vulkan::MEMORY_ACCESS_READ_BIT));
+            {
+                std::lock_guard<std::mutex> lock(m_frameMutex);
+                m_frame.assign(pixels, pixels + bytes);
+                // The scanout carries the merge circuit's alpha; the host shows the picture opaque.
+                for (size_t i = 3; i < m_frame.size(); i += 4)
+                    m_frame[i] = 0xFF;
+                m_frameWidth = m_pending.width;
+                m_frameHeight = m_pending.height;
+            }
+            m_device.unmap_host_buffer(*m_pending.buffer, Vulkan::MEMORY_ACCESS_READ_BIT);
+            m_pending = {};
+        }
+
+        GSRegisters &m_privRegs;
+        SignalSink m_signals;
+        Vulkan::Context m_context;
+        Vulkan::Device m_device;
+        ParallelGS::GSInterface m_gs;
+        bool m_ready = false;
+
+        Readback m_pending;
+        std::mutex m_frameMutex;
+        std::vector<uint8_t> m_frame;
+        uint32_t m_frameWidth = 0;
+        uint32_t m_frameHeight = 0;
+    };
+}
