@@ -507,6 +508,23 @@ target_include_directories(ps2_runtime PUBLIC
 )
 
 target_link_libraries(ps2_runtime PUBLIC ps2_host_backend ffmpeg ps2_iop)
+
+# paraLLEl-GS (https://github.com/Arntzen-Software/parallel-gs, LGPL-3.0+): GS emulation in Vulkan
+# compute shaders, used as the default GS renderer when available. Point PS2X_PARALLEL_GS_DIR at a
+# checkout (with the Granite, volk and vulkan-headers submodules); without it only the CPU GS is built.
+set(PS2X_PARALLEL_GS_DIR "" CACHE PATH "paraLLEl-GS source checkout (empty: CPU GS only)")
+if(PS2X_PARALLEL_GS_DIR)
+    set(PARALLEL_GS_STANDALONE ON CACHE BOOL "" FORCE)
+    add_subdirectory(${PS2X_PARALLEL_GS_DIR} ${CMAKE_CURRENT_BINARY_DIR}/parallel-gs EXCLUDE_FROM_ALL)
+    target_sources(ps2_runtime PRIVATE src/lib/gs/gs_parallel.cpp)
+    target_compile_definitions(ps2_runtime PRIVATE PS2X_HAS_PARALLEL_GS=1)
+    target_link_libraries(ps2_runtime PRIVATE parallel-gs)
+    message(STATUS "GS renderer: paraLLEl-GS from ${PS2X_PARALLEL_GS_DIR}")
+else()
+    target_sources(ps2_runtime PRIVATE src/lib/gs/gs_parallel_stub.cpp)
+    message(STATUS "GS renderer: CPU only (PS2X_PARALLEL_GS_DIR not set)")
+endif()
+
 target_link_libraries(ps2EntryRunner
     PRIVATE
     ps2_runtime
