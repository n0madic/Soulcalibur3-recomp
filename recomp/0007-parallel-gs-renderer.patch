diff --git a/ps2xTest/src/gpu_gs_test_support.h b/ps2xTest/src/gpu_gs_test_support.h
new file mode 100644
index 0000000..ae295df
--- /dev/null
+++ b/ps2xTest/src/gpu_gs_test_support.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "MiniTest.h"
+#include "runtime/gs/gs_frontend.h"
+
+#include <cstdlib>
+#include <iostream>
+#include <string>
+
+// Switches gs to the GPU renderer (paraLLEl-GS). Without a usable Vulkan device the test is skipped
+// with a note, unless PS2_TEST_REQUIRE_GPU=1 asks for it to fail instead.
+inline bool requireGpuGs(TestCase &t, GS &gs)
+{
+    std::string error;
+    if (gs.enableParallelRenderer(error))
+        return true;
+    const char *required = std::getenv("PS2_TEST_REQUIRE_GPU");
+    if (required && std::string(required) == "1")
+        t.Fail("GPU GS required (PS2_TEST_REQUIRE_GPU=1) but unavailable: " + error);
+    else
+        std::cout << "    skipped: GPU GS unavailable (" << error << ")" << std::endl;
+    return false;
+}
