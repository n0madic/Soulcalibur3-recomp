diff --git a/ps2xRuntime/include/runtime/gs/gs_parallel.h b/ps2xRuntime/include/runtime/gs/gs_parallel.h
new file mode 100644
index 0000000..bbd8e49
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_parallel.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+struct GSRegisters;
+
+// Privileged GS registers in the layout of paraLLEl-GS (and of GSdx dumps): register N of the
+// 0x12000000 block at qword 2*N of the first bank, CSR/IMR/BUSDIR/SIGLBLID at qwords 0/2/8/16 of the
+// second bank (0x12001000 block).
+static constexpr size_t kGsPrivStateQwords = 0x400u;
+void gsPackPrivRegisters(const GSRegisters &regs, uint64_t (&out)[kGsPrivStateQwords]);
+
+// The GIF packet a host->local image upload stands for: an A+D tag writing BITBLTBUF, TRXPOS, TRXREG
+// and TRXDIR, then an IMAGE tag carrying the pixels (rounded down to whole qwords).
+std::vector<uint64_t> gsBuildImageUploadPacket(uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg, uint64_t trxdir,
+                                               const uint8_t *data, uint32_t sizeBytes);
+
+// GS emulated by paraLLEl-GS (Vulkan compute). It consumes raw GIF traffic and owns the GS local
+// memory; SIGNAL/FINISH/LABEL are reported back into the privileged registers passed to create().
+// Not thread safe: the GS frontend serialises every call.
+class GSParallelRenderer
+{
+public:
+    // Returns nullptr (and the reason in error) when the runtime was built without paraLLEl-GS or no
+    // suitable Vulkan device is available.
+    static std::unique_ptr<GSParallelRenderer> create(GSRegisters &privRegs, std::string &error);
+
+    virtual ~GSParallelRenderer() = default;
+
+    virtual void transfer(uint32_t path, const uint8_t *data, uint32_t sizeBytes) = 0;
+    virtual void writeRegister(uint8_t regAddr, uint64_t value) = 0;
+    // Reads the data of a local->host transfer (TRXDIR=1); returns the bytes written (whole qwords).
+    virtual uint32_t readLocalToHost(uint8_t *dst, uint32_t maxBytes) = 0;
+
+    // Scans the display circuits out for this vsync and starts reading the picture back to the host.
+    virtual void vsync(uint32_t field) = 0;
+    // The most recent picture read back (RGBA8, tightly packed); false before the first one.
+    virtual bool copyLatestFrame(std::vector<uint8_t> &rgba, uint32_t &width, uint32_t &height) = 0;
+    // Waits for all submitted GPU work, publishing the pending picture.
+    virtual void finish() = 0;
+};
