+    // Fake host input for PSPadBackend: one gamepad holding Circle, keyboard holding Enter and Up.
+    bool fakeKeyDown(int key)
+    {
+        return key == KEY_ENTER || key == KEY_UP;
+    }
+
+    bool fakeGamepadAvailable(int gamepad)
+    {
+        return gamepad == 0;
+    }
+
+    bool fakeGamepadButtonDown(int /*gamepad*/, int button)
+    {
+        return button == GAMEPAD_BUTTON_RIGHT_FACE_RIGHT;
+    }
+
+    float fakeGamepadAxis(int /*gamepad*/, int /*axis*/)
+    {
+        return 0.0f;
+    }
+
+    bool fakeEscapeDown(int key)
+    {
+        return key == KEY_ESCAPE;
+    }
+
+    int heldKey = -1;
+    int connectedPads = 3;
+    bool routedKey(int key) { return key == heldKey; }
+    bool routedAvailable(int pad) { return (connectedPads & (1 << pad)) != 0; }
+    bool routedButton(int pad, int button)
+    {
+        return button == (pad == 0 ? GAMEPAD_BUTTON_RIGHT_FACE_DOWN : GAMEPAD_BUTTON_RIGHT_FACE_RIGHT);
+    }
+    float routedAxis(int pad, int axis)
+    {
+        const float sign = pad == 0 ? 1.0f : -1.0f;
+        if (axis == GAMEPAD_AXIS_LEFT_X) return -sign;
+        if (axis == GAMEPAD_AXIS_LEFT_Y) return sign * 0.5f;
+        if (axis == GAMEPAD_AXIS_RIGHT_X) return -sign * 0.5f;
+        if (axis == GAMEPAD_AXIS_RIGHT_Y) return sign;
+        return 0.0f;
+    }
+
+    bool fakeNoGamepad(int /*gamepad*/)
+    {
+        return false;
+    }
+
+    float wildAxis(int /*pad*/, int axis)
+    {
+        if (axis == GAMEPAD_AXIS_LEFT_X) return 3.0f;
+        if (axis == GAMEPAD_AXIS_LEFT_Y) return -5.0f;
+        if (axis == GAMEPAD_AXIS_RIGHT_X) return std::numeric_limits<float>::quiet_NaN();
+        return 0.0f;
+    }
