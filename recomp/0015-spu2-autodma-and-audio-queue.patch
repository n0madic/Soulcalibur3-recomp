+            0x24040024u, // addiu a0, zero, 0x24
+            0x24050001u, // addiu a1, zero, 1
+            0x3C060001u, 0x34C60000u | handlerOffset, // a2 = handler
+            0x3C070001u, 0x34E70400u,                 // a3 = 0x10400
+            jal(registerStub), 0x00000000u,
+            0x24040028u, // addiu a0, zero, 0x28
+            0x24050001u,
+            0x3C060001u, 0x34C60000u | handlerOffset,
+            0x3C070001u, 0x34E70404u,                 // a3 = 0x10404
+            jal(registerStub), 0x00000000u,
+            0x24040024u, jal(enableStub), 0x00000000u,
+            0x24040028u, jal(enableStub), 0x00000000u,
+            0x3C081F90u, // lui   t0, 0x1f90 (SPU2)
+            0x24090001u, 0xA50901B0u, // core 0 ADMAS = 1
+            0x24090002u, 0xA50905B0u, // core 1 ADMAS = 2
+            0x3C081F80u, // lui   t0, 0x1f80 (DMA)
+            0x3C090001u, 0x35291000u, 0xAD0910C0u, // ch4 MADR = 0x11000
