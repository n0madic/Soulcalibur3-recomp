+    // Starts AutoDMA on SPU2 core 0, spins for about 100 samples, starts it on core 1 and returns. Both
+    // channels' completion interrupts (0x24, 0x28) count into 0x10400/0x10404.
+    void writeTwoCoreAutoDmaIrx(TestHost &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+        constexpr uint32_t handlerOffset = 0x100u;
+        constexpr uint32_t importTableOffset = 0x140u;
+        constexpr uint32_t registerStub = loadAddress + importTableOffset + 20u;
+        constexpr uint32_t enableStub = registerStub + 8u;
+        auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); };
