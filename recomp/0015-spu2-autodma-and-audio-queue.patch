diff --git a/ps2xRuntime/src/lib/ps2_pcm_queue.cpp b/ps2xRuntime/src/lib/ps2_pcm_queue.cpp
new file mode 100644
index 0000000..a0750ac
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_pcm_queue.cpp
@@ -0,0 +1,105 @@
+#include "runtime/ps2_pcm_queue.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+void PcmQueue::push(const int16_t *samples, size_t frames)
+{
+    for (size_t i = 0; i < frames; ++i)
+    {
+        if (m_queuedFrames >= kCapacityFrames)
+        {
+            drop(1u);
+            m_readPhase = 0.0;
+        }
+        const size_t index = ((m_readFrame + m_queuedFrames) % kCapacityFrames) * 2u;
+        m_ring[index] = samples[i * 2u];
+        m_ring[index + 1u] = samples[i * 2u + 1u];
+        ++m_queuedFrames;
+    }
+}
+
+size_t PcmQueue::pull(int16_t *out, size_t frames)
+{
+    // Wait for a little backlog before starting so the first underrun isn't immediate.
+    if (!m_primed && m_queuedFrames < kPrimeFrames)
+    {
+        std::memset(out, 0, frames * 4u);
+        return 0u;
+    }
+    m_primed = true;
+
+    if (m_queuedFrames > kTrimAboveFrames)
+    {
+        drop(m_queuedFrames - kTargetQueuedFrames);
+        m_readPhase = 0.0;
+    }
+
+    // Correct the clock drift continuously, by at most 2%.
+    const double error = (static_cast<double>(m_queuedFrames) - kTargetQueuedFrames) /
+                         static_cast<double>(kTargetQueuedFrames);
+    const double targetStep = std::clamp(1.0 + error * 0.04, 0.98, 1.02);
+    const double smoothing = std::min(1.0, static_cast<double>(frames) / (kSampleRate * 0.25));
+    m_playbackStep += (targetStep - m_playbackStep) * smoothing;
+
+    size_t written = 0u;
+    double position = m_readPhase;
+    for (; written < frames; ++written)
+    {
+        const size_t frame = static_cast<size_t>(position);
+        if (frame >= m_queuedFrames)
+            break;
+        const double fraction = position - static_cast<double>(frame);
+        for (size_t channel = 0u; channel < 2u; ++channel)
+        {
+            const int32_t y0 = frame == 0u ? m_previous[channel] : sampleAt(frame - 1u, channel);
+            out[written * 2u + channel] = interpolate(y0,
+                                                      sampleAt(frame, channel),
+                                                      sampleAt(frame + 1u, channel),
+                                                      sampleAt(frame + 2u, channel),
+                                                      fraction);
+        }
+        position += m_playbackStep;
+    }
+
+    const size_t consumed = std::min(static_cast<size_t>(position), m_queuedFrames);
+    drop(consumed);
+    // A position past the queued audio stays within the next frame: frames not produced yet are
+    // not skipped.
+    m_readPhase = std::min(position - static_cast<double>(consumed), std::nextafter(1.0, 0.0));
+    if (written < frames)
+    {
+        std::memset(out + written * 2u, 0, (frames - written) * 4u);
+        m_primed = false;
+        m_readPhase = 0.0;
+    }
+    return written;
+}
+
+int16_t PcmQueue::interpolate(int32_t y0, int32_t y1, int32_t y2, int32_t y3, double t) noexcept
+{
+    const double a = -0.5 * y0 + 1.5 * y1 - 1.5 * y2 + 0.5 * y3;
+    const double b = y0 - 2.5 * y1 + 2.0 * y2 - 0.5 * y3;
+    const double c = -0.5 * y0 + 0.5 * y2;
+    const double value = ((a * t + b) * t + c) * t + y1;
+    return static_cast<int16_t>(std::clamp(std::lround(value), -32768L, 32767L));
+}
+
+int32_t PcmQueue::sampleAt(size_t frame, size_t channel) const noexcept
+{
+    // Past the queued audio the last frame repeats.
+    const size_t clamped = std::min(frame, m_queuedFrames - 1u);
+    return m_ring[((m_readFrame + clamped) % kCapacityFrames) * 2u + channel];
+}
+
+void PcmQueue::drop(size_t frames) noexcept
+{
+    if (frames == 0u)
+        return;
+    const size_t last = ((m_readFrame + frames - 1u) % kCapacityFrames) * 2u;
+    m_previous[0] = m_ring[last];
+    m_previous[1] = m_ring[last + 1u];
+    m_readFrame = (m_readFrame + frames) % kCapacityFrames;
+    m_queuedFrames -= frames;
+}
