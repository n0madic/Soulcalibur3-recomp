@@ -130,13 +130,16 @@ int main()
         const std::vector<uint8_t> data = inputBlocks(2);
         spu.dmaWrite(0, data.data(), static_cast<uint32_t>(data.size()));
         if (!expect(!spu.takeAutoDmaDone(0), "an AutoDMA transfer should not end before it plays")) return 1;
+        if (!expect(spu.samplesUntilAutoDmaDone() == 256u, "a two-block transfer should end after 256 samples")) return 1;
 
         std::vector<int16_t> out = play(spu, 255u);
         if (!expect(out[0] > 0x0C00 && out[1] < -0x600, "the input should play left and right from their halves of the block")) return 1;
         if (!expect(!spu.takeAutoDmaDone(0), "the transfer should not end while its first block plays")) return 1;
 
+        if (!expect(spu.samplesUntilAutoDmaDone() == 1u, "one sample should be left before the transfer ends")) return 1;
         play(spu, 1u);
         if (!expect(spu.takeAutoDmaDone(0), "the transfer should end once its last block is next")) return 1;
+        if (!expect(spu.samplesUntilAutoDmaDone() == IopSpu2::kNoAutoDmaEvent, "no transfer should be pending after it ended")) return 1;
         if (!expect(!spu.takeAutoDmaDone(0), "the end of a transfer should be reported once")) return 1;
 
         const std::vector<uint8_t> next = inputBlocks(1, 2);
