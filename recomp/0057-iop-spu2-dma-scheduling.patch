From fcc4c1c2d4cfb6ad50fd67078ae45da6de754f30 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sat, 24 Oct 2026 10:10:33 +0300
Subject: [PATCH] IOP: deliver SPU2 AutoDMA completions at their sample

The SPU2 only ran between scheduler slices and in idle steps that ignored its state, so an AutoDMA completion (the interrupt that makes CRI's driver queue the next block) could come long after the transfer was taken in; in a manual intro capture core 1 played 65947 empty input samples in 36 s.

- IopSpu2::samplesUntilAutoDmaDone() says how many samples are left before either core takes its queued transfer in.
- advanceSpu generates up to that sample and stops there, so the interrupt is queued at its own time and delivered before more samples play.
- The SPU2 also runs while IOP code executes (long imports and RPC callbacks), in batches of 32 samples or up to the next completion.
- Idle steps end at the next completion (at most 256 samples), counted from the SPU2's state rather than from the last poll: with two cores out of phase, fixed 256-sample steps delivered one core's completion up to 255 samples late.

Tests: the predictor counts down to the sample that ends a transfer; a synthetic IRX starts core 0's AutoDMA, spins for about 100 samples and starts core 1's, and one long idle run must deliver core 0's interrupt within 8 samples of its transfer being taken in (fails before this change, also with fixed 256-sample steps).
---
 ps2xIOP/src/emulator/core/iop_spu2.cpp |  17 ++++
 ps2xIOP/src/emulator/core/iop_spu2.h   |   4 +
 ps2xIOP/src/emulator/iop_emulator.cpp  |  50 +++++++----
 ps2xIOP/tests/iop_emulator_tests.cpp   | 120 +++++++++++++++++++++++++
 ps2xIOP/tests/iop_spu2_tests.cpp       |   3 +
 5 files changed, 179 insertions(+), 15 deletions(-)

diff --git a/ps2xIOP/src/emulator/core/iop_spu2.cpp b/ps2xIOP/src/emulator/core/iop_spu2.cpp
index 0a32ba3..e4add27 100644
--- a/ps2xIOP/src/emulator/core/iop_spu2.cpp
+++ b/ps2xIOP/src/emulator/core/iop_spu2.cpp
@@ -162,6 +162,23 @@ namespace ps2x::iop::detail
         return done;
     }
 
+    uint32_t IopSpu2::samplesUntilAutoDmaDone() const noexcept
+    {
+        uint32_t samples = kNoAutoDmaEvent;
+        for (const Core &core : m_cores)
+        {
+            if (!core.inputTransferPending)
+                continue;
+            // readInput ends the transfer once no more than one block is left.
+            const size_t blocks = core.input.size() / kInputBlockHalfwords;
+            const uint32_t until = blocks <= 1u
+                                       ? 1u
+                                       : static_cast<uint32_t>((blocks - 1u) * kInputBlockSamples - core.inputSample);
+            samples = std::min(samples, until);
+        }
+        return samples;
+    }
+
     // Plays the sound data input one sample at a time. A transfer counts as taken in once its
     // last block has started playing; the next one queues behind it, so playback is gapless.
     void IopSpu2::readInput(Core &core, int32_t &left, int32_t &right)
diff --git a/ps2xIOP/src/emulator/core/iop_spu2.h b/ps2xIOP/src/emulator/core/iop_spu2.h
index af47695..4f8ad04 100644
--- a/ps2xIOP/src/emulator/core/iop_spu2.h
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -41,6 +41,10 @@ namespace ps2x::iop::detail
         // True once after the last block of the AutoDMA transfer queued on `core` has started
         // playing: the hardware has taken the transfer in and ends the DMA.
         [[nodiscard]] bool takeAutoDmaDone(int core) noexcept;
+        // Samples until the next AutoDMA transfer on either core is taken in (at least 1), or
+        // kNoAutoDmaEvent when no transfer is queued.
+        static constexpr uint32_t kNoAutoDmaEvent = 0xFFFFFFFFu;
+        [[nodiscard]] uint32_t samplesUntilAutoDmaDone() const noexcept;
 
     private:
         enum class Phase : uint8_t
diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index d448acd..2ab44c0 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -41,6 +41,9 @@ namespace ps2x::iop::detail
         constexpr uint32_t kCallStackCapacity = (kCallStackLimit - kCallStackBase) / kCallStackSize;
         constexpr uint64_t kCdvdCompletionCycles = 128u;
         constexpr int kSpu2Irq = 9;
+        // While IOP code runs, the SPU2 catches up in batches of this many samples (or sooner for an
+        // AutoDMA completion) instead of one host audio call per sample.
+        constexpr uint32_t kSpuBatchFrames = 32u;
 
         uint32_t physicalAddress(uint32_t address)
         {
@@ -413,6 +416,10 @@ namespace ps2x::iop::detail
             {
                 if (!step(cpu))
                     break;
+                // Imports and RPC callbacks can execute far beyond a scheduler slice.
+                // Keep SPU2/DMA running while their IOP instructions execute as well.
+                if (totalCycles >= spuDueCycle(kSpuBatchFrames) && advanceSpu())
+                    idleUntil = 0u;
                 if (!servicingDmaInterrupts && !pendingDmaInterrupts.empty())
                     servicePendingDmaInterrupts();
                 if (!servicingGuestCallbacks && !pendingGuestCallbacks.empty())
@@ -563,33 +570,43 @@ namespace ps2x::iop::detail
         // Runs the SPU2 up to the current IOP time, hands its output to the host and raises the
         // SPU2 interrupt when an IRQA address was hit, or the DMA interrupt when an AutoDMA
         // transfer was taken in. Returns whether it raised one.
+        // The cycle by which the SPU2 must have run: at most `maxFrames` samples ahead, and no later than
+        // the next AutoDMA completion, which wakes the driver that refills the input.
+        uint64_t spuDueCycle(uint32_t maxFrames)
+        {
+            const uint32_t frames = std::min(maxFrames, memory.spu2().samplesUntilAutoDmaDone());
+            return spuCycle + static_cast<uint64_t>(std::max(frames, 1u)) * IopSpu2::IopCyclesPerSample;
+        }
+
+        // Runs the SPU2 up to totalCycles, stopping at the first sample that raises an interrupt so it is
+        // delivered at that sample's time; the next call goes on from there.
         bool advanceSpu()
         {
             constexpr uint64_t kCyclesPerSample = IopSpu2::IopCyclesPerSample;
             constexpr uint32_t kChunkFrames = 256u;
             IopSpu2 &spu = memory.spu2();
             bool raised = false;
-            while (spuCycle + kCyclesPerSample <= totalCycles)
+            while (!raised && spuCycle + kCyclesPerSample <= totalCycles)
             {
-                const uint32_t frames = static_cast<uint32_t>(
-                    std::min<uint64_t>((totalCycles - spuCycle) / kCyclesPerSample, kChunkFrames));
+                const uint32_t frames = static_cast<uint32_t>(std::min<uint64_t>(
+                    (totalCycles - spuCycle) / kCyclesPerSample,
+                    std::min(kChunkFrames, std::max(spu.samplesUntilAutoDmaDone(), 1u))));
                 spuBuffer.resize(static_cast<size_t>(frames) * 2u);
                 spu.generate(spuBuffer.data(), frames);
                 spuCycle += frames * kCyclesPerSample;
                 host.audioOutput(spuBuffer.data(), frames);
                 if (spu.takeIrq())
+                {
+                    pendingDmaInterrupts[kSpu2Irq] = spuCycle;
                     raised = true;
-            }
-            if (spu.takeIrq())
-                raised = true;
-            if (raised)
-                pendingDmaInterrupts[kSpu2Irq] = totalCycles;
-            for (int core = 0; core < 2; ++core)
-            {
-                if (!spu.takeAutoDmaDone(core))
-                    continue;
-                pendingDmaInterrupts[IopMemory::spu2DmaIrq(core)] = totalCycles;
-                raised = true;
+                }
+                for (int core = 0; core < 2; ++core)
+                {
+                    if (!spu.takeAutoDmaDone(core))
+                        continue;
+                    pendingDmaInterrupts[IopMemory::spu2DmaIrq(core)] = spuCycle;
+                    raised = true;
+                }
             }
             return raised;
         }
@@ -609,7 +626,7 @@ namespace ps2x::iop::detail
                     // one IOP cycle per guest call, so skip the thread scans.
                     if (totalCycles < idleUntil)
                     {
-                        totalCycles = std::min(target, idleUntil);
+                        totalCycles = std::min({target, idleUntil, spuDueCycle(256u)});
                         continue;
                     }
                     servicePendingDmaInterrupts();
@@ -624,6 +641,9 @@ namespace ps2x::iop::detail
                         if (!pendingGuestCallbacks.empty())
                             nextWake = std::min(nextWake, pendingGuestCallbacks.begin()->first);
                         nextWake = timrman.nextEventCycle(nextWake);
+                        // AutoDMA completion can wake the driver even with no IOP
+                        // thread, timer or queued interrupt currently runnable.
+                        nextWake = std::min(nextWake, spuDueCycle(256u));
                         idleUntil = nextWake;
                         totalCycles = std::max(totalCycles + 1u, std::min(target, nextWake));
                         continue;
diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index b1f00db..b28b1a3 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -975,6 +975,108 @@ namespace
         std::memcpy(host.guest.data() + address + codeOffset + importTableOffset, importTable, sizeof(importTable));
     }
 
+    // Starts AutoDMA on SPU2 core 0, spins for about 100 samples, starts it on core 1 and returns. Both
+    // channels' completion interrupts (0x24, 0x28) count into 0x10400/0x10404.
+    void writeTwoCoreAutoDmaIrx(TestHost &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+        constexpr uint32_t handlerOffset = 0x100u;
+        constexpr uint32_t importTableOffset = 0x140u;
+        constexpr uint32_t registerStub = loadAddress + importTableOffset + 20u;
+        constexpr uint32_t enableStub = registerStub + 8u;
+        auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); };
+
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu;
+        header.ident[1] = 'E';
+        header.ident[2] = 'L';
+        header.ident[3] = 'F';
+        header.ident[4] = 1u;
+        header.ident[5] = 1u;
+        header.ident[6] = 1u;
+        header.type = 2u;
+        header.machine = 8u;
+        header.version = 1u;
+        header.entry = loadAddress;
+        header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader);
+        header.phentsize = sizeof(ProgramHeader);
+        header.phnum = 1u;
+
+        const uint32_t code[] = {
+            0x27BDFFE0u, // addiu sp, sp, -0x20
+            0xAFBF001Cu, // sw    ra, 0x1c(sp)
+            0x24040024u, // addiu a0, zero, 0x24
+            0x24050001u, // addiu a1, zero, 1
+            0x3C060001u, 0x34C60000u | handlerOffset, // a2 = handler
+            0x3C070001u, 0x34E70400u,                 // a3 = 0x10400
+            jal(registerStub), 0x00000000u,
+            0x24040028u, // addiu a0, zero, 0x28
+            0x24050001u,
+            0x3C060001u, 0x34C60000u | handlerOffset,
+            0x3C070001u, 0x34E70404u,                 // a3 = 0x10404
+            jal(registerStub), 0x00000000u,
+            0x24040024u, jal(enableStub), 0x00000000u,
+            0x24040028u, jal(enableStub), 0x00000000u,
+            0x3C081F90u, // lui   t0, 0x1f90 (SPU2)
+            0x24090001u, 0xA50901B0u, // core 0 ADMAS = 1
+            0x24090002u, 0xA50905B0u, // core 1 ADMAS = 2
+            0x3C081F80u, // lui   t0, 0x1f80 (DMA)
+            0x3C090001u, 0x35291000u, 0xAD0910C0u, // ch4 MADR = 0x11000
+            0x3C090020u, 0x35290010u, 0xAD0910C4u, // ch4 BCR = 32 blocks of 16 words (two SPU2 blocks)
+            0x3C090100u, 0x35290201u, 0xAD0910C8u, // ch4 CHCR: start, to SPU2
+            0x240A6400u, // addiu t2, zero, 25600 (three instructions each: about 100 samples)
+            0x254AFFFFu, // addiu t2, t2, -1
+            0x1540FFFEu, // bne   t2, zero, -2
+            0x00000000u,
+            0x3C090001u, 0x35291000u, 0xAD091500u, // ch7 MADR
+            0x3C090020u, 0x35290010u, 0xAD091504u, // ch7 BCR
+            0x3C090100u, 0x35290201u, 0xAD091508u, // ch7 CHCR
+            0x8FBF001Cu, // lw    ra, 0x1c(sp)
+            0x00001021u, // addu  v0, zero, zero
+            0x27BD0020u, // addiu sp, sp, 0x20
+            0x03E00008u, // jr    ra
+            0x00000000u,
+        };
+        static_assert(sizeof(code) <= handlerOffset);
+        const uint32_t handler[] = {
+            0x8C880000u, // lw    t0, 0(a0)
+            0x25080001u, // addiu t0, t0, 1
+            0xAC880000u, // sw    t0, 0(a0)
+            0x03E00008u, // jr    ra
+            0x24020001u, // addiu v0, zero, 1
+        };
+        const uint32_t importTable[] = {
+            0x41E00000u,
+            0x00000000u,
+            0x00000101u,
+            0x72746E69u, // "intr"
+            0x006E616Du, // "man"
+            0x03E00008u, 0x24000004u, // RegisterIntrHandler
+            0x03E00008u, 0x24000006u, // EnableIntr
+            0x00000000u,
+            0x00000000u,
+        };
+
+        ProgramHeader program{};
+        program.type = 1u;
+        program.offset = codeOffset;
+        program.vaddr = loadAddress;
+        program.paddr = loadAddress;
+        program.filesz = importTableOffset + sizeof(importTable);
+        program.memsz = 0x1800u;
+        program.flags = 7u;
+        program.align = 4u;
+
+        std::fill(host.guest.begin() + address, host.guest.end(), 0u);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + codeOffset, code, sizeof(code));
+        std::memcpy(host.guest.data() + address + codeOffset + handlerOffset, handler, sizeof(handler));
+        std::memcpy(host.guest.data() + address + codeOffset + importTableOffset, importTable, sizeof(importTable));
+    }
+
     uint32_t readIop32(const IopSubsystem &iop, uint32_t address)
     {
         uint32_t value = 0u;
@@ -1319,5 +1421,23 @@ int main()
     if (!expect(iop.readMemory(readIop32(iop, 0x10214u) + '0', &digitZero, 1u) && digitZero == 0x04u,
                 "the ctype table should be rebuilt after an IOP reset")) return 1;
 
+    // An AutoDMA completion interrupt comes at the sample that takes the transfer in, also while the IOP
+    // idles across a long span and the two cores' transfers are out of phase. Fixed 256-sample idle steps
+    // counted from the later start delivered core 0's about 100 samples late.
+    iop.reset();
+    const uint64_t beforeAutoDma = iop.debugSnapshot().emulatorCycles;
+    writeTwoCoreAutoDmaIrx(host, 0x100u);
+    const ModuleLoadResult autoDmaModule = iop.loadModuleBuffer(0x100u);
+    if (!expect(autoDmaModule.handled && autoDmaModule.startResult == 0, "AutoDMA IRX did not start")) return 1;
+    constexpr uint64_t kCyclesPerSample = 768u;
+    const uint64_t coreZeroDue = beforeAutoDma + (256u + 8u) * kCyclesPerSample;
+    const uint64_t afterLoad = iop.debugSnapshot().emulatorCycles;
+    if (!expect(afterLoad < coreZeroDue, "the IRX should return before core 0's transfer is taken in")) return 1;
+    iop.runEeCycles((coreZeroDue - afterLoad) * 8u);
+    if (!expect(readIop32(iop, 0x10400u) == 1u, "core 0's AutoDMA interrupt should come when its transfer is taken in")) return 1;
+    if (!expect(readIop32(iop, 0x10404u) == 0u, "core 1's transfer, started later, should still be running")) return 1;
+    iop.runEeCycles(120u * kCyclesPerSample * 8u);
+    if (!expect(readIop32(iop, 0x10404u) == 1u, "core 1's AutoDMA interrupt should follow about 100 samples later")) return 1;
+
     return 0;
 }
diff --git a/ps2xIOP/tests/iop_spu2_tests.cpp b/ps2xIOP/tests/iop_spu2_tests.cpp
index 0a0174c..319620d 100644
