From 412c5470f1f854278d6e7335d62a23cd3857b37e Mon Sep 17 00:00:00 2001
From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Fri, 23 Oct 2026 03:14:12 +0300
Subject: [PATCH] Raise the GS interrupt for every new event, not per line edge

Soulcalibur III draws a frame as VIF1 and GIF chains that its GS interrupt
handler resumes on each SIGNAL. From the last SIGNAL it kicks the final GIF
packet, which ends with FINISH, and only the FINISH interrupt marks the
frame as drawn. The runtime runs that packet before the handler returns, so
FINISH was raised while the SIGNAL was still pending: the combined line was
already high, no interrupt followed, and the handler's acknowledgement of
every CSR bit it read cleared FINISH. The main loop then waited for its
GS timeout of four fields on every frame and reset the GS.

The INTC latches each GS event raised unmasked, so track the reported
events per bit. A CSR write forgets the acknowledged ones before a queued
SIGNAL is applied, so that SIGNAL is reported as well.
---
 ps2xRuntime/include/runtime/ps2_memory.h |  8 +++---
 ps2xRuntime/src/lib/ps2_memory.cpp       | 28 ++++++++++++++-------
 ps2xTest/src/ps2_gs_tests.cpp            | 32 ++++++++++++++++++++++++
 3 files changed, 56 insertions(+), 12 deletions(-)

diff --git a/ps2xRuntime/include/runtime/ps2_memory.h b/ps2xRuntime/include/runtime/ps2_memory.h
index bca6aea..2bf827c 100644
--- a/ps2xRuntime/include/runtime/ps2_memory.h
+++ b/ps2xRuntime/include/runtime/ps2_memory.h
@@ -374,8 +374,8 @@ public:
     {
         return m_completedDmacPending.load(std::memory_order_acquire);
     }
-    // Returns true once per rising edge of the GS interrupt line (INTC cause 0):
-    // a CSR event bit (SIGNAL, FINISH, HSINT, VSINT, EDWINT) not masked by IMR.
+    // Returns true when a CSR event bit (SIGNAL, FINISH, HSINT, VSINT, EDWINT) not
+    // masked by IMR has been raised since the last call (INTC cause 0).
     bool pollGsInterruptEdge();
 
     int pollDmaRegisters();
@@ -457,7 +457,9 @@ public:
     std::mutex m_completedDmacMutex;
     std::vector<uint32_t> m_completedDmacCauses;
     std::atomic<bool> m_completedDmacPending{false};
-    bool m_gsInterruptLine = false;
+    uint64_t m_gsInterruptEvents = 0u; // unmasked CSR events already reported
+    // After a CSR write: drops the acknowledged events and applies a queued SIGNAL.
+    void acknowledgeGsEvents();
 
     struct CodeRegion
     {
diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index 6379a73..58c3547 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -380,7 +380,7 @@ bool PS2Memory::initialize(size_t ramSize)
         // a guaranteed-valid atomic store; make the zero-initialization explicit.
         gs_regs.csr.store(0);
         gs_regs.imr = 0x7F00u; // every GS interrupt source masked, as after a hardware reset
-        m_gsInterruptLine = false;
+        m_gsInterruptEvents = 0u;
         gs_regs.dispfb1 = (0ULL << 0) | (10ULL << 9) | (0ULL << 15) | (0ULL << 32) | (0ULL << 43);
         gs_regs.display1 = (0ULL << 0) | (0ULL << 12) | (0ULL << 23) | (0ULL << 27) | (639ULL << 32) | (447ULL << 44);
         gs_regs.dispfb2 = gs_regs.dispfb1;
@@ -1011,7 +1011,7 @@ void PS2Memory::write32(uint32_t address, uint32_t value)
             // CSR: bits 0..1 of the low dword are write-one-to-clear status bits.
             // Done as a single atomic RMW -- see writeCsrHalf's comment.
             writeCsrHalf(gs_regs.csr, off, value);
-            gsApplyQueuedSignal(gs_regs);
+            acknowledgeGsEvents();
         }
         else if (uint64_t *reg = gsRegPtr(gs_regs, address))
         {
@@ -1071,7 +1071,7 @@ void PS2Memory::write64(uint32_t address, uint64_t value)
             // CSR: bits 0..1 are write-one-to-clear status bits. Done as a single
             // atomic RMW -- see writeCsrFull's comment.
             writeCsrFull(gs_regs.csr, value);
-            gsApplyQueuedSignal(gs_regs);
+            acknowledgeGsEvents();
         }
         else if (uint64_t *reg = gsRegPtr(gs_regs, address))
         {
@@ -1225,7 +1225,7 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
         if (regOff == kGsCsrRegOffset)
         {
             writeCsrHalf(gs_regs.csr, off, value);
-            gsApplyQueuedSignal(gs_regs);
+            acknowledgeGsEvents();
         }
         else if (uint64_t *reg = gsRegPtr(gs_regs, address))
         {
@@ -1984,11 +1984,21 @@ bool PS2Memory::pollGsInterruptEdge()
 {
     // CSR bits 0..4 are the event flags; IMR bits 8..12 mask the same sources.
     constexpr uint64_t kCsrEventMask = 0x1Fu;
-    const uint64_t events = gs_regs.csr.load(std::memory_order_acquire) & kCsrEventMask;
-    const bool line = (events & ~(gs_regs.imr >> 8u)) != 0u;
-    const bool risingEdge = line && !m_gsInterruptLine;
-    m_gsInterruptLine = line;
-    return risingEdge;
+    // The INTC latches every GS event that is raised unmasked, also while another
+    // one is still pending in CSR: FINISH from the last packet of a frame arrives
+    // before the handler has acknowledged the SIGNAL that kicked that packet.
+    const uint64_t events = gs_regs.csr.load(std::memory_order_acquire) & kCsrEventMask & ~(gs_regs.imr >> 8u);
+    const bool raised = (events & ~m_gsInterruptEvents) != 0u;
+    m_gsInterruptEvents = events;
+    return raised;
+}
+
+void PS2Memory::acknowledgeGsEvents()
+{
+    // Forget the acknowledged events first, so that a queued SIGNAL applied by the
+    // same write counts as a new event.
+    m_gsInterruptEvents &= gs_regs.csr.load(std::memory_order_acquire);
+    gsApplyQueuedSignal(gs_regs);
 }
 
 void PS2Memory::flushMaskedPath3Packets(bool drainImmediately)
diff --git a/ps2xTest/src/ps2_gs_tests.cpp b/ps2xTest/src/ps2_gs_tests.cpp
index 373577c..65a840a 100644
--- a/ps2xTest/src/ps2_gs_tests.cpp
+++ b/ps2xTest/src/ps2_gs_tests.cpp
@@ -526,6 +526,38 @@ void register_ps2_gs_tests()
             t.Equals(mem.read64(kGsCsr) & 0x1ull, 0x0ull, "with the queue drained CSR.SIGNAL should stay clear");
         });
 
+        tc.Run("every GS event raises the interrupt, also while another one is pending", [](TestCase &t)
+        {
+            // Soulcalibur III kicks the last packet of a frame from its SIGNAL handler.
+            // The packet's FINISH arrives before the handler acknowledges that SIGNAL,
+            // and the handler writes back every CSR bit it sees, FINISH included.
+            // The frame counts as drawn only when the FINISH interrupt is delivered.
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            GS gs;
+            gs.init(mem.getGSVRAM(), PS2_GS_VRAM_SIZE, &mem.gs());
+
+            constexpr uint32_t kGsCsr = 0x12001000u;
+            constexpr uint32_t kGsImr = 0x12001010u;
+            mem.write64(kGsImr, 0x7C00u); // SIGNAL and FINISH unmasked
+
+            gs.writeRegister(GS_REG_SIGNAL, 0x0000000100000001ull);
+            t.IsTrue(mem.pollGsInterruptEdge(), "SIGNAL should raise the GS interrupt");
+            gs.writeRegister(GS_REG_FINISH, 0u);
+            t.IsTrue(mem.pollGsInterruptEdge(), "FINISH should raise the GS interrupt while SIGNAL is pending");
+            t.IsFalse(mem.pollGsInterruptEdge(), "each event should interrupt once");
+            mem.write64(kGsCsr, 0x3u);
+            t.IsFalse(mem.pollGsInterruptEdge(), "acknowledging both events should raise nothing");
+
+            // A SIGNAL that waited for the acknowledgement is a new event as well.
+            gs.writeRegister(GS_REG_SIGNAL, 0x0000000100000001ull);
+            gs.writeRegister(GS_REG_SIGNAL, 0x0000000200000002ull);
+            t.IsTrue(mem.pollGsInterruptEdge(), "the first SIGNAL should raise the GS interrupt");
+            mem.write64(kGsCsr, 0x1u);
+            t.Equals(mem.read64(kGsCsr) & 0x1ull, 0x1ull, "the queued SIGNAL should be applied by the acknowledgement");
+            t.IsTrue(mem.pollGsInterruptEdge(), "the queued SIGNAL should raise the GS interrupt again");
+        });
+
         tc.Run("unknown GS privileged offsets are no-op and read as zero", [](TestCase &t)
         {
             PS2Memory mem;
