+    // Plays the sound data input one sample at a time. A transfer counts as taken in once its
+    // last block has started playing; the next one queues behind it, so playback is gapless.
+    void IopSpu2::readInput(Core &core, int32_t &left, int32_t &right)
+    {
+        left = 0;
+        right = 0;
+        if (core.input.size() >= kInputBlockHalfwords)
+        {
+            left = core.input[core.inputSample];
+            right = core.input[kInputBlockSamples + core.inputSample];
+            if (++core.inputSample == kInputBlockSamples)
+            {
+                core.inputSample = 0u;
+                core.input.erase(core.input.begin(), core.input.begin() + kInputBlockHalfwords);
+            }
+        }
+        if (core.input.size() <= kInputBlockHalfwords && core.inputTransferPending)
+        {
+            core.inputTransferPending = false;
+            core.inputTransferDone = true;
+        }
+        // A partial block left by a transfer that was not a whole number of blocks never plays.
+        if (core.input.size() < kInputBlockHalfwords && core.inputSample == 0u)
+            core.input.clear();
+    }
