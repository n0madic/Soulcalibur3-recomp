+
+    // AutoDMA blocks of 256 left samples followed by 256 right ones; block b holds
+    // left = 0x1000 * (b + 1) and right = -0x800 * (b + 1).
+    std::vector<uint8_t> inputBlocks(int count, int first = 0)
+    {
+        std::vector<int16_t> samples;
+        for (int b = first; b < first + count; ++b)
+        {
+            samples.insert(samples.end(), 256u, static_cast<int16_t>(0x1000 * (b + 1)));
+            samples.insert(samples.end(), 256u, static_cast<int16_t>(-0x800 * (b + 1)));
+        }
+        std::vector<uint8_t> bytes(samples.size() * 2u);
+        std::memcpy(bytes.data(), samples.data(), bytes.size());
+        return bytes;
+    }
+
+    // Core 0 streams its sound data input to its dry output; core 1 mixes core 0 in.
+    void setUpInput(IopSpu2 &spu)
+    {
+        spu.write16(0x198u, 0x00C0u);          // core 0 MMIX: sound data input to dry
+        spu.write16(0x400u + 0x198u, 0x000Cu); // core 1 MMIX: external input (core 0) to dry
+        spu.write16(0x1B0u, 0x0001u);          // core 0 ADMAS
+    }
+
+    std::vector<int16_t> play(IopSpu2 &spu, uint32_t frames)
+    {
+        std::vector<int16_t> out(frames * 2u);
+        spu.generate(out.data(), frames);
+        return out;
+    }
 }
 
