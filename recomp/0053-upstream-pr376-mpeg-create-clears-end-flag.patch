From dcbf8e4b2fbe8c7b2e2c9ab36928dd1310d5aad9 Mon Sep 17 00:00:00 2001
From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Fri, 23 Oct 2026 18:10:59 +0300
Subject: [PATCH] sceMpegCreate: clear the end-of-stream word that sceMpegIsEnd
 reads

Upstream PR ran-j/PS2Recomp#376. libmpeg's sceMpegIsEnd returns the first
word of mp->sys, and games link their own copy of it; the stub left the
word as the work area held it.
---
 ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp    |  3 +++
 ps2xTest/src/ps2_runtime_expansion_tests.cpp | 21 ++++++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
index 44eaef4..27c18c8 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
@@ -2007,6 +2007,9 @@ namespace ps2_stubs
         const uint32_t innerSize = static_cast<uint32_t>(iVar2_signed) - 0x118u;
 
         mpegGuestWrite32(rdram, param_1 + 0x40, uVar3);
+        // sys word 0 is libmpeg's end-of-stream flag: sceMpegIsEnd returns it, and games link their own copy of
+        // that function, so it must start cleared (the work area may hold anything).
+        mpegGuestWrite32(rdram, uVar3 + 0x00, 0u);
 
         const uint32_t a1_init = uVar3 + 0x118u;
         mpegGuestWrite32(rdram, puVar4 + 0x0, a1_init);
diff --git a/ps2xTest/src/ps2_runtime_expansion_tests.cpp b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
index c58f8b7..e0637a0 100644
--- a/ps2xTest/src/ps2_runtime_expansion_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
@@ -836,6 +836,27 @@ void register_ps2_runtime_expansion_tests()
                      "only the injected decoder frame should be counted as served");
         });
 
+        tc.Run("sceMpegCreate clears the end-of-stream word that libmpeg's sceMpegIsEnd reads", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+            ps2_stubs::resetMpegStubState();
+            constexpr uint32_t kMpegAddr = 0x00120000u;
+            constexpr uint32_t kWorkAddr = 0x00130000u;
+            std::memset(rdram.data() + kWorkAddr, 0xFF, 0x2000u); // a work area reused from earlier data
+
+            R5900Context createCtx{};
+            setRegU32(createCtx, 4, kMpegAddr);
+            setRegU32(createCtx, 5, kWorkAddr);
+            setRegU32(createCtx, 6, 0x2000u);
+            ps2_stubs::sceMpegCreate(rdram.data(), &createCtx, &runtime);
+
+            const uint32_t sys = Ps2FastRead32(rdram.data(), kMpegAddr + 0x40u);
+            t.Equals(sys, kWorkAddr, "mp->sys should point at the work area");
+            t.Equals(Ps2FastRead32(rdram.data(), sys), 0u,
+                     "a new decoder has not ended: games' own sceMpegIsEnd returns *mp->sys");
+        });
+
         tc.Run("sceSdRemote isolates voice transfers from block streaming state", [](TestCase &t)
         {
             std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
-- 
