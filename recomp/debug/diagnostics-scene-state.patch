new file mode 100644
index 0000000..b0c0861
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_dump_recorder.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <cstdint>
+
+struct GSRegisters;
+
+// Records GS traffic into a GSdx-style dump (the format parallel-gs replays):
+// a state header (registers, VRAM, privileged registers) followed by GIF
+// transfers and vsync packets. Enabled with PS2_GS_DUMP=<path>; recording starts
+// at vsync PS2_GS_DUMP_START (default 600) and lasts PS2_GS_DUMP_FRAMES vsyncs
+// (default 60). Debug tooling only; costs one branch per call when disabled.
+namespace gsdump
+{
+    // Raw value of every register written through A+D / REGLIST, kept so the
+    // dump header can describe the GS state at the start of the recording.
+    void noteRegister(uint8_t regAddr, uint64_t value);
+
+    // Called before the GS processes a GIF packet (with the GS state lock held,
+    // so VRAM reflects every earlier packet).
+    void onTransfer(const uint8_t *vram, uint32_t vramSize, const uint8_t *data, uint32_t sizeBytes);
+
+    // A host-side image upload that bypassed the GIF packet path.
+    void onImageUpload(const uint8_t *vram, uint32_t vramSize,
+                       uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg, uint64_t trxdir,
+                       const uint8_t *data, uint32_t sizeBytes);
+
+    void onVsync(const GSRegisters &priv, uint64_t vsyncTick);
+}
