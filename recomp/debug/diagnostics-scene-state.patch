diff --git a/ps2xRuntime/src/lib/gs/gs_dump_recorder.cpp b/ps2xRuntime/src/lib/gs/gs_dump_recorder.cpp
new file mode 100644
index 0000000..879170a
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_dump_recorder.cpp
@@ -0,0 +1,218 @@
+#include "runtime/gs/gs_dump_recorder.h"
+#include "runtime/gs/gs_parallel.h"
+#include "runtime/ps2_memory.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <mutex>
+#include <vector>
+
+namespace gsdump
+{
+namespace
+{
+    enum class State : uint8_t
+    {
+        Disabled,
+        Idle,
+        StartPending,
+        Recording,
+        Done,
+    };
+
+    enum PacketType : uint8_t
+    {
+        PacketTransfer = 0,
+        PacketVsync = 1,
+        PacketPrivRegisters = 3,
+    };
+
+    constexpr uint32_t kGifPath = 3u;
+    constexpr uint32_t kStateVersion = 8u; // GSdx version without the trailing dummy state.
+    constexpr size_t kPrivStateBytes = kGsPrivStateQwords * sizeof(uint64_t);
+
+    struct Recorder
+    {
+        std::mutex mutex;
+        std::atomic<State> state{State::Disabled};
+        FILE *file = nullptr;
+        uint64_t startTick = 600u;
+        uint64_t frameCount = 60u;
+        uint64_t framesWritten = 0u;
+        std::array<uint64_t, 0x80> regs{};
+        std::array<uint8_t, kPrivStateBytes> priv{};
+
+        Recorder()
+        {
+            const char *path = std::getenv("PS2_GS_DUMP");
+            if (!path || !*path)
+                return;
+            if (const char *s = std::getenv("PS2_GS_DUMP_START"))
+                startTick = std::strtoull(s, nullptr, 10);
+            if (const char *s = std::getenv("PS2_GS_DUMP_FRAMES"))
+                frameCount = std::strtoull(s, nullptr, 10);
+            file = std::fopen(path, "wb");
+            if (!file)
+            {
+                std::cerr << "[gsdump] cannot open " << path << std::endl;
+                return;
+            }
+            regs[0x1A] = 1u; // PRMODECONT resets to 1.
+            state.store(State::Idle, std::memory_order_release);
+        }
+    };
+
+    Recorder &recorder()
+    {
+        static Recorder instance;
+        return instance;
+    }
+
+    template <typename T>
+    void put(FILE *f, const T &value)
+    {
+        std::fwrite(&value, sizeof(T), 1, f);
+    }
+
+    void capturePriv(Recorder &r, const GSRegisters &priv)
+    {
+        uint64_t packed[kGsPrivStateQwords];
+        gsPackPrivRegisters(priv, packed);
+        std::memcpy(r.priv.data(), packed, sizeof(packed));
+    }
+
+    void writeHeader(Recorder &r, const uint8_t *vram, uint32_t vramSize)
+    {
+        FILE *f = r.file;
+        put<uint32_t>(f, UINT32_MAX); // Fake CRC marker.
+        const uint32_t header[9] = {kStateVersion, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u};
+        put<uint32_t>(f, sizeof(header));
+        std::fwrite(header, sizeof(header), 1, f);
+
+        const auto &g = r.regs;
+        put<uint32_t>(f, kStateVersion);
+        for (uint8_t a : {0x00, 0x1A, 0x1C, 0x22, 0x3B, 0x3D, 0x44, 0x45, 0x46, 0x49, 0x50, 0x53, 0x51, 0x52})
+            put<uint64_t>(f, g[a]);
+        put<uint64_t>(f, 0u);
+        for (uint8_t c = 0; c < 2; ++c)
+        {
+            for (uint8_t a : {0x18, 0x06, 0x14, 0x08, 0x34, 0x36, 0x40, 0x42, 0x47, 0x4A, 0x4C, 0x4E})
+                put<uint64_t>(f, g[a + c]);
+        }
+        put<uint64_t>(f, g[0x01]);
+        put<uint64_t>(f, g[0x02]);
+        put<uint32_t>(f, static_cast<uint32_t>(g[0x03]));
+        put<uint32_t>(f, static_cast<uint32_t>(g[0x0A]));
+        put<uint64_t>(f, 0u);                // XYZ
+        put<uint64_t>(f, 0u);                // GIFReg
+        put<uint64_t>(f, 0u);                // Transfer X/Y
+
+        std::vector<uint8_t> vramCopy(4u * 1024u * 1024u, 0u);
+        std::memcpy(vramCopy.data(), vram, std::min<size_t>(vramSize, vramCopy.size()));
+        std::fwrite(vramCopy.data(), vramCopy.size(), 1, f);
+
+        const uint8_t idlePath[20] = {};
+        for (int i = 0; i < 4; ++i)
+            std::fwrite(idlePath, sizeof(idlePath), 1, f);
+        put<float>(f, 1.0f);
+        std::fwrite(r.priv.data(), r.priv.size(), 1, f);
+    }
+
+    // Starts the recording on the first GS traffic after the start vsync.
+    bool beginIfPending(Recorder &r, const uint8_t *vram, uint32_t vramSize)
+    {
+        State s = r.state.load(std::memory_order_acquire);
+        if (s == State::StartPending)
+        {
+            writeHeader(r, vram, vramSize);
+            r.state.store(State::Recording, std::memory_order_release);
+            std::cerr << "[gsdump] recording started" << std::endl;
+            return true;
+        }
+        return s == State::Recording;
+    }
+
+    void writeTransfer(Recorder &r, const uint8_t *data, uint32_t sizeBytes)
+    {
+        put<uint8_t>(r.file, PacketTransfer);
+        put<uint8_t>(r.file, static_cast<uint8_t>(kGifPath));
+        put<uint32_t>(r.file, sizeBytes);
+        std::fwrite(data, sizeBytes, 1, r.file);
+    }
+}
+
+void noteRegister(uint8_t regAddr, uint64_t value)
+{
+    Recorder &r = recorder();
+    if (r.state.load(std::memory_order_relaxed) == State::Disabled)
+        return;
+    r.regs[regAddr & 0x7Fu] = value;
+}
+
+void onTransfer(const uint8_t *vram, uint32_t vramSize, const uint8_t *data, uint32_t sizeBytes)
+{
+    Recorder &r = recorder();
+    const State s = r.state.load(std::memory_order_relaxed);
+    if (s != State::StartPending && s != State::Recording)
+        return;
+    std::lock_guard<std::mutex> lock(r.mutex);
+    if (!beginIfPending(r, vram, vramSize))
+        return;
+    writeTransfer(r, data, sizeBytes & ~15u);
+}
+
+void onImageUpload(const uint8_t *vram, uint32_t vramSize,
+                   uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg, uint64_t trxdir,
+                   const uint8_t *data, uint32_t sizeBytes)
+{
+    Recorder &r = recorder();
+    const State s = r.state.load(std::memory_order_relaxed);
+    if (s != State::StartPending && s != State::Recording)
+        return;
+
+    const std::vector<uint64_t> packet = gsBuildImageUploadPacket(bitbltbuf, trxpos, trxreg, trxdir, data, sizeBytes);
+
+    std::lock_guard<std::mutex> lock(r.mutex);
+    if (!beginIfPending(r, vram, vramSize))
+        return;
+    writeTransfer(r, reinterpret_cast<const uint8_t *>(packet.data()),
+                  static_cast<uint32_t>(packet.size() * sizeof(uint64_t)));
+}
+
+void onVsync(const GSRegisters &priv, uint64_t vsyncTick)
+{
+    Recorder &r = recorder();
+    const State s = r.state.load(std::memory_order_relaxed);
+    if (s == State::Disabled || s == State::Done)
+        return;
+    std::lock_guard<std::mutex> lock(r.mutex);
+    capturePriv(r, priv);
+    if (s == State::Idle)
+    {
+        if ((vsyncTick % 250u) == 0u)
+            std::cerr << "[gsdump] vsync " << vsyncTick << std::endl;
+        if (vsyncTick >= r.startTick)
+            r.state.store(State::StartPending, std::memory_order_release);
+        return;
+    }
+    if (s != State::Recording)
+        return;
+
+    put<uint8_t>(r.file, PacketPrivRegisters);
+    std::fwrite(r.priv.data(), r.priv.size(), 1, r.file);
+    put<uint8_t>(r.file, PacketVsync);
+    put<uint8_t>(r.file, static_cast<uint8_t>(vsyncTick & 1u));
+    if (++r.framesWritten >= r.frameCount)
+    {
+        std::fclose(r.file);
+        r.file = nullptr;
+        r.state.store(State::Done, std::memory_order_release);
+        std::cerr << "[gsdump] recording finished after " << r.framesWritten << " vsyncs" << std::endl;
+    }
+}
+}
