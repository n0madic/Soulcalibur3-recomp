+                    }
+                std::cerr << std::endl;
+            }
+        }
+        if ((g_tempVerifyRuns & 0xFFFu) == 0)
+            std::cerr << "[TEMP-DEBUG vuverify] runs=" << g_tempVerifyRuns << " mismatches=" << g_tempVerifyMismatches << std::endl;
