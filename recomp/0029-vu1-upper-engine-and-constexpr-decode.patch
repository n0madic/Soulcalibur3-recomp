+// The arithmetic of the VU upper instructions without any pipeline state:
+// from the registers at issue, what an instruction writes and the MAC,
+// status and CLIP results it produces. The interpreter applies a Result
+// through its pipelines. The caller sets round-toward-zero.
+namespace ps2_vu_detail::upper
+{
+    constexpr uint8_t laneForComponent(uint32_t component)
+    {
+        return static_cast<uint8_t>(1u << (3u - component));
+    }
+
+    // Denormals flush to signed zero; Inf/NaN clamp to the signed max.
+    inline float normalizeOperand(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+        if (exponent == 0u)
+            bits &= 0x80000000u;
+        else if (exponent == 0xFFu)
+            bits = (bits & 0x80000000u) | 0x7F7FFFFFu;
+        std::memcpy(&value, &bits, sizeof(value));
+        return value;
+    }
+
+    // normalizeOperand on four lanes.
+    inline void normalizeOperands(const float *in, float *out)
+    {
+#if defined(__SSE4_1__)
+        const __m128i bits = _mm_loadu_si128(reinterpret_cast<const __m128i *>(in));
+        const __m128i exponent = _mm_and_si128(bits, _mm_set1_epi32(0x7F800000));
+        const __m128i sign = _mm_and_si128(bits, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+        __m128i normalized = _mm_blendv_epi8(bits, sign, _mm_cmpeq_epi32(exponent, _mm_setzero_si128()));
+        normalized = _mm_blendv_epi8(normalized, _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF)),
+                                     _mm_cmpeq_epi32(exponent, _mm_set1_epi32(0x7F800000)));
+        _mm_storeu_si128(reinterpret_cast<__m128i *>(out), normalized);
+#elif defined(__ARM_NEON)
+        uint32_t lanes[4];
+        std::memcpy(lanes, in, sizeof(lanes));
+        const uint32x4_t bits = vld1q_u32(lanes);
+        const uint32x4_t exponent = vandq_u32(bits, vdupq_n_u32(0x7F800000u));
+        const uint32x4_t sign = vandq_u32(bits, vdupq_n_u32(0x80000000u));
+        uint32x4_t normalized = vbslq_u32(vceqq_u32(exponent, vdupq_n_u32(0u)), sign, bits);
+        normalized = vbslq_u32(vceqq_u32(exponent, vdupq_n_u32(0x7F800000u)),
+                               vorrq_u32(sign, vdupq_n_u32(0x7F7FFFFFu)), normalized);
+        vst1q_u32(lanes, normalized);
+        std::memcpy(out, lanes, sizeof(lanes));
+#else
+        for (uint32_t lane = 0; lane < 4u; ++lane)
+            out[lane] = normalizeOperand(in[lane]);
+#endif
+    }
+
+    // A rounded result's lane flags (Z 0x1, S 0x2, U 0x4, O 0x8); denormals
+    // flush to signed zero and Inf/NaN clamp to the signed max.
+    inline float normalizeResult(float value, uint32_t &laneFlags)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        const uint32_t sign = bits & 0x80000000u;
+        const uint32_t magnitude = bits & 0x7FFFFFFFu;
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+
+        laneFlags = sign != 0u ? 0x2u : 0u;
+        if (magnitude == 0u)
+        {
+            laneFlags |= 0x1u;
+        }
+        else if (exponent == 0u)
+        {
+            laneFlags |= 0x5u;
+            bits = sign;
+        }
+        else if (exponent == 0xFFu)
+        {
+            laneFlags |= 0x8u;
+            bits = sign | 0x7F7FFFFFu;
+        }
+
+        std::memcpy(&value, &bits, sizeof(value));
+        return value;
+    }
+
+    inline int32_t floatToInt(float value, float scale)
+    {
+        const double scaled = static_cast<double>(value) * static_cast<double>(scale);
+        if (scaled >= static_cast<double>(std::numeric_limits<int32_t>::max()))
+            return std::numeric_limits<int32_t>::max();
+        if (scaled <= static_cast<double>(std::numeric_limits<int32_t>::min()))
+            return std::numeric_limits<int32_t>::min();
+        return static_cast<int32_t>(scaled);
+    }
+
+    // What an FMAC upper instruction computes per lane from its normalized
+    // operands: A is VS (VS crossed for OPMULA/OPMSUB), B the broadcast lane,
+    // Q, I, VT, or VT crossed.
+    enum class FmacOp : uint8_t
+    {
+        None,
+        Add,      // A + B
+        Sub,      // A - B
+        Mul,      // A * B
+        MAdd,     // ACC + A * B
+        MSub,     // ACC - A * B
+        OuterMul, // A * B, w = 0 (OPMULA)
+        OuterMSub // ACC - A * B, w = 0 (OPMSUB)
+    };
+
+    enum class FmacSource : uint8_t
+    {
+        Broadcast,
+        Q,
+        I,
+        Full,
+        Cross,
+    };
+
+    struct FmacDecode
+    {
+        FmacOp op = FmacOp::None;
+        FmacSource source = FmacSource::Full;
+        uint8_t broadcast = 0;
+    };
+
+    constexpr FmacDecode decodeFmac(uint32_t upper)
+    {
+        const uint32_t op = upper & 0x3Fu;
+        const bool special = op >= 0x3Cu;
+        const uint32_t code = special ? ((upper & 3u) | ((upper >> 4) & 0x7Cu)) : op;
+        const uint8_t bc = static_cast<uint8_t>(code & 3u);
+        if (code <= 0x03u)
+            return {FmacOp::Add, FmacSource::Broadcast, bc};
+        if (code <= 0x07u)
+            return {FmacOp::Sub, FmacSource::Broadcast, bc};
+        if (code <= 0x0Bu)
+            return {FmacOp::MAdd, FmacSource::Broadcast, bc};
+        if (code <= 0x0Fu)
+            return {FmacOp::MSub, FmacSource::Broadcast, bc};
+        if (code >= 0x18u && code <= 0x1Bu)
+            return {FmacOp::Mul, FmacSource::Broadcast, bc};
+        switch (code)
+        {
+        case 0x1Cu: return {FmacOp::Mul, FmacSource::Q};
+        case 0x1Eu: return {FmacOp::Mul, FmacSource::I};
+        case 0x20u: return {FmacOp::Add, FmacSource::Q};
+        case 0x21u: return {FmacOp::MAdd, FmacSource::Q};
+        case 0x22u: return {FmacOp::Add, FmacSource::I};
+        case 0x23u: return {FmacOp::MAdd, FmacSource::I};
+        case 0x24u: return {FmacOp::Sub, FmacSource::Q};
+        case 0x25u: return {FmacOp::MSub, FmacSource::Q};
+        case 0x26u: return {FmacOp::Sub, FmacSource::I};
+        case 0x27u: return {FmacOp::MSub, FmacSource::I};
+        case 0x28u: return {FmacOp::Add, FmacSource::Full};
+        case 0x29u: return {FmacOp::MAdd, FmacSource::Full};
+        case 0x2Au: return {FmacOp::Mul, FmacSource::Full};
+        case 0x2Cu: return {FmacOp::Sub, FmacSource::Full};
+        case 0x2Du: return {FmacOp::MSub, FmacSource::Full};
+        case 0x2Eu: return {special ? FmacOp::OuterMul : FmacOp::OuterMSub, FmacSource::Cross};
+        default: return {};
+        }
+    }
+
+    constexpr bool isProductSum(FmacOp op)
+    {
+        return op == FmacOp::MAdd || op == FmacOp::MSub || op == FmacOp::OuterMSub;
+    }
+
+    // The normalized operands of one upper instruction.
+    struct Operands
+    {
+        float vs[4];
+        float vt[4];
+        float acc[4];
+        float q;
+        float i;
+    };
+
+    // Lane `component`'s A and B operands of an FMAC instruction.
+    template <typename Real>
+    inline void fmacOperands(const FmacDecode &fmac, const Operands &in, uint32_t component, Real &a, Real &b)
+    {
+        static constexpr uint8_t crossLeft[4] = {1u, 2u, 0u, 3u};
+        static constexpr uint8_t crossRight[4] = {2u, 0u, 1u, 3u};
+        a = in.vs[fmac.source == FmacSource::Cross ? crossLeft[component] : component];
+        switch (fmac.source)
+        {
+        case FmacSource::Broadcast: b = in.vt[fmac.broadcast]; break;
+        case FmacSource::Q: b = in.q; break;
+        case FmacSource::I: b = in.i; break;
+        case FmacSource::Full: b = in.vt[component]; break;
+        case FmacSource::Cross: b = in.vt[crossRight[component]]; break;
+        }
+    }
+
+    // Lane `component` of an FMAC instruction, computed in Real.
+    template <typename Real>
+    inline Real fmacValue(const FmacDecode &fmac, const Operands &in, uint32_t component)
+    {
+        Real a{}, b{};
+        fmacOperands(fmac, in, component, a, b);
+        const Real acc = in.acc[component];
+        switch (fmac.op)
+        {
+        case FmacOp::Add: return a + b;
+        case FmacOp::Sub: return a - b;
+        case FmacOp::Mul: return a * b;
+        case FmacOp::MAdd: return acc + a * b;
+        case FmacOp::MSub: return acc - a * b;
+        case FmacOp::OuterMul: return component == 3u ? Real(0) : a * b;
+        case FmacOp::OuterMSub: return component == 3u ? Real(0) : acc - a * b;
+        case FmacOp::None: break;
+        }
+        return Real(0);
+    }
+
+    // The rounded VU value of an exact result and its lane flags: zero keeps
+    // its sign, beyond FLT_MAX clamps (O), below FLT_MIN flushes (U and Z).
+    template <typename Real>
+    inline uint8_t normalizeFmacExactResult(float &value, Real exactResult)
+    {
+        const bool negative = std::signbit(exactResult);
+        const Real magnitude = std::fabs(exactResult);
+        const Real maximum = static_cast<Real>(std::numeric_limits<float>::max());
+        const Real minimum = static_cast<Real>(std::numeric_limits<float>::min());
+        uint8_t flags = negative ? 0x2u : 0u;
+
+        uint32_t bits = negative ? 0x80000000u : 0u;
+        if (magnitude == Real(0))
+        {
+            flags |= 0x1u;
+            std::memcpy(&value, &bits, sizeof(value));
+        }
+        else if (magnitude > maximum)
+        {
+            flags |= 0x8u;
+            bits |= 0x7F7FFFFFu;
+            std::memcpy(&value, &bits, sizeof(value));
+        }
+        else if (magnitude < minimum)
+        {
+            flags |= 0x5u;
+            std::memcpy(&value, &bits, sizeof(value));
+        }
+
+        return flags;
+    }
+
+    // Fixes up the Dest lanes of an FMAC result computed in float with
+    // round-toward-zero, and returns each lane's flags plus the product
+    // conditions that only reach the sticky bits.
+    inline void normalizeFmacResult(const FmacDecode &fmac, const Operands &in, float *result,
+                                    uint8_t dest, uint8_t laneFlags[4], uint32_t &productSticky)
+    {
+        productSticky = 0u;
+        const bool single = fmac.op == FmacOp::Add || fmac.op == FmacOp::Sub ||
+                            fmac.op == FmacOp::Mul || fmac.op == FmacOp::OuterMul;
+        const bool productSum = isProductSum(fmac.op);
+
+        for (uint32_t component = 0; component < 4u; ++component)
+        {
+            laneFlags[component] = 0u;
+            if ((dest & laneForComponent(component)) == 0u)
+                continue;
+
+            if (productSum)
+            {
+                // Every product condition accumulates into the sticky flags
+                // (the current flags come from the sum). A float product is
+                // exact in double.
+                double a = 0.0, b = 0.0;
+                fmacOperands(fmac, in, component, a, b);
+                float ignored = 0.0f;
+                productSticky |= normalizeFmacExactResult(ignored, a * b) & 0xFu;
+            }
+
+            // With a single rounding toward zero, a normal result below
+            // FLT_MAX means the exact result is nonzero, same-signed and in
+            // range: the exact check below would only report the sign and
+            // keep the value.
+            if (single)
+            {
+                uint32_t bits = 0;
+                std::memcpy(&bits, &result[component], sizeof(bits));
+                const uint32_t exponent = (bits >> 23) & 0xFFu;
+                if (exponent != 0u && exponent != 0xFFu && (bits & 0x7FFFFFFFu) != 0x7F7FFFFFu)
+                {
+                    laneFlags[component] = (bits & 0x80000000u) != 0u ? 0x2u : 0u;
+                    continue;
+                }
+                // Operands are zero or normal, so a sum or difference is a
+                // multiple of the smallest denormal: one that rounds to zero
+                // is exactly zero, signed by the same IEEE rule as the exact
+                // sum.
+                if ((bits & 0x7FFFFFFFu) == 0u && (fmac.op == FmacOp::Add || fmac.op == FmacOp::Sub))
+                {
+                    laneFlags[component] = (bits & 0x80000000u) != 0u ? 0x3u : 0x1u;
+                    continue;
+                }
+            }
+
+            // The exact result in double classifies like the long double
+            // one: a float product is exact in double, and zero, sign and
+            // FLT_MIN are preserved by rounding toward zero. Only a sum that
+            // rounds to exactly FLT_MAX may hide an overflow, so that case
+            // takes the long double.
+            const double exactResult = fmacValue<double>(fmac, in, component);
+            if (std::fabs(exactResult) == static_cast<double>(std::numeric_limits<float>::max()))
+                laneFlags[component] = normalizeFmacExactResult(result[component], fmacValue<long double>(fmac, in, component));
+            else
+                laneFlags[component] = normalizeFmacExactResult(result[component], exactResult);
+        }
+    }
+
+    enum class Target : uint8_t
+    {
+        None,     // NOP
+        Vf,       // writes the Dest lanes of VF `reg`
+        Acc,      // writes the Dest lanes of ACC
+        Clip,     // CLIP judgement
+        Reserved, // not an upper instruction
+    };
+
+    struct Result
+    {
+        float value[4]{};
+        uint32_t mac = 0u;    // MAC flags of the Dest lanes
+        uint32_t status = 0u; // the Dest lanes' Z/S/U/O, ORed (status bits 0-3)
+        uint32_t sticky = 0u; // product conditions, for the sticky bits only
+        uint32_t clip = 0u;   // CLIP's six judgement bits
+        Target target = Target::None;
+        uint8_t reg = 0u;
+        uint8_t dest = 0u;
+        bool flags = false; // queues MAC and status (an FMAC op with a nonzero Dest)
+    };
+
+    inline Result computeUpper(uint32_t instr, const float (*vf)[4], const float *acc, float q, float i)
+    {
+        Result r;
+        const uint8_t dest = DEST(instr);
+        const uint8_t ft = FT(instr);
+        const uint8_t fs = FS(instr);
+        const uint8_t op = instr & 0x3Fu;
+        const bool special = op >= 0x3Cu;
+        const uint8_t code = special ? static_cast<uint8_t>((instr & 0x3u) | ((instr >> 4) & 0x7Cu)) : op;
+        r.dest = dest;
+
+        Operands in;
+        normalizeOperands(vf[fs], in.vs);
+        normalizeOperands(vf[ft], in.vt);
+        normalizeOperands(acc, in.acc);
+        in.q = normalizeOperand(q);
+        in.i = normalizeOperand(i);
+        const float *vs = in.vs;
+        const float *vt = in.vt;
+        float *result = r.value;
+
+        const FmacDecode fmac = decodeFmac(instr);
+        if (fmac.op != FmacOp::None)
+        {
+            for (uint32_t c = 0; c < 4u; ++c)
+            {
+                float a = 0.0f, b = 0.0f;
+                fmacOperands(fmac, in, c, a, b);
+                switch (fmac.op)
+                {
+                case FmacOp::Add: result[c] = a + b; break;
+                case FmacOp::Sub: result[c] = a - b; break;
+                case FmacOp::Mul: result[c] = a * b; break;
+                case FmacOp::MAdd: result[c] = in.acc[c] + a * b; break;
+                case FmacOp::MSub: result[c] = in.acc[c] - a * b; break;
+                case FmacOp::OuterMul: result[c] = c == 3u ? 0.0f : a * b; break;
+                case FmacOp::OuterMSub: result[c] = c == 3u ? 0.0f : in.acc[c] - a * b; break;
+                case FmacOp::None: break;
+                }
+            }
+            r.target = special ? Target::Acc : Target::Vf;
+            r.reg = special ? 0u : FD(instr);
+
+            uint8_t laneFlags[4]{};
+            normalizeFmacResult(fmac, in, result, dest, laneFlags, r.sticky);
+            r.flags = dest != 0u;
+            for (uint32_t c = 0; c < 4u; ++c)
+            {
+                const uint8_t lane = laneForComponent(c);
+                if ((dest & lane) == 0u)
+                    continue;
+                const uint32_t flags = laneFlags[c];
+                if ((flags & 0x1u) != 0u)
+                    r.mac |= lane;
+                if ((flags & 0x2u) != 0u)
+                    r.mac |= static_cast<uint32_t>(lane) << 4;
+                if ((flags & 0x4u) != 0u)
+                    r.mac |= static_cast<uint32_t>(lane) << 8;
+                if ((flags & 0x8u) != 0u)
+                    r.mac |= static_cast<uint32_t>(lane) << 12;
+                r.status |= flags;
+            }
+            return r;
+        }
+
+        if (!special)
+        {
+            r.target = Target::Vf;
+            r.reg = FD(instr);
+            const auto maxOf = [&](float b) { for (int c = 0; c < 4; c++) result[c] = (vs[c] > b) ? vs[c] : b; };
+            const auto minOf = [&](float b) { for (int c = 0; c < 4; c++) result[c] = (vs[c] < b) ? vs[c] : b; };
+            if (op >= 0x10u && op <= 0x13u) // MAXbc
+                maxOf(vt[op & 3u]);
+            else if (op >= 0x14u && op <= 0x17u) // MINIbc
+                minOf(vt[op & 3u]);
+            else if (op == 0x1Du) // MAXi
+                maxOf(in.i);
+            else if (op == 0x1Fu) // MINIi
+                minOf(in.i);
+            else if (op == 0x2Bu) // MAX
+                for (int c = 0; c < 4; c++)
+                    result[c] = (vs[c] > vt[c]) ? vs[c] : vt[c];
+            else if (op == 0x2Fu) // MINI
+                for (int c = 0; c < 4; c++)
+                    result[c] = (vs[c] < vt[c]) ? vs[c] : vt[c];
+            else
+                r.target = Target::Reserved;
+            return r;
+        }
+
+        // Upper special group: ITOF/FTOI/ABS write FT.
+        r.target = Target::Vf;
+        r.reg = ft;
+        if (code >= 0x10u && code <= 0x13u) // ITOF0, ITOF4, ITOF12, ITOF15
+        {
+            static constexpr float divisors[4] = {1.0f, 16.0f, 4096.0f, 32768.0f};
+            for (int c = 0; c < 4; c++)
+            {
+                int32_t iv;
+                std::memcpy(&iv, &vf[fs][c], 4);
+                result[c] = code == 0x10u ? static_cast<float>(iv) : static_cast<float>(iv) / divisors[code & 3u];
+            }
+        }
+        else if (code >= 0x14u && code <= 0x17u) // FTOI0, FTOI4, FTOI12, FTOI15
+        {
+            static constexpr float scales[4] = {1.0f, 16.0f, 4096.0f, 32768.0f};
+            for (int c = 0; c < 4; c++)
+            {
+                const int32_t iv = floatToInt(vs[c], scales[code & 3u]);
+                std::memcpy(&result[c], &iv, 4);
+            }
+        }
+        else if (code == 0x1Du) // ABS
+        {
+            for (int c = 0; c < 4; c++)
+                result[c] = std::fabs(vs[c]);
+        }
+        else if (code == 0x1Fu) // CLIP
+        {
+            r.target = Target::Clip;
+            r.reg = 0u;
+            uint32_t wBits = 0u;
+            std::memcpy(&wBits, &vf[ft][3], sizeof(wBits));
+            const int32_t limit = (wBits & 0x7F800000u) != 0u ? static_cast<int32_t>(wBits & 0x7FFFFFFFu) : 0x007FFFFF;
+            const auto exceedsClipPlane = [limit](float value, uint32_t signMask)
+            {
+                uint32_t bits = 0u;
+                std::memcpy(&bits, &value, sizeof(bits));
+                bits ^= signMask;
+                int32_t orderedBits = 0;
+                std::memcpy(&orderedBits, &bits, sizeof(orderedBits));
+                return orderedBits > limit;
+            };
+            for (uint32_t c = 0; c < 3u; ++c)
+            {
+                if (exceedsClipPlane(vf[fs][c], 0x00000000u))
+                    r.clip |= 1u << (2u * c);
+                if (exceedsClipPlane(vf[fs][c], 0x80000000u))
+                    r.clip |= 2u << (2u * c);
+            }
+        }
+        else if (code == 0x2Fu || code == 0x30u) // NOP
+        {
+            r.target = Target::None;
+            r.reg = 0u;
+        }
+        else
+        {
+            r.target = Target::Reserved;
+            r.reg = 0u;
+        }
+        return r;
+    }
+}
+
+#endif
