+        case kTagRefe:
+        case kTagRef:
+        case kTagRefs:
+            break;
+        case kTagCnt:
+            dataAddr = tadr + 16u;
+            nextTadr = dataAddr + tagQwc * 16u;
+            break;
+        case kTagNext:
+            dataAddr = tadr + 16u;
+            nextTadr = tagAddr;
+            break;
+        case kTagEnd:
+            dataAddr = tadr + 16u;
+            break;
+        default:
+            return false; // CALL/RET need the address stack, which no IPU feeder uses
+        }
