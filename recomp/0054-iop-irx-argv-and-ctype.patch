From f0e78822c46b4a3a0f8f74338dab50a037b85d74 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sat, 24 Oct 2026 09:32:18 +0300
Subject: [PATCH] IOP: pass IRX argc/argv and implement sysclib ctype

Convert loadfile's NUL-separated argument bytes into a guest argv table,
including the module name, empty arguments and the final null pointer.
Bound the packed allocation and keep it alive until the entry returns.
Reset the sysclib guest table with IOP memory and implement ordinals 8/9
with IOP character masks rather than a constant zero result.

Soulcalibur III loads CRI ADX with thpri=39 and spucore=2. The byte-buffer
ABI and zero digit classification made both options disappear. CRI then
routed the movie to core 0, which the normal audio manager stops, leaving
ADXT_GetTime at 512/48000 and blocking Sofdec video frame delivery.

The argv block is allocated before the image is loaded, so a failed allocation leaves the module arena untouched.

Test: a synthetic IRX records argc/argv for CRI ADX-style options (with an empty argument) and the sysclib ctype answers for '5', 'a', ' ' and the table itself, also after an IOP reset; it fails on the previous runtime.
---
 ps2xIOP/src/emulator/imports/iop_sysclib.cpp |  56 +++++++-
 ps2xIOP/src/emulator/imports/iop_sysclib.h   |   5 +
 ps2xIOP/src/emulator/iop_emulator.cpp        |  66 +++++++--
 ps2xIOP/tests/iop_emulator_tests.cpp         | 139 +++++++++++++++++++
 4 files changed, 252 insertions(+), 14 deletions(-)

diff --git a/ps2xIOP/src/emulator/imports/iop_sysclib.cpp b/ps2xIOP/src/emulator/imports/iop_sysclib.cpp
index 0517478..e94cebe 100644
--- a/ps2xIOP/src/emulator/imports/iop_sysclib.cpp
+++ b/ps2xIOP/src/emulator/imports/iop_sysclib.cpp
@@ -11,11 +11,56 @@
 
 namespace ps2x::iop::detail
 {
+    namespace
+    {
+        constexpr uint32_t kCtypeTableSize = 256u;
+
+        // IOP sysclib masks (not the host C library's locale-dependent masks).
+        constexpr uint8_t ctypeFlags(uint32_t character) noexcept
+        {
+            if (character > 0x7Fu)
+                return 0u;
+            if (character >= '\t' && character <= '\r')
+                return 0x08u;
+            if (character < 0x20u || character == 0x7Fu)
+                return 0x20u;
+            if (character == ' ')
+                return 0x18u;
+            if (character >= '0' && character <= '9')
+                return 0x04u;
+            if (character >= 'A' && character <= 'Z')
+                return character <= 'F' ? 0x41u : 0x01u;
+            if (character >= 'a' && character <= 'z')
+                return character <= 'f' ? 0x42u : 0x02u;
+            return 0x10u;
+        }
+    }
+
     IopSysclib::IopSysclib(IopMemory &memory) noexcept
         : m_memory(memory)
     {
     }
 
+    void IopSysclib::reset() noexcept
+    {
+        // IopMemory::reset releases the guest allocation before this reset.
+        m_ctypeTableAddress = 0u;
+    }
+
+    uint32_t IopSysclib::ctypeTable()
+    {
+        if (m_ctypeTableAddress == 0u)
+        {
+            m_ctypeTableAddress = m_memory.allocate(kCtypeTableSize);
+            if (m_ctypeTableAddress != 0u)
+            {
+                for (uint32_t character = 0u; character < kCtypeTableSize; ++character)
+                    m_memory.write8(m_ctypeTableAddress + character, ctypeFlags(character));
+            }
+        }
+        return m_ctypeTableAddress;
+    }
+
     bool IopSysclib::dispatchImport(uint16_t ordinal, IopCpuState &cpu)
     {
         const uint32_t a0 = cpu.gpr[4];
@@ -73,9 +118,14 @@ namespace ps2x::iop::detail
         case 7:
             setV0(static_cast<uint32_t>(std::tolower(static_cast<unsigned char>(a0))));
             return true;
-        case 8:
-        case 9: // ctype table is optional for most IRXs.
-            setV0(0);
+        case 8: // look_ctype_table(char)
+        {
+            const uint32_t table = ctypeTable();
+            setV0(table != 0u ? m_memory.read8(table + static_cast<uint8_t>(a0)) : 0u);
+            return true;
+        }
+        case 9: // get_ctype_table()
+            setV0(ctypeTable());
             return true;
         case 10: // memchr
             for (uint32_t i = 0; i < a2; ++i)
diff --git a/ps2xIOP/src/emulator/imports/iop_sysclib.h b/ps2xIOP/src/emulator/imports/iop_sysclib.h
index a462a6e..9b0d02a 100644
--- a/ps2xIOP/src/emulator/imports/iop_sysclib.h
+++ b/ps2xIOP/src/emulator/imports/iop_sysclib.h
@@ -12,9 +12,14 @@ namespace ps2x::iop::detail
     public:
         explicit IopSysclib(IopMemory &memory) noexcept;
 
+        void reset() noexcept;
+
         [[nodiscard]] bool dispatchImport(uint16_t ordinal, IopCpuState &cpu);
 
     private:
+        [[nodiscard]] uint32_t ctypeTable();
+
         IopMemory &m_memory;
+        uint32_t m_ctypeTableAddress = 0u;
     };
 }
diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index ee1239a..d448acd 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -24,7 +24,9 @@
 #include <optional>
 #include <span>
 #include <sstream>
+#include <string>
 #include <utility>
+#include <vector>
 
 namespace ps2x::iop::detail
 {
@@ -118,6 +120,7 @@ namespace ps2x::iop::detail
         void reset()
         {
             memory.reset();
+            sysclib.reset();
             kernel.reset();
             modules.clear();
             imports.reset();
@@ -642,6 +645,49 @@ namespace ps2x::iop::detail
         ModuleLoadResult loadImage(std::string path, std::span<const uint8_t> image, const void *arguments, uint32_t argumentSize)
         {
             ModuleLoadResult result{true, -1, -1};
+            constexpr uint32_t kArgumentCapacity = kKernelHeapLimit - kKernelHeapBase;
+            if ((argumentSize != 0u && arguments == nullptr) || argumentSize > kArgumentCapacity)
+            {
+                log(LogLevel::Error, "[IOP] invalid IRX argument buffer");
+                return result;
+            }
+
+            // Loadfile supplies NUL-separated bytes; the IRX entry takes argc/argv.
+            // argv[0] names the module, including when no arguments were supplied.
+            std::vector<std::string> argumentStrings{path};
+            const char *argumentBytes = static_cast<const char *>(arguments);
+            for (uint32_t offset = 0u; offset < argumentSize;)
+            {
+                uint32_t end = offset;
+                while (end < argumentSize && argumentBytes[end] != '\0')
+                    ++end;
+                argumentStrings.emplace_back(argumentBytes + offset, end - offset);
+                offset = end < argumentSize ? end + 1u : end;
+            }
+
+            uint64_t packedSize = (static_cast<uint64_t>(argumentStrings.size()) + 1u) * sizeof(uint32_t);
+            for (const std::string &argument : argumentStrings)
+                packedSize += static_cast<uint64_t>(argument.size()) + 1u;
+            if (packedSize > kArgumentCapacity)
+            {
+                log(LogLevel::Error, "[IOP] IRX argc/argv exceeds IOP argument memory");
+                return result;
+            }
+
+            // Before the image, so a failed allocation leaves the module arena untouched.
+            const uint32_t argv = allocate(static_cast<uint32_t>(packedSize), 16u);
+            if (argv == 0u)
+            {
+                log(LogLevel::Error, "[IOP] cannot allocate IRX argc/argv");
+                return result;
+            }
+            struct ArgumentAllocation
+            {
+                IopMemory &memory;
+                uint32_t address;
+                ~ArgumentAllocation() { (void)memory.freeAllocation(address); }
+            } argumentAllocation{memory, argv};
+
             const IopImageLoadResult loaded = IopModuleLoader::load(image, memory, moduleCursor);
             moduleCursor = loaded.nextModuleCursor;
             if (!loaded)
@@ -665,19 +711,17 @@ namespace ps2x::iop::detail
             module.entry = loaded.entry;
             module.gp = loaded.gp;
 
-            uint32_t args = 0u;
-            if (arguments && argumentSize)
+            const uint32_t argc = static_cast<uint32_t>(argumentStrings.size());
+            uint32_t stringAddress = argv + (argc + 1u) * sizeof(uint32_t);
+            for (uint32_t i = 0u; i < argc; ++i)
             {
-                args = allocate(argumentSize + 1u, 16u);
-                if (args)
-                {
-                    writeRam(args, arguments, argumentSize);
-                    write8(args + argumentSize, 0u);
-                }
+                memory.write32(argv + i * sizeof(uint32_t), stringAddress);
+                const std::string &argument = argumentStrings[i];
+                (void)writeRam(stringAddress, argument.c_str(), argument.size() + 1u);
+                stringAddress += static_cast<uint32_t>(argument.size()) + 1u;
             }
-            const uint32_t startResult = callFunction(module.entry, argumentSize, args, 0u, 0u, module.gp);
-            if (args)
-                freeAllocation(args);
+            memory.write32(argv + argc * sizeof(uint32_t), 0u);
+            const uint32_t startResult = callFunction(module.entry, argc, argv, 0u, 0u, module.gp);
             module.resident = startResult == 0u || startResult == 2u;
             result.moduleId = module.id;
             result.startResult = static_cast<int32_t>(startResult);
diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index 3700ffb..b1f00db 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -883,6 +883,113 @@ namespace
         std::memcpy(host.guest.data() + address + codeOffset, segment.data(), segment.size());
     }
 
+    // Stores its argc/argv at 0x10200/0x10204 and asks sysclib (ordinals 8 and 9) to classify '5', 'a'
+    // and ' ' (results at 0x10208..0x10210) and for the ctype table itself (0x10214).
+    void writeArgvCtypeIrx(TestHost &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+        constexpr uint32_t importTableOffset = 0x100u;
+        constexpr uint32_t lookStub = loadAddress + importTableOffset + 20u;
+        constexpr uint32_t tableStub = lookStub + 8u;
+        auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); };
+
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu;
+        header.ident[1] = 'E';
+        header.ident[2] = 'L';
+        header.ident[3] = 'F';
+        header.ident[4] = 1u;
+        header.ident[5] = 1u;
+        header.ident[6] = 1u;
+        header.type = 2u;
+        header.machine = 8u;
+        header.version = 1u;
+        header.entry = loadAddress;
+        header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader);
+        header.phentsize = sizeof(ProgramHeader);
+        header.phnum = 1u;
+
+        const uint32_t code[] = {
+            0x27BDFFE0u, // addiu sp, sp, -0x20
+            0xAFBF001Cu, // sw    ra, 0x1c(sp)
+            0x3C080001u, // lui   t0, 1
+            0x35080200u, // ori   t0, t0, 0x200
+            0xAD040000u, // sw    a0, 0(t0)
+            0xAD050004u, // sw    a1, 4(t0)
+            0x24040035u, // addiu a0, zero, '5'
+            jal(lookStub),
+            0x00000000u,
+            0x3C080001u, 0x35080200u,
+            0xAD020008u, // sw    v0, 8(t0)
+            0x24040061u, // addiu a0, zero, 'a'
+            jal(lookStub),
+            0x00000000u,
+            0x3C080001u, 0x35080200u,
+            0xAD02000Cu, // sw    v0, 12(t0)
+            0x24040020u, // addiu a0, zero, ' '
+            jal(lookStub),
+            0x00000000u,
+            0x3C080001u, 0x35080200u,
+            0xAD020010u, // sw    v0, 16(t0)
+            jal(tableStub),
+            0x00000000u,
+            0x3C080001u, 0x35080200u,
+            0xAD020014u, // sw    v0, 20(t0)
+            0x8FBF001Cu, // lw    ra, 0x1c(sp)
+            0x00001021u, // addu  v0, zero, zero
+            0x27BD0020u, // addiu sp, sp, 0x20
+            0x03E00008u, // jr    ra
+            0x00000000u, // nop
+        };
+        static_assert(sizeof(code) <= importTableOffset);
+        const uint32_t importTable[] = {
+            0x41E00000u, // IRX import magic
+            0x00000000u,
+            0x00000101u,
+            0x63737973u, // "sysc"
+            0x0062696Cu, // "lib"
+            0x03E00008u, // jr ra
+            0x24000008u, // look_ctype_table
+            0x03E00008u, // jr ra
+            0x24000009u, // get_ctype_table
+            0x00000000u,
+            0x00000000u,
+        };
+
+        ProgramHeader program{};
+        program.type = 1u;
+        program.offset = codeOffset;
+        program.vaddr = loadAddress;
+        program.paddr = loadAddress;
+        program.filesz = importTableOffset + sizeof(importTable);
+        program.memsz = 0x300u;
+        program.flags = 7u;
+        program.align = 4u;
+
+        std::fill(host.guest.begin() + address, host.guest.end(), 0u);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + codeOffset, code, sizeof(code));
+        std::memcpy(host.guest.data() + address + codeOffset + importTableOffset, importTable, sizeof(importTable));
+    }
+
+    uint32_t readIop32(const IopSubsystem &iop, uint32_t address)
+    {
+        uint32_t value = 0u;
+        (void)iop.readMemory(address, &value, sizeof(value));
+        return value;
+    }
+
+    std::string readIopString(const IopSubsystem &iop, uint32_t address)
+    {
+        std::string text;
+        for (char c = 0; iop.readMemory(address, &c, 1u) && c != '\0'; ++address)
+            text.push_back(c);
+        return text;
+    }
+
     bool expect(bool value, const char *message)
     {
         if (!value)
@@ -1180,5 +1287,37 @@ int main()
                 "sceCdSeek still emitted an unhandled IOP import")) return 1;
 
     std::cout << "ps2xIOP emulator smoke tests passed\n";
+    // Loadfile passes NUL-separated bytes; the IRX entry gets argc/argv with the module name first, empty
+    // arguments kept and a null pointer last. Soulcalibur III starts CRI ADX with "thpri=39" and "spucore=2",
+    // which its option parser reads through sysclib's ctype table.
+    iop.reset();
+    writeArgvCtypeIrx(host, 0x100u);
+    const char adxArguments[] = "thpri=39\0\0spucore=2"; // the second argument is empty
+    const ModuleLoadResult argvModule = iop.loadModuleBuffer(0x100u, adxArguments, sizeof(adxArguments));
+    if (!expect(argvModule.handled && argvModule.startResult == 0, "argc/argv IRX did not start")) return 1;
+    const uint32_t argc = readIop32(iop, 0x10200u);
+    const uint32_t argv = readIop32(iop, 0x10204u);
+    if (!expect(argc == 4u, "argc should count the module name, both options and the empty argument")) return 1;
+    if (!expect(!readIopString(iop, readIop32(iop, argv)).empty(), "argv[0] should name the module")) return 1;
+    if (!expect(readIopString(iop, readIop32(iop, argv + 4u)) == "thpri=39", "argv[1] mismatch")) return 1;
+    if (!expect(readIopString(iop, readIop32(iop, argv + 8u)).empty(), "argv[2] should be the empty argument")) return 1;
+    if (!expect(readIopString(iop, readIop32(iop, argv + 12u)) == "spucore=2", "argv[3] mismatch")) return 1;
+    if (!expect(readIop32(iop, argv + 16u) == 0u, "argv[argc] should be a null pointer")) return 1;
+    if (!expect(readIop32(iop, 0x10208u) == 0x04u, "look_ctype_table('5') should report a digit")) return 1;
+    if (!expect(readIop32(iop, 0x1020Cu) == 0x42u, "look_ctype_table('a') should report lower case and hex")) return 1;
+    if (!expect(readIop32(iop, 0x10210u) == 0x18u, "look_ctype_table(' ') should report space")) return 1;
+    uint8_t upperA = 0u;
+    if (!expect(iop.readMemory(readIop32(iop, 0x10214u) + 'A', &upperA, 1u) && upperA == 0x41u,
+                "get_ctype_table should return the guest table")) return 1;
+
+    iop.reset();
+    writeArgvCtypeIrx(host, 0x100u);
+    const ModuleLoadResult argvAfterReset = iop.loadModuleBuffer(0x100u);
+    if (!expect(argvAfterReset.handled && argvAfterReset.startResult == 0, "argc/argv IRX did not restart")) return 1;
+    if (!expect(readIop32(iop, 0x10200u) == 1u, "with no arguments argc should be 1")) return 1;
+    uint8_t digitZero = 0u;
+    if (!expect(iop.readMemory(readIop32(iop, 0x10214u) + '0', &digitZero, 1u) && digitZero == 0x04u,
+                "the ctype table should be rebuilt after an IOP reset")) return 1;
+
     return 0;
 }
