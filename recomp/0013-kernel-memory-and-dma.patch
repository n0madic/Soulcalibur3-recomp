+        tc.Run("SetupHeap with size -1 ends the heap at the main thread's stack", [](TestCase &t)
+        {
+            // Soulcalibur III: SetupThread(gp, 0x1FDFF00, 0x20000), SetupHeap(0x653A78, -1).
+            // The kernel lets the heap run up to the stack; ADX needs ~1.5 MB of it at the top.
+            TestEnv env;
+            constexpr uint32_t kStack = 0x01FDFF00u;
+            constexpr uint32_t kHeapBase = 0x00653A78u;
+
+            env.ctx.pc = 0x00100000u;
