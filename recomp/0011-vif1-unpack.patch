+        tc.Run("VIF UNPACK V2 V3 and V4-5 write every field as the hardware does", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            std::memset(mem.getVU1Data(), 0xEE, PS2_VU1_DATA_SIZE);
+
+            auto qword = [&](uint32_t addr, uint32_t field)
+            {
+                uint32_t v = 0;
+                std::memcpy(&v, mem.getVU1Data() + addr * 16u + field * 4u, 4u);
+                return v;
+            };
+
+            std::vector<uint8_t> packet;
+            appendU32(packet, makeVifCmd(0x64u, 1u, 0u)); // UNPACK V2-32 -> addr 0
+            appendU32(packet, 1u);
+            appendU32(packet, 2u);
+
+            appendU32(packet, makeVifCmd(0x68u, 2u, 1u)); // UNPACK V3-32 -> addr 1 and 2
+            appendU32(packet, 10u);
+            appendU32(packet, 11u);
+            appendU32(packet, 12u);
+            appendU32(packet, 20u);
+            appendU32(packet, 21u);
+            appendU32(packet, 22u);
+
+            appendU32(packet, makeVifCmd(0x69u, 2u, 3u)); // UNPACK V3-16 -> addr 3 and 4
+            appendU32(packet, 0x00020001u);
+            appendU32(packet, 0xFFFC0003u);
+            appendU32(packet, 0x00060005u);
+
+            appendU32(packet, makeVifCmd(0x6Fu, 2u, 5u)); // UNPACK V4-5 -> addr 5 and 6
+            appendU32(packet, 0x0421FFFFu);
+
+            appendU32(packet, makeVifCmd(0x30u, 0u, 0u)); // STROW
+            appendU32(packet, 100u);
+            appendU32(packet, 200u);
+            appendU32(packet, 300u);
+            appendU32(packet, 400u);
+            appendU32(packet, makeVifCmd(0x05u, 0u, 1u)); // STMOD offset
+            appendU32(packet, makeVifCmd(0x64u, 1u, 7u)); // UNPACK V2-32 -> addr 7
+            appendU32(packet, 1u);
+            appendU32(packet, 2u);
+
+            mem.processVIF1Data(packet.data(), static_cast<uint32_t>(packet.size()));
+
+            t.Equals(qword(0, 0), 1u, "V2 X");
