From b72d345bf103eb962aa5e531e100a5272152d8a9 Mon Sep 17 00:00:00 2001
From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:06:17 +0300
Subject: [PATCH] Unpack 32-bit VIF1 vectors without a mask in a direct loop

---
 ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp | 48 ++++++++++++++++
 ps2xTest/src/ps2_memory_tests.cpp            | 59 ++++++++++++++++++++
 2 files changed, 107 insertions(+)

diff --git a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
index 05e42aa..e4aff22 100644
--- a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
+++ b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
@@ -79,6 +79,44 @@ namespace
 
         return 0u;
     }
+
+    // UNPACK of 32-bit elements without a mask or row addition and with CL >= WL,
+    // which is how games mostly send vertices: write i takes source vector i and
+    // goes to ADDR + (i / WL) * CL + i % WL. S repeats its element, V2 is x,y,x,y
+    // and V3 takes W from the next element of the packet (zero past its end).
+    template <uint32_t Elements>
+    void unpack32(uint8_t *vuData, const uint8_t *src, const uint8_t *packetEnd, uint32_t count,
+                  uint32_t address, uint32_t cl, uint32_t wl)
+    {
+        static_assert(PS2_VU1_DATA_SIZE == 0x400u * 16u, "VU1 data addresses wrap at 0x3FF");
+        uint32_t cyclePos = 0u;
+        for (uint32_t i = 0u; i < count; ++i, src += Elements * 4u)
+        {
+            uint32_t lanes[4];
+            std::memcpy(lanes, src, Elements * 4u);
+            if constexpr (Elements == 1u)
+                lanes[1] = lanes[2] = lanes[3] = lanes[0];
+            else if constexpr (Elements == 2u)
+            {
+                lanes[2] = lanes[0];
+                lanes[3] = lanes[1];
+            }
+            else if constexpr (Elements == 3u)
+            {
+                lanes[3] = 0u;
+                if (src + 16u <= packetEnd)
+                    std::memcpy(&lanes[3], src + 12u, sizeof(lanes[3]));
+            }
+            std::memcpy(vuData + (address & 0x3FFu) * 16u, lanes, sizeof(lanes));
+            if (++cyclePos == wl)
+            {
+                cyclePos = 0u;
+                address += cl - wl + 1u;
+            }
+            else
+                ++address;
+        }
+    }
 }
 
 void PS2Memory::processVIF0Data(uint32_t srcPhys, uint32_t sizeBytes)
@@ -572,6 +610,16 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
 
             const bool zeroExtend = (imm & 0x4000u) != 0u;
 
+            if (vl == 0u && !maskEnable && (vif1_regs.mode & 3u) == 0u && cl >= wl && m_vu1Data &&
+                pos + totalBytes <= sizeBytes)
+            {
+                const auto unpack = components == 1 ? unpack32<1u> : components == 2 ? unpack32<2u>
+                                                   : components == 3 ? unpack32<3u> : unpack32<4u>;
+                unpack(m_vu1Data, data + pos, data + sizeBytes, writeVectorCount, vuAddr, cl, wl);
+                pos += totalBytes;
+                continue;
+            }
+
             if (m_vu1Data && totalBytes > 0 && pos + totalBytes <= sizeBytes)
             {
                 const uint8_t *srcBase = data + pos;
diff --git a/ps2xTest/src/ps2_memory_tests.cpp b/ps2xTest/src/ps2_memory_tests.cpp
index fc769d0..91db72b 100644
--- a/ps2xTest/src/ps2_memory_tests.cpp
+++ b/ps2xTest/src/ps2_memory_tests.cpp
@@ -10,6 +10,7 @@
 #include <algorithm>
 #include <cstdint>
 #include <cstring>
+#include <string>
 #include <vector>
 
 namespace
@@ -787,6 +788,64 @@ void register_ps2_memory_tests()
             t.Equals(qword(7, 3), 402u, "offset mode adds the row to the repeated V2 W");
         });
 
+        tc.Run("VIF UNPACK of 32-bit elements matches the layout model for every CL >= WL", [](TestCase &t)
+        {
+            // Write i goes to ADDR + (i / WL) * CL + i % WL (wrapping in VU1 data memory) and
+            // takes source vector i; S repeats its element, V2 is x,y,x,y and V3 takes W from
+            // the next element of the packet, zero past its end.
+            const uint8_t formats[] = {0x60u, 0x64u, 0x68u, 0x6Cu}; // S, V2, V3, V4-32
+            const uint16_t cycles[][2] = {{1u, 1u}, {4u, 1u}, {4u, 4u}, {3u, 2u}, {2u, 1u}};
+            const uint32_t counts[] = {1u, 5u, 256u};
+            const uint16_t addresses[] = {0u, 0x3FCu};
+            uint32_t seed = 1u;
+            for (const uint8_t opcode : formats)
+                for (const auto &cycle : cycles)
+                    for (const uint32_t count : counts)
+                        for (const uint16_t address : addresses)
+                        {
+                            PS2Memory mem;
+                            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+                            std::vector<uint32_t> expected(PS2_VU1_DATA_SIZE / 4u);
+                            for (uint32_t word = 0u; word < expected.size(); ++word)
+                                expected[word] = 0xA0000000u | word;
+                            std::memcpy(mem.getVU1Data(), expected.data(), PS2_VU1_DATA_SIZE);
+
+                            const uint32_t elements = ((opcode >> 2) & 3u) + 1u;
+                            std::vector<uint32_t> stream(count * elements);
+                            for (uint32_t &element : stream)
+                                element = (seed = seed * 1664525u + 1013904223u);
+
+                            std::vector<uint8_t> packet;
+                            appendU32(packet, makeVifCmd(0x01u, 0u, static_cast<uint16_t>((cycle[1] << 8) | cycle[0])));
+                            appendU32(packet, makeVifCmd(opcode, static_cast<uint8_t>(count & 0xFFu), address));
+                            for (const uint32_t element : stream)
+                                appendU32(packet, element);
+                            mem.processVIF1Data(packet.data(), static_cast<uint32_t>(packet.size()));
+
+                            const uint32_t cl = cycle[0], wl = cycle[1];
+                            for (uint32_t i = 0u; i < count; ++i)
+                            {
+                                const uint32_t qword = (address + (i / wl) * cl + i % wl) & 0x3FFu;
+                                const uint32_t *src = stream.data() + i * elements;
+                                uint32_t *dst = expected.data() + qword * 4u;
+                                if (elements == 1u)
+                                    dst[0] = dst[1] = dst[2] = dst[3] = src[0];
+                                else if (elements == 2u)
+                                {
+                                    dst[0] = dst[2] = src[0];
+                                    dst[1] = dst[3] = src[1];
+                                }
+                                else
+                                    for (uint32_t field = 0u; field < 4u; ++field)
+                                        dst[field] = field < elements || i + 1u < count ? src[field] : 0u;
+                            }
+                            const bool same = std::memcmp(mem.getVU1Data(), expected.data(), PS2_VU1_DATA_SIZE) == 0;
+                            t.IsTrue(same, "UNPACK 0x" + std::to_string(opcode) + " CL " + std::to_string(cl) + " WL " +
+                                               std::to_string(wl) + " NUM " + std::to_string(count) + " ADDR " +
+                                               std::to_string(address) + " writes the modelled layout");
+                        }
+        });
+
         tc.Run("VIF fill write uses STMASK and STROW when WL>CL", [](TestCase &t)
         {
             PS2Memory mem;
