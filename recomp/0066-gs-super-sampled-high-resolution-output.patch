+    // PAL display of a 512x512 PSMCT32 buffer at page 0, as Soulcalibur III sets it up.
+    void setUpPalDisplay(GSRegisters &regs)
+    {
+        regs.pmode = 0x1u | (1u << 2) | (1u << 5) | (0xFFu << 8); // EN1, CRTMD=1, MMOD, ALP=0xFF
+        regs.smode1 = (32ull << 3) | (3ull << 13);                 // LC=32, CMOD=PAL
+        regs.smode2 = 0x1u;
+        regs.dispfb1 = 8ull << 9;                                  // FBW=8 (512 pixels)
+        regs.display1 = 0x1FE9FF0204B296ull;
+    }
+
+    // Not representable in PSMCT16 (5 bits per channel): a 16-bit buffer shows it as 0xC0.
+    constexpr uint32_t kTriangleGreen = 0xC4u;
+
+    struct Presented
+    {
+        uint32_t width = 0u;
+        uint32_t height = 0u;
+        uint32_t partlyCoveredPixels = 0u; // neither the triangle's green nor the black around it
+        uint8_t centreGreen = 0u;
+    };
+
+    // The way Soulcalibur III builds a frame: it renders into a 640x448 PSMCT32 buffer at page 0, then
+    // blits that buffer with a textured sprite into the 512x512 PSMCT16 buffer at page 0x8C, which is
+    // what the display circuit reads. The frame is a green triangle with a diagonal edge over black.
+    // The blit follows a vsync, as in the game, so it is a render pass of its own.
+    Presented presentBlittedFrame(TestCase &t, uint32_t superSampling)
+    {
+        GsFixture f;
+        if (!requireGpuGs(t, f.gs, GSParallelOptions{superSampling}))
+            return {};
+        setUpPalDisplay(*f.regs);
+        f.regs->dispfb1 = 0x8Cull | (8ull << 9) | (2ull << 15); // page 0x8C, 512 pixels, PSMCT16
+        f.gs.onVsync(0u);
+
+        send(f.gs, adPacket({{kRegFrame1, 10ull << 16},
+                             {kRegTest1, 0u},
+                             {kRegXyoffset1, 0u},
+                             {kRegScissor1, (639ull << 16) | (447ull << 48)},
+                             {kRegPrim, 6u},
+                             {kRegRgbaq, 0x80ull << 24},
+                             {kRegXyz2, 0u},
+                             {kRegXyz2, (640ull << 4) | ((448ull << 4) << 16)},
+                             {kRegPrim, 3u},
+                             {kRegRgbaq, (kTriangleGreen << 8) | (0x80ull << 24)},
+                             {kRegXyz2, 0u},
+                             {kRegXyz2, 600ull << 4},
+                             {kRegXyz2, (440ull << 4) << 16}}));
+        f.gs.onVsync(1u); // the game blits a finished frame at the start of the next one
+        // TEX0: page 0, 640 wide, PSMCT24, 1024x512, TCC, DECAL. PRIM: sprite, TME, FST.
+        const uint64_t tex0 = (10ull << 14) | (1ull << 20) | (10ull << 26) | (9ull << 30) | (1ull << 34) | (1ull << 35);
+        send(f.gs, adPacket({{kRegPrmodecont, 1u}, // the attributes come from PRIM
+                             {kRegFrame1, 0x8Cull | (8ull << 16) | (2ull << 24)},
+                             {kRegScissor1, (511ull << 16) | (511ull << 48)},
+                             {kRegTex01, tex0},
+                             {kRegPrim, 0x116u},
+                             {kRegUv, 0u},
+                             {kRegXyz2, 0u},
+                             {kRegUv, (640ull << 4) | ((448ull << 4) << 16)},
+                             {kRegXyz2, (512ull << 4) | ((512ull << 4) << 16)}}));
+        f.gs.onVsync(0u);
+        f.gs.onVsync(1u); // publishes the previous vsync's picture
+        f.gs.latchHostPresentationFrame();
+
+        std::vector<uint8_t> frame;
+        Presented presented;
+        if (!f.gs.copyLatchedHostPresentationFrame(frame, presented.width, presented.height))
+        {
+            t.Fail("no frame presented");
+            return {};
+        }
+        for (size_t i = 0; i + 3u < frame.size(); i += 4u)
+            if (frame[i + 1u] > 0x18u && frame[i + 1u] < 0xA8u)
+                ++presented.partlyCoveredPixels;
+        presented.centreGreen = frame[(static_cast<size_t>(presented.height / 4u) * presented.width + presented.width / 4u) * 4u + 1u];
+        return presented;
+    }
