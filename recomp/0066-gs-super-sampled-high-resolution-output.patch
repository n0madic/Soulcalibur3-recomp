                                                const uint8_t *data, uint32_t sizeBytes);
 
+// Image quality settings of the GPU renderer.
+struct GSParallelOptions
+{
+    // Samples per pixel: 1, 4, 8 or 16. 1 scans out exactly what the game displays. With 4 or more the
+    // picture is scanned out at twice its resolution from the samples (4: one per output pixel, 8 and
+    // 16: averaged, which smooths polygon edges); a game's final blit of its frame into the display
+    // buffer (often scaled down, 16-bit, or blended with the previous picture) is replaced by the
+    // blit's source buffer, so that the samples reach the screen.
+    uint32_t superSampling = 1u;
+};
+
+// Parses a sample count for GSParallelOptions::superSampling (PS2_GS_SSAA); nullopt if unsupported
+// (paraLLEl-GS's 2x cannot be scanned out at a higher resolution, so it is not offered).
+std::optional<uint32_t> gsParseSuperSampling(const char *value);
+
 // GS emulated by paraLLEl-GS (Vulkan compute). It consumes raw GIF traffic and owns the GS local
 // memory; SIGNAL/FINISH/LABEL are reported back into the privileged registers passed to create().
 // Not thread safe: the GS frontend serialises every call.
@@ -27,7 +43,8 @@ class GSParallelRenderer
 public:
     // Returns nullptr (and the reason in error) when the runtime was built without paraLLEl-GS or no
     // suitable Vulkan device is available.
