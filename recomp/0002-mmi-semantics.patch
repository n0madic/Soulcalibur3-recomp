+                             moved.lo == ctx.lo && moved.lo1 == ctx.lo1,
+                         "PMTHI writes both halves of HI only");
+                moved = ctx;
+                ps2_pmtlo(&moved, value);
+                t.IsTrue(moved.lo == ((uint64_t(w[1]) << 32) | w[0]) && moved.lo1 == ((uint64_t(w[3]) << 32) | w[2]) &&
+                             moved.hi == ctx.hi && moved.hi1 == ctx.hi1,
+                         "PMTLO writes both halves of LO only");
+
+                moved = ctx;
+                ps2_pmthl_lw(&moved, value);
+                const HiLo m = readHiLo(moved);
+                t.IsTrue(m.lo[0] == w[0] && m.hi[0] == w[1] && m.lo[2] == w[2] && m.hi[2] == w[3] &&
+                             m.lo[1] == s.lo[1] && m.hi[1] == s.hi[1] && m.lo[3] == s.lo[3] && m.hi[3] == s.hi[3],
+                         "PMTHL.LW fills the even words of LO/HI and keeps the odd ones");
+            }
+        });
+
+        tc.Run("generated MMI code reads and writes the instruction's own registers", [](TestCase &t)
+        {
+            R5900Decoder decoder;
+            CodeGenerator generator({}, {});
+            constexpr uint32_t rs = 4, rt = 5, rd = 6;
+
+            for (const OperandRule &rule : kOperandRules)
+            {
+                const uint32_t raw = (OPCODE_MMI << 26) | (rs << 21) | (rt << 16) | (rd << 11) | (rule.sub << 6) | rule.group;
+                const Instruction inst = decoder.decodeInstruction(0x2000u, raw);
+                const std::string code = generator.translateInstruction(inst);
+                const std::string name = rule.name;
+
+                t.IsTrue(code.find("Unhandled") == std::string::npos, name + " is translated");
+                t.Equals(code.find("(ctx, 4)") != std::string::npos, rule.readsRs, name + " reads rs exactly when the instruction does");
+                t.Equals(code.find("(ctx, 5)") != std::string::npos, rule.readsRt, name + " reads rt exactly when the instruction does");
+                t.Equals(code.find("ctx, 6,") != std::string::npos, rule.writesRd, name + " writes rd exactly when the instruction does");
+            }
+        });
+    });
+}
