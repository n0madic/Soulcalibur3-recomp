+        const Bytes y = viewAs<Bytes>(b);
+        Bytes r;
+        for (int i = 0; i < 16; i++)
+            r[i] = fn(x[i], y[i]);
+        return toVec(r);
+    }
+
+    int64_t clampTo(int64_t v, int64_t lo, int64_t hi)
+    {
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+    // The register file state the HI/LO instructions operate on: hi/lo hold words 0-1, hi1/lo1 words 2-3.
+    struct HiLo
+    {
+        std::array<uint32_t, 4> lo;
+        std::array<uint32_t, 4> hi;
+    };
+
+    HiLo readHiLo(const R5900Context &ctx)
+    {
+        HiLo s;
+        s.lo = {static_cast<uint32_t>(ctx.lo), static_cast<uint32_t>(ctx.lo >> 32), static_cast<uint32_t>(ctx.lo1), static_cast<uint32_t>(ctx.lo1 >> 32)};
+        s.hi = {static_cast<uint32_t>(ctx.hi), static_cast<uint32_t>(ctx.hi >> 32), static_cast<uint32_t>(ctx.hi1), static_cast<uint32_t>(ctx.hi1 >> 32)};
+        return s;
+    }
+
+    void randomHiLo(R5900Context &ctx, Rng &rng)
+    {
+        std::memset(&ctx, 0, sizeof(ctx));
+        ctx.lo = rng.next();
+        ctx.hi = rng.next();
+        ctx.lo1 = rng.next();
+        ctx.hi1 = rng.next();
+    }
+
+    bool sameHiLo(const R5900Context &a, const R5900Context &b)
+    {
+        return a.lo == b.lo && a.hi == b.hi && a.lo1 == b.lo1 && a.hi1 == b.hi1;
+    }
+
+    std::string describeHiLo(const R5900Context &c)
+    {
+        char buf[160];
+        std::snprintf(buf, sizeof(buf), "hi=%016llx lo=%016llx hi1=%016llx lo1=%016llx",
+                      static_cast<unsigned long long>(c.hi), static_cast<unsigned long long>(c.lo),
+                      static_cast<unsigned long long>(c.hi1), static_cast<unsigned long long>(c.lo1));
+        return buf;
+    }
+
+    void setHiLo(R5900Context &ctx, const HiLo &s)
+    {
+        ctx.lo = (static_cast<uint64_t>(s.lo[1]) << 32) | s.lo[0];
+        ctx.lo1 = (static_cast<uint64_t>(s.lo[3]) << 32) | s.lo[2];
+        ctx.hi = (static_cast<uint64_t>(s.hi[1]) << 32) | s.hi[0];
+        ctx.hi1 = (static_cast<uint64_t>(s.hi[3]) << 32) | s.hi[2];
+    }
+
+    // Runs an HI/LO-touching operation against a reference model that works on word arrays.
+    // impl(ctx, rs, rt) -> rd value; ref(state, rs, rt) -> rd value (state updated in place).
+    template <typename Impl, typename Ref>
+    void checkHiLo(TestCase &t, const char *name, Impl impl, Ref ref)
+    {
+        const std::vector<__m128i> vecs = operandVectors();
+        Rng rng;
+        for (size_t i = 0; i < vecs.size(); i++)
+        {
+            const __m128i rs = vecs[i];
+            const __m128i rt = vecs[(i * 5 + 1) % vecs.size()];
+            R5900Context ctx;
+            randomHiLo(ctx, rng);
+            HiLo model = readHiLo(ctx);
+            const R5900Context before = ctx;
+
+            const __m128i got = impl(&ctx, rs, rt);
+            const __m128i want = ref(model, rs, rt);
+            R5900Context expected = before;
+            setHiLo(expected, model);
+
+            if (std::memcmp(&got, &want, sizeof(got)) != 0 || !sameHiLo(ctx, expected))
+            {
+                t.Fail(std::string(name) + ": rs=" + hex128(rs) + " rt=" + hex128(rt) + " before{" + describeHiLo(before) + "} got rd=" +
+                       hex128(got) + " {" + describeHiLo(ctx) + "} want rd=" + hex128(want) + " {" + describeHiLo(expected) + "}");
+                return;
+            }
+        }
+    }
+
+    // Reference QFSRV: bit i of the result is bit (i + sa) of rs:rt.
+    __m128i referenceQfsrv(__m128i rs, __m128i rt, uint32_t sa)
+    {
+        const Bytes lo = viewAs<Bytes>(rt);
+        const Bytes hi = viewAs<Bytes>(rs);
+        auto bit = [&](uint32_t n) -> unsigned
+        {
+            if (n >= 256)
+                return 0;
+            const uint8_t byte = n < 128 ? lo[n / 8] : hi[(n - 128) / 8];
+            return (byte >> (n % 8)) & 1u;
+        };
+        Bytes out{};
+        for (uint32_t i = 0; i < 128; i++)
+            out[i / 8] = static_cast<uint8_t>(out[i / 8] | (bit(i + sa) << (i % 8)));
+        return toVec(out);
+    }
+
+    int32_t sat32(int64_t v)
+    {
+        return static_cast<int32_t>(clampTo(v, INT32_MIN, INT32_MAX));
+    }
