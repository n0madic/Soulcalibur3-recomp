index ddc6d9e..56c2df8 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -379,6 +379,7 @@ add_library(ps2_runtime STATIC
     src/lib/game_overrides.cpp
     src/lib/gs/ps2_gif_arbiter.cpp
     src/lib/gs/ps2_host_fxaa.cpp
+    src/lib/gs/ps2_host_smaa.cpp
     src/lib/ps2_audio.cpp
     src/lib/ps2_pcm_queue.cpp
     src/lib/ps2_audio_vag.cpp
@@ -569,6 +570,23 @@ if(PS2X_PARALLEL_GS_DIR)
     target_compile_definitions(ps2_runtime PRIVATE PS2X_HAS_PARALLEL_GS=1)
     target_link_libraries(ps2_runtime PRIVATE parallel-gs)
     message(STATUS "GS renderer: paraLLEl-GS from ${PS2X_PARALLEL_GS_DIR}")
+
+    # SMAA for the host picture (ps2_host_smaa.cpp) comes from the reference SMAA.hlsl and its
+    # precomputed textures in Granite (MIT). The shader is embedded as bytes, with its carriage
+    # returns and the Latin-1 letters in its comments turned into spaces for the GLSL compiler.
+    set(PS2X_SMAA_HLSL "${PS2X_PARALLEL_GS_DIR}/Granite/assets/shaders/post/SMAA.hlsl")
+    set(PS2X_SMAA_TEXTURES "${PS2X_PARALLEL_GS_DIR}/Granite/tools/smaa")
+    if(EXISTS "${PS2X_SMAA_HLSL}" AND EXISTS "${PS2X_SMAA_TEXTURES}/AreaTex.h")
+        file(READ "${PS2X_SMAA_HLSL}" ps2x_smaa_hex HEX)
+        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ps2x_smaa_bytes "${ps2x_smaa_hex}")
+        string(REGEX REPLACE "0x(0d|[89a-f][0-9a-f])," "0x20," ps2x_smaa_bytes "${ps2x_smaa_bytes}")
+        set(PS2X_SMAA_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/generated")
+        file(WRITE "${PS2X_SMAA_GENERATED}/ps2_smaa_hlsl.h.in" "static const char kSmaaHlsl[] = {${ps2x_smaa_bytes}0x00};\n")
+        configure_file("${PS2X_SMAA_GENERATED}/ps2_smaa_hlsl.h.in" "${PS2X_SMAA_GENERATED}/ps2_smaa_hlsl.h" COPYONLY)
+        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PS2X_SMAA_HLSL}")
+        target_include_directories(ps2_runtime PRIVATE "${PS2X_SMAA_GENERATED}" "${PS2X_SMAA_TEXTURES}")
+        target_compile_definitions(ps2_runtime PRIVATE PS2X_HAS_SMAA=1)
+    endif()
 else()
     target_sources(ps2_runtime PRIVATE src/lib/gs/gs_parallel_stub.cpp)
     message(STATUS "GS renderer: CPU only (PS2X_PARALLEL_GS_DIR not set)")
