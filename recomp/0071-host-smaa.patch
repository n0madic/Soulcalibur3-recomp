index 0000000..049724b
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/ps2_host_smaa.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include "raylib.h"
+
+// SMAA 1x (Jimenez et al., preset HIGH) at the picture's own resolution, before the window scales
+// it. Built from the reference SMAA.hlsl and its precomputed area and search textures in the
+// paraLLEl-GS checkout's Granite; without paraLLEl-GS load() fails. Needs a window (an OpenGL context).
+class Ps2HostSmaa
+{
+public:
+    // False when SMAA was not built in or a shader does not compile.
+    bool load();
+    void unload();
+
+    // Renders the picture through SMAA's three passes (edge detection, blending weights,
+    // neighbourhood blending) into a texture of its size, the same way up, and returns that texture.
+    // The source must be sampled with bilinear filtering and clamped edges.
+    const Texture2D &apply(const Texture2D &picture);
+
+private:
+    struct Pass
+    {
+        Shader shader{};
+        int rtMetricsLocation = -1;
+    };
+
+    Pass m_edges;
+    Pass m_weights;
+    Pass m_blend;
+    int m_areaLocation = -1;
+    int m_searchLocation = -1;
+    int m_blendWeightsLocation = -1;
+    Texture2D m_area{};
+    Texture2D m_search{};
+    RenderTexture2D m_edgesTarget{};
+    RenderTexture2D m_weightsTarget{};
+    RenderTexture2D m_output{};
+};
