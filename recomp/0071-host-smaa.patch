+// Anti-aliasing of the PS2 picture by the host (PS2_HOST_AA), before the window scales it.
+// Super-sampling in paraLLEl-GS shades every sample of the scene; these filters only look at the
+// finished picture, so they cost a fraction of a millisecond and smooth polygon edges, though not
+// detail thinner than a pixel. SMAA finds the shape of each edge and leaves straight edges and
+// one-pixel lines (text) alone; FXAA blends across any edge it finds.
+enum class Ps2HostAntiAliasing
+{
+    Off,
+    Fxaa,
+    Smaa,
+};
+
+inline std::optional<Ps2HostAntiAliasing> ps2ParseHostAntiAliasing(const char *value)
+{
+    if (!value)
+        return std::nullopt;
+    if (std::strcmp(value, "smaa") == 0)
+        return Ps2HostAntiAliasing::Smaa;
+    if (std::strcmp(value, "fxaa") == 0)
+        return Ps2HostAntiAliasing::Fxaa;
+    if (std::strcmp(value, "off") == 0)
+        return Ps2HostAntiAliasing::Off;
+    return std::nullopt;
+}
+
 // Catmull-Rom bicubic filter for raylib's default vertex shader (GLSL 330) and a bilinear-filtered,
 // edge-clamped texture: the 4x4 taps are folded into 9 bilinear fetches. textureSize is the texture's
 // size in texels.
