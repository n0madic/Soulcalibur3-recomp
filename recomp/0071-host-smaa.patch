diff --git a/ps2xRuntime/src/lib/gs/ps2_host_pass.h b/ps2xRuntime/src/lib/gs/ps2_host_pass.h
new file mode 100644
index 0000000..6519890
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/ps2_host_pass.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include "raylib.h"
+
+// Vertex shader of the host's picture passes. The texture coordinate follows the output pixel, so a
+// pass rendered into a raylib render texture keeps its input's row order (raylib's own coordinates
+// would turn it upside down), and the passes read each other's output the same way up.
+inline constexpr const char *kPs2HostPassVertexShader = R"glsl(#version 330
+in vec3 vertexPosition;
+uniform mat4 mvp;
+out vec2 fragTexCoord;
+void main()
+{
+    gl_Position = mvp * vec4(vertexPosition, 1.0);
+    fragTexCoord = gl_Position.xy * 0.5 + 0.5;
+}
+)glsl";
+
+// Makes `target` a render texture of the given size, sampled bilinearly with clamped edges.
+inline void ps2EnsureHostPassTarget(RenderTexture2D &target, int width, int height)
+{
+    if (target.id != 0 && target.texture.width == width && target.texture.height == height)
+        return;
+    if (target.id != 0)
+        UnloadRenderTexture(target);
+    target = LoadRenderTexture(width, height);
+    SetTextureFilter(target.texture, TEXTURE_FILTER_BILINEAR);
+    SetTextureWrap(target.texture, TEXTURE_WRAP_CLAMP);
+}
+
+inline void ps2UnloadHostPassTarget(RenderTexture2D &target)
+{
+    if (target.id != 0)
+        UnloadRenderTexture(target);
+    target = {};
+}
diff --git a/ps2xRuntime/src/lib/gs/ps2_host_smaa.cpp b/ps2xRuntime/src/lib/gs/ps2_host_smaa.cpp
new file mode 100644
index 0000000..8495da7
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/ps2_host_smaa.cpp
@@ -0,0 +1,228 @@
+#include "runtime/gs/ps2_host_smaa.h"
+
+#include "ps2_host_pass.h"
+#include "rlgl.h"
+
+#include <string>
+#include <vector>
+
+#if defined(PS2X_HAS_SMAA)
+#include "AreaTex.h"
+#include "SearchTex.h"
+#include "ps2_smaa_hlsl.h" // kSmaaHlsl: SMAA.hlsl, generated by CMake
+#endif
+
+namespace
+{
+#if defined(PS2X_HAS_SMAA)
+    // The passes' entry points around SMAA.hlsl, as Granite's smaa_*.vert/frag do it. The texture
+    // coordinate follows the output pixel (see kPs2HostPassVertexShader).
+    constexpr const char *kEdgesVertex = R"glsl(
+in vec3 vertexPosition;
+uniform mat4 mvp;
+out vec2 texcoord;
+out vec4 offset0;
+out vec4 offset1;
+out vec4 offset2;
+void main()
+{
+    gl_Position = mvp * vec4(vertexPosition, 1.0);
+    texcoord = gl_Position.xy * 0.5 + 0.5;
+    vec4 offset[3];
+    SMAAEdgeDetectionVS(texcoord, offset);
+    offset0 = offset[0];
+    offset1 = offset[1];
+    offset2 = offset[2];
+}
+)glsl";
+
+    constexpr const char *kEdgesFragment = R"glsl(
+in vec2 texcoord;
+in vec4 offset0;
+in vec4 offset1;
+in vec4 offset2;
+uniform sampler2D texture0;
+out vec4 finalColor;
+void main()
+{
+    finalColor = vec4(SMAALumaEdgeDetectionPS(texcoord, vec4[](offset0, offset1, offset2), texture0), 0.0, 0.0);
+}
+)glsl";
+
+    constexpr const char *kWeightsVertex = R"glsl(
+in vec3 vertexPosition;
+uniform mat4 mvp;
+out vec2 texcoord;
+out vec2 pixcoord;
+out vec4 offset0;
+out vec4 offset1;
+out vec4 offset2;
+void main()
+{
+    gl_Position = mvp * vec4(vertexPosition, 1.0);
+    texcoord = gl_Position.xy * 0.5 + 0.5;
+    vec4 offset[3];
+    SMAABlendingWeightCalculationVS(texcoord, pixcoord, offset);
+    offset0 = offset[0];
+    offset1 = offset[1];
+    offset2 = offset[2];
+}
+)glsl";
+
+    constexpr const char *kWeightsFragment = R"glsl(
+in vec2 texcoord;
+in vec2 pixcoord;
+in vec4 offset0;
+in vec4 offset1;
+in vec4 offset2;
+uniform sampler2D texture0;
+uniform sampler2D areaTex;
+uniform sampler2D searchTex;
+out vec4 finalColor;
+void main()
+{
+    finalColor = SMAABlendingWeightCalculationPS(texcoord, pixcoord, vec4[](offset0, offset1, offset2),
+                                                 texture0, areaTex, searchTex, vec4(0.0));
+}
+)glsl";
+
+    constexpr const char *kBlendVertex = R"glsl(
+in vec3 vertexPosition;
+uniform mat4 mvp;
+out vec2 texcoord;
+out vec4 offset;
+void main()
+{
+    gl_Position = mvp * vec4(vertexPosition, 1.0);
+    texcoord = gl_Position.xy * 0.5 + 0.5;
+    SMAANeighborhoodBlendingVS(texcoord, offset);
+}
+)glsl";
+
+    constexpr const char *kBlendFragment = R"glsl(
+in vec2 texcoord;
+in vec4 offset;
+uniform sampler2D texture0;
+uniform sampler2D blendTex;
+out vec4 finalColor;
+void main()
+{
+    finalColor = SMAANeighborhoodBlendingPS(texcoord, offset, texture0, blendTex);
+}
+)glsl";
+
+    std::string smaaStage(bool vertex, const char *entryPoint)
+    {
+        std::string source = "#version 330\n"
+                             "#define SMAA_GLSL_3\n"
+                             "#define SMAA_PRESET_HIGH\n"
+                             "#define SMAA_RT_METRICS rtMetrics\n";
+        source += vertex ? "#define SMAA_INCLUDE_VS 1\n#define SMAA_INCLUDE_PS 0\n"
+                         : "#define SMAA_INCLUDE_VS 0\n#define SMAA_INCLUDE_PS 1\n";
+        source += "uniform vec4 rtMetrics;\n";
+        source += kSmaaHlsl;
+        source += entryPoint;
+        return source;
+    }
+#endif
+
+    void unloadShader(Shader &shader, int &location)
+    {
+        if (location >= 0)
+            UnloadShader(shader);
+        shader = {};
+        location = -1;
+    }
+}
+
+bool Ps2HostSmaa::load()
+{
+#if defined(PS2X_HAS_SMAA)
+    const auto loadPass = [](Pass &pass, const char *vertex, const char *fragment) {
+        pass.shader = LoadShaderFromMemory(smaaStage(true, vertex).c_str(), smaaStage(false, fragment).c_str());
+        pass.rtMetricsLocation = GetShaderLocation(pass.shader, "rtMetrics");
+        // raylib substitutes its default shader, which has no rtMetrics, when compiling fails.
+        return pass.rtMetricsLocation >= 0;
+    };
+    if (!loadPass(m_edges, kEdgesVertex, kEdgesFragment) ||
+        !loadPass(m_weights, kWeightsVertex, kWeightsFragment) ||
+        !loadPass(m_blend, kBlendVertex, kBlendFragment))
+    {
+        unload();
+        return false;
+    }
+    m_areaLocation = GetShaderLocation(m_weights.shader, "areaTex");
+    m_searchLocation = GetShaderLocation(m_weights.shader, "searchTex");
+    m_blendWeightsLocation = GetShaderLocation(m_blend.shader, "blendTex");
+
+    // The area texture is two channels; raylib shows a two-channel texture as gray and alpha, so it
+    // is uploaded as RGBA with the channels in red and green.
+    std::vector<unsigned char> area(static_cast<size_t>(AREATEX_WIDTH) * AREATEX_HEIGHT * 4u);
+    for (size_t i = 0; i < static_cast<size_t>(AREATEX_WIDTH) * AREATEX_HEIGHT; ++i)
+    {
+        area[i * 4u] = areaTexBytes[i * 2u];
+        area[i * 4u + 1u] = areaTexBytes[i * 2u + 1u];
+        area[i * 4u + 3u] = 0xFFu;
+    }
+    m_area = LoadTextureFromImage(Image{area.data(), AREATEX_WIDTH, AREATEX_HEIGHT, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8});
+    std::vector<unsigned char> search(searchTexBytes, searchTexBytes + SEARCHTEX_SIZE);
+    m_search = LoadTextureFromImage(Image{search.data(), SEARCHTEX_WIDTH, SEARCHTEX_HEIGHT, 1, PIXELFORMAT_UNCOMPRESSED_GRAYSCALE});
+    for (const Texture2D &texture : {m_area, m_search})
+    {
+        SetTextureFilter(texture, TEXTURE_FILTER_BILINEAR);
+        SetTextureWrap(texture, TEXTURE_WRAP_CLAMP);
+    }
+    return true;
+#else
+    return false;
+#endif
+}
+
+void Ps2HostSmaa::unload()
+{
+    ps2UnloadHostPassTarget(m_edgesTarget);
+    ps2UnloadHostPassTarget(m_weightsTarget);
+    ps2UnloadHostPassTarget(m_output);
+    if (m_area.id != 0)
+        UnloadTexture(m_area);
+    if (m_search.id != 0)
+        UnloadTexture(m_search);
+    m_area = {};
+    m_search = {};
+    for (Pass *pass : {&m_edges, &m_weights, &m_blend})
+        unloadShader(pass->shader, pass->rtMetricsLocation);
+}
+
+const Texture2D &Ps2HostSmaa::apply(const Texture2D &picture)
+{
+    ps2EnsureHostPassTarget(m_edgesTarget, picture.width, picture.height);
+    ps2EnsureHostPassTarget(m_weightsTarget, picture.width, picture.height);
+    ps2EnsureHostPassTarget(m_output, picture.width, picture.height);
+
+    const float rtMetrics[4] = {1.0f / static_cast<float>(picture.width), 1.0f / static_cast<float>(picture.height),
+                                static_cast<float>(picture.width), static_cast<float>(picture.height)};
+    // Each pass draws `input` over its whole target, replacing what is there: the edges and weights
+    // carry data in their alpha channel, which raylib's alpha blending would mix away.
+    const auto runPass = [&](RenderTexture2D &target, const Pass &pass, const Texture2D &input, auto bindExtra) {
+        SetShaderValue(pass.shader, pass.rtMetricsLocation, rtMetrics, SHADER_UNIFORM_VEC4);
+        BeginTextureMode(target);
+        ClearBackground(BLANK);
+        rlSetBlendFactors(RL_ONE, RL_ZERO, RL_FUNC_ADD);
+        BeginBlendMode(BLEND_CUSTOM);
+        BeginShaderMode(pass.shader);
+        bindExtra();
+        DrawTexture(input, 0, 0, WHITE);
+        EndShaderMode();
+        EndBlendMode();
+        EndTextureMode();
+    };
+    runPass(m_edgesTarget, m_edges, picture, [] {});
+    runPass(m_weightsTarget, m_weights, m_edgesTarget.texture, [&] {
+        SetShaderValueTexture(m_weights.shader, m_areaLocation, m_area);
+        SetShaderValueTexture(m_weights.shader, m_searchLocation, m_search);
+    });
+    runPass(m_output, m_blend, picture, [&] {
