+            const __m128i rt = _mm_set_epi32(0x11111111, static_cast<int32_t>(0x80000010u), 0x22222222, 0x00000100);
+            const __m128i rs = _mm_set_epi32(7, 4, 7, 8);
+            int64_t out[2];
