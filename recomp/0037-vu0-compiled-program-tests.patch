-def image(programs):
-    words = [(LOWER_NOP, UPPER_NOP)] * PAIRS
+def stopped_by_xgkick(generator):
+    """XGKICK is reserved on VU0: the compiled routine leaves it to the interpreter, which stops.
+
+    The interpreter stops before results still in flight land, while the
+    compiled pairs wrote theirs at issue, so the pairs right before the stop
+    write nothing (see the README's known gaps).
+    """
+    program = generator.start(16)
+    generator.straight(program, 10)
+    for _ in range(4):
+        program.add()
+    program.add(lower_special(0x6C, KICK), UPPER_NOP)
+    generator.straight(program, 4)
+    generator.end(program)
+    return program
+
+
+def image(programs, pairs=PAIRS):
+    words = [(LOWER_NOP, UPPER_NOP)] * pairs
     for program in programs:
-        if program.entry + len(program.pairs) > PAIRS:
-            raise ValueError(f"program at {program.entry * 8:#x} runs past the end of VU1 code memory")
+        if program.entry + len(program.pairs) > pairs:
+            raise ValueError(f"program at {program.entry * 8:#x} runs past the end of code memory")
         for index, pair in enumerate(program.pairs, program.entry):
             words[index] = tuple(pair)
     return b"".join(struct.pack("<II", lower, upper_word) for lower, upper_word in words)
@@ -416,12 +438,17 @@ def main():
         images.append([first, second])
     for seed in range(200, 206):
         images.append([Generator(seed, outer_iterations=60).program(0)])
+    # VU0 code memory holds a quarter as much: one shorter program per image.
+    vu0_images = [[stopped_by_xgkick(Generator(299, vu0=True))]]
+    vu0_images += [[Generator(seed, vu0=True).program(0, (8, 20))] for seed in range(300, 312)]
+    vu0_images += [[Generator(seed, outer_iterations=60, vu0=True).program(0, (8, 20))] for seed in range(400, 403)]
     lines = []
-    for programs in images:
-        code = image(programs)
-        name = f"{fnv(code):016x}"
-        (output / f"vu1-{name}.code").write_bytes(code)
-        lines += [f"{name} {program.entry * 8:x}" for program in programs]
+    for unit, pairs, group in (("vu1", PAIRS, images), ("vu0", VU0_PAIRS, vu0_images)):
+        for programs in group:
+            code = image(programs, pairs)
+            name = f"{fnv(code):016x}"
+            (output / f"{unit}-{name}.code").write_bytes(code)
+            lines += [f"{name} {program.entry * 8:x}" for program in programs]
     (output / "entries.txt").write_text("\n".join(lines) + "\n")
 
 
