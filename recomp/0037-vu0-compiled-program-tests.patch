+    def test_vu0_routines_carry_their_code_size_and_mask(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            nop = (vu.LOWER_NOP, vu.UPPER_NOP)
+            # B back by two from pair 0 lands on the last pair of VU0 code memory.
+            pairs = [(vu.branch(0x20, offset=-2), vu.UPPER_NOP), nop]
+            profile(root, pairs, [0], unit="vu0")
+            result, output = compile_profile(root)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(registered_pcs(output), {0})
+            self.assertIn("{0x0000u, 4096u, ", output.read_text())
+            text, _ = routines(output)
+            self.assertIn("0x0FFFu};", text)
+            self.assertIn(f"goto b_{vu.VU0_PAIRS - 1:04x};", text)
+
+    def test_vu0_hands_its_reserved_instructions_to_the_interpreter(self):
+        nop = (vu.LOWER_NOP, vu.UPPER_NOP)
+        end = [(vu.LOWER_NOP, vu.UPPER_NOP | vu.E_BIT), nop]
+        # EFU operations, WAITP, MFP and XGKICK exist on VU1 only.
+        for lower in (vu.lower_special(0x70, 1), vu.lower_special(0x7B), vu.lower_special(0x64, 0, 1, 15),
+                      vu.lower_special(0x6C, vu.KICK)):
+            for unit, blocks in (("vu1", [len(end) + 3]), ("vu0", [2])):
+                with tempfile.TemporaryDirectory() as directory:
+                    root = Path(directory)
+                    profile(root, [nop, nop, (lower, vu.UPPER_NOP)] + end, [0], unit=unit)
+                    result, output = compile_profile(root)
+                    self.assertEqual(result.returncode, 0, result.stderr)
+                    text, found = routines(output)
+                    self.assertEqual(found, blocks, f"{unit} {lower:#x}")
+                    self.assertEqual("return p.leave(0x0010u);" in text, unit == "vu0")
+
+    def test_the_same_code_on_both_units_gives_two_routines(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            pairs = [(vu.immediate15(0x08, 2, 2, 1), vu.UPPER_NOP), (vu.LOWER_NOP, vu.UPPER_NOP | vu.E_BIT),
+                     (vu.LOWER_NOP, vu.UPPER_NOP)]
+            profile(root, pairs, [0], unit="vu0", name="zero")
+            profile(root, pairs, [0], unit="vu1", name="one")
