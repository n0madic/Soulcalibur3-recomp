+        // A block that ends with a branch whose delay slot lies past its end (decodeFunction decodes that
+        // slot) continues after the slot when the branch is not taken. The next block starts at the delay
+        // slot, so that address is nobody's start: register it with the function that contains it.
+        for (const auto &function : m_functions)
+        {
+            if (!function.isRecompiled || function.isStub || function.isSkipped)
+            {
+                continue;
+            }
+
+            auto decodedIt = m_decodedFunctions.find(function.start);
+            if (decodedIt == m_decodedFunctions.end() || decodedIt->second.size() < 2u)
+            {
+                continue;
+            }
+
+            const auto &instructions = decodedIt->second;
+            const Instruction &branch = instructions[instructions.size() - 2u];
+            if (instructions.back().address != function.end || !branch.isBranch || !branch.hasDelaySlot)
+            {
+                continue;
+            }
+
+            const uint32_t fallThrough = function.end + 4u;
+            const Function *owner = findContainingFunction(fallThrough);
+            if (owner && owner->start != fallThrough)
+            {
+                m_resumeEntryTargetsByOwner[owner->start].push_back(fallThrough);
+            }
+        }
+
         size_t totalTargets = 0u;
         for (auto it = m_resumeEntryTargetsByOwner.begin(); it != m_resumeEntryTargetsByOwner.end();)
         {
@@ -2119,6 +2150,7 @@ namespace ps2recomp
 
         uint32_t start = function.start;
         uint32_t end = function.end;
+        bool delaySlotIncluded = false;
 
         for (uint32_t address = start; address < end; address += 4)
         {
@@ -2176,6 +2208,15 @@ namespace ps2recomp
