+bool GSCpuBackend::BeginTexelCache(const GSDrawState &state, int lastDrawnRow)
+{
+    TexelCache &cache = m_texelCache;
+    cache.active = false;
+    if (!m_texelCacheEnabled)
+        return false;
+
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+    const int texW = state.textureWidth;
+    const int texH = state.textureHeight;
+    if (texW <= 0 || texH <= 0 || static_cast<size_t>(texW) * static_cast<size_t>(texH) > (1u << 20u) || !m_vram)
+        return false;
+
+    // Highest texture row (plus one) a wrapped coordinate can reach.
+    const uint8_t wrapV = static_cast<uint8_t>((ctx.clamp >> 2) & 0x3u);
+    const uint32_t minV = static_cast<uint32_t>((ctx.clamp >> 24) & 0x3FFu);
+    const uint32_t maxV = static_cast<uint32_t>((ctx.clamp >> 34) & 0x3FFu);
+    uint32_t reachableRows = static_cast<uint32_t>(texH);
+    if (wrapV == 2u)
+        reachableRows = std::min<uint32_t>(reachableRows, std::max(minV, maxV) + 1u);
+    else if (wrapV == 3u)
+        reachableRows = std::min<uint32_t>(reachableRows, (minV | maxV) + 1u);
+
+    // The draw writes the frame buffer and possibly the depth buffer. A texel whose VRAM page those writes can
+    // reach is not cached (its value would depend on when it is read); the other texel rows are. VRAM is paged
+    // (8 KiB pages of a fixed pixel extent per format), so the check works on whole page rows.
+    struct PageGeometry
+    {
+        uint32_t width;
+        uint32_t height;
+    };
+    auto pageGeometry = [](uint32_t psm) -> PageGeometry
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            return {64u, 64u};
+        case GS_PSM_T8:
+            return {128u, 64u};
+        case GS_PSM_T4:
+            return {128u, 128u};
+        default:
+            return {64u, 32u};
+        }
+    };
+    auto pageRowBytes = [&](uint32_t psm, uint32_t bufferWidth) -> uint64_t
+    {
+        const PageGeometry g = pageGeometry(psm);
+        const uint64_t pixels = static_cast<uint64_t>(std::max<uint32_t>(bufferWidth, 1u)) * 64u;
+        return ((pixels + g.width - 1u) / g.width) * 8192u;
+    };
+
+    const uint64_t vramSize = m_vramSize;
+    const uint64_t texBegin = static_cast<uint64_t>(tex.tbp0) * 256u;
+    const PageGeometry texPage = pageGeometry(tex.psm);
+    const uint64_t texRowBytes = pageRowBytes(tex.psm, tex.tbw);
+    if ((texBegin & 8191u) != 0u)
+        return false;
+    const uint64_t texEnd = texBegin + ((static_cast<uint64_t>(reachableRows) + texPage.height - 1u) / texPage.height) * texRowBytes;
+    if (texEnd > vramSize)
+        return false;
+
+    const uint64_t rows = static_cast<uint64_t>(std::max(lastDrawnRow + 1, 1));
+    struct Region
+    {
+        uint64_t begin;
+        uint64_t end;
+    };
+    auto drawnRegion = [&](uint32_t base, uint32_t psm) -> Region
+    {
+        const PageGeometry g = pageGeometry(psm);
+        const uint64_t begin = static_cast<uint64_t>(base) * 8192u;
+        return {begin, begin + ((rows + g.height - 1u) / g.height) * pageRowBytes(psm, ctx.frame.fbw)};
+    };
+    const Region regions[2] = {drawnRegion(ctx.frame.fbp, ctx.frame.psm), drawnRegion(ctx.zbuf.zbp, ctx.zbuf.psm)};
+
+    uint64_t usablePageRows = (static_cast<uint64_t>(reachableRows) + texPage.height - 1u) / texPage.height;
+    for (const Region &region : regions)
+    {
+        if (region.end > vramSize)
+            return false;
+        if (region.begin >= texEnd || region.end <= texBegin)
+            continue; // disjoint
+        if (region.begin <= texBegin)
+            return false; // the writes reach the first texture rows
+        usablePageRows = std::min(usablePageRows, (region.begin - texBegin) / texRowBytes);
+    }
+    const uint64_t usableRows = std::min<uint64_t>(static_cast<uint64_t>(texH), usablePageRows * texPage.height);
+    if (usableRows == 0u)
+        return false;
+
+    const size_t count = static_cast<size_t>(texW) * static_cast<size_t>(texH);
+    if (cache.entries.size() < count)
+    {
+        cache.entries.assign(count, TexelCache::Entry{0u, 0u});
+        cache.generation = 0u;
+    }
+    if (++cache.generation == 0u)
+    {
+        cache.entries.assign(cache.entries.size(), TexelCache::Entry{0u, 0u});
+        cache.generation = 1u;
+    }
+    cache.width = texW;
+    cache.height = static_cast<int>(usableRows);
+    cache.active = true;
+    return true;
+}
+
 uint32_t GSCpuBackend::SampleTexture(const GSDrawState &state, float s, float t, float q, uint16_t u, uint16_t v)
 {
     const auto &ctx = state.context;
@@ -1083,11 +1271,8 @@ uint32_t GSCpuBackend::SampleTexture(const GSDrawState &state, float s, float t,
         texVf = t * invQ * static_cast<float>(texH);
     }
 
-    auto samplePoint = [&](int sampleU, int sampleV) -> uint32_t
+    auto decodeTexel = [&](int sampleU, int sampleV) -> uint32_t
     {
-        sampleU = wrapTextureCoordinate(sampleU, texW, wrapU, minU, maxU);
-        sampleV = wrapTextureCoordinate(sampleV, texH, wrapV, minV, maxV);
-
         u32 out = ReadTextureVramUnlocked(tex.psm, tex.tbp0, tex.tbw, sampleU, sampleV);
 
         switch (tex.psm)
@@ -1113,6 +1298,27 @@ uint32_t GSCpuBackend::SampleTexture(const GSDrawState &state, float s, float t,
         return 0xFFFF00FFu;
     };
 
+    auto samplePoint = [&](int sampleU, int sampleV) -> uint32_t
+    {
+        sampleU = wrapTextureCoordinate(sampleU, texW, wrapU, minU, maxU);
+        sampleV = wrapTextureCoordinate(sampleV, texH, wrapV, minV, maxV);
+
+        TexelCache &cache = m_texelCache;
+        if (cache.active && static_cast<uint32_t>(sampleU) < static_cast<uint32_t>(cache.width) &&
+            static_cast<uint32_t>(sampleV) < static_cast<uint32_t>(cache.height))
+        {
+            const size_t index = static_cast<size_t>(sampleV) * static_cast<size_t>(cache.width) + static_cast<size_t>(sampleU);
+            TexelCache::Entry &entry = cache.entries[index];
+            if (entry.tag == cache.generation)
+                return entry.texel;
+            const uint32_t texel = decodeTexel(sampleU, sampleV);
+            entry.tag = cache.generation;
+            entry.texel = texel;
+            return texel;
+        }
+        return decodeTexel(sampleU, sampleV);
+    };
+
     if (!state.linearFilter)
     {
         return samplePoint(static_cast<int>(texUf), static_cast<int>(texVf));
@@ -1197,6 +1403,7 @@ void GSCpuBackend::DrawSprite(const GSPrimitiveBatch &batch)
     const int drawX1 = clampInt(unclippedX1, ctx.scissor.x0, ctx.scissor.x1);
     const int drawY1 = clampInt(unclippedY1, ctx.scissor.y0, ctx.scissor.y1);
 
+
     const uint64_t alphaReg = ctx.alpha;
     const uint8_t alphaMode = static_cast<uint8_t>(alphaReg & 0xFFu);
     const uint8_t alphaFix = static_cast<uint8_t>((alphaReg >> 32) & 0xFFu);
@@ -1234,6 +1441,10 @@ void GSCpuBackend::DrawSprite(const GSPrimitiveBatch &batch)
         if (spriteH < 1.0f)
             spriteH = 1.0f;
 
+        // Large sprites revisit each texel several times (scaling, bilinear taps); decode every texel once.
+        if (static_cast<int64_t>(drawX1 - drawX0 + 1) * (drawY1 - drawY0 + 1) >= 2048)
+            BeginTexelCache(state, drawY1);
+
         for (int y = drawY0; y <= drawY1; ++y)
         {
             float ty = (static_cast<float>(y - unclippedY0) + 0.5f) / spriteH;
@@ -1266,12 +1477,16 @@ void GSCpuBackend::DrawSprite(const GSPrimitiveBatch &batch)
                 WritePixel(state, x, y, z1, color.r, color.g, color.b, color.a, v1.fog);
             }
         }
+        EndTexelCache();
     }
     else
     {
-        for (int y = drawY0; y <= drawY1; ++y)
-            for (int x = drawX0; x <= drawX1; ++x)
-                WritePixel(state, x, y, z1, r, g, b, a, v1.fog);
+        if (!FillFlatRect(state, drawX0, drawY0, drawX1, drawY1, z1, r, g, b, a, v1.fog))
+        {
+            for (int y = drawY0; y <= drawY1; ++y)
+                for (int x = drawX0; x <= drawX1; ++x)
+                    WritePixel(state, x, y, z1, r, g, b, a, v1.fog);
+        }
     }
 }
 
