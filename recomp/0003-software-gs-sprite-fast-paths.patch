index 0000000..3c1a887
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_raster_tests.cpp
@@ -0,0 +1,253 @@
+#include "MiniTest.h"
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace
+{
+    constexpr uint32_t kVramSize = 4u * 1024u * 1024u;
+
+    struct Rng
+    {
+        uint64_t state;
+        explicit Rng(uint64_t seed) : state(seed) {}
+        uint64_t next()
+        {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            return state;
+        }
+    };
+
+    // A backend over VRAM filled with a fixed pseudo-random pattern.
+    struct Raster
+    {
+        std::vector<uint8_t> vram = std::vector<uint8_t>(kVramSize);
+        GSCpuBackend backend;
+
+        Raster()
+        {
+            Rng rng(0x1234567ull);
+            for (size_t i = 0; i < vram.size(); i += 8)
+            {
+                const uint64_t v = rng.next();
+                std::memcpy(vram.data() + i, &v, 8);
+            }
+            backend.Initialize(vram.data(), kVramSize);
+        }
+    };
+
+    bool sameVram(const Raster &a, const Raster &b)
+    {
+        return std::memcmp(a.vram.data(), b.vram.data(), kVramSize) == 0;
+    }
+
+    GSPrimitiveBatch baseBatch(GSPrimType type, uint32_t vertexCount)
+    {
+        GSPrimitiveBatch batch{};
+        batch.vertexCount = static_cast<uint8_t>(vertexCount);
+        batch.state.prim.type = type;
+        batch.state.context.scissor = {0, 255, 0, 255};
+        return batch;
+    }
+
+    // ---- flat sprite fast path vs one POINT per pixel (the per-pixel WritePixel path) ----
+
+    struct FlatCase
+    {
+        uint8_t fpsm;
+        uint64_t test;
+        bool zmask;
+        bool fge;
+        bool fba;
+        uint8_t alpha;
+        uint32_t fbmsk;
+        bool abe;
+    };
+
+    std::string describe(const FlatCase &c)
+    {
+        return "fpsm=" + std::to_string(c.fpsm) + " test=" + std::to_string(c.test) + " zmask=" + std::to_string(c.zmask) +
+               " fge=" + std::to_string(c.fge) + " fba=" + std::to_string(c.fba) + " alpha=" + std::to_string(c.alpha) +
+               " fbmsk=" + std::to_string(c.fbmsk) + " abe=" + std::to_string(c.abe);
+    }
+
+    void prepareFlat(GSPrimitiveBatch &batch, const FlatCase &c)
+    {
+        auto &state = batch.state;
+        state.context.frame.fbp = 100;
+        state.context.frame.fbw = 2;
+        state.context.frame.psm = c.fpsm;
+        state.context.frame.fbmsk = c.fbmsk;
+        state.context.zbuf.zbp = 120;
+        state.context.zbuf.psm = GS_PSM_Z32;
+        state.context.zbuf.zmask = c.zmask;
+        state.context.test = c.test;
+        state.context.fba = c.fba ? 1 : 0;
+        state.context.alpha = (uint64_t(0x40) << 32) | 0x44u;
+        state.prim.fge = c.fge;
+        state.prim.abe = c.abe;
+        state.fogR = 10;
+        state.fogG = 200;
+        state.fogB = 90;
+        for (auto &v : batch.vertices)
+        {
+            v.r = 0x90;
+            v.g = 0x33;
+            v.b = 0xE1;
+            v.a = c.alpha;
+            v.z = 0x123456;
+            v.fog = 0x60;
+        }
+    }
+
+    void checkFlatCase(TestCase &t, const FlatCase &c)
+    {
+        Raster fast;
+        Raster slow;
+
+        GSPrimitiveBatch sprite = baseBatch(GS_PRIM_SPRITE, 2);
+        prepareFlat(sprite, c);
+        sprite.vertices[0].x = 5;
+        sprite.vertices[0].y = 7;
+        sprite.vertices[1].x = 29;
+        sprite.vertices[1].y = 22;
+        fast.backend.Submit(sprite);
+
+        for (int y = 7; y < 22; ++y)
+        {
+            for (int x = 5; x < 29; ++x)
+            {
+                GSPrimitiveBatch point = baseBatch(GS_PRIM_POINT, 1);
+                prepareFlat(point, c);
+                point.vertices[0].x = static_cast<float>(x);
+                point.vertices[0].y = static_cast<float>(y);
+                slow.backend.Submit(point);
+            }
+        }
+        t.IsTrue(sameVram(fast, slow), "flat sprite fast path differs from per-pixel writes: " + describe(c));
+    }
+
+    // ---- textured sprite with the per-draw texel cache vs the same draw without it ----
+
+    struct TexturedCase
+    {
+        uint8_t tpsm;
+        bool linear;
+        uint64_t clamp;
+        uint32_t fbp; // overlaps the texture when small
+        uint16_t u1;
+        uint16_t v1;
+    };
+
+    void checkTexturedCase(TestCase &t, const TexturedCase &c)
+    {
+        Raster cached;
+        Raster plain;
+        plain.backend.SetTexelCacheEnabled(false);
+
+        GSPrimitiveBatch sprite = baseBatch(GS_PRIM_SPRITE, 2);
+        auto &state = sprite.state;
+        state.prim.tme = true;
+        state.prim.fst = true;
+        state.prim.abe = true;
+        state.context.frame.fbp = c.fbp;
+        state.context.frame.fbw = 4;
+        state.context.frame.psm = GS_PSM_CT32;
+        state.context.zbuf.zbp = 300;
+        state.context.zbuf.zmask = true;
+        state.context.test = 1ull << 17; // ZTST = ALWAYS
+        state.context.alpha = (uint64_t(0x40) << 32) | 0x44u;
+        state.context.tex0.tbp0 = 0;
+        state.context.tex0.tbw = 4;
+        state.context.tex0.psm = c.tpsm;
+        state.context.tex0.tw = 8;
+        state.context.tex0.th = 8;
+        state.context.tex0.tcc = 1;
+        state.context.tex0.tfx = 1;
+        state.context.clamp = c.clamp;
+        state.textureWidth = state.textureHeight = 256;
+        state.texa.ta0 = 0x10;
+        state.texa.ta1 = 0x90;
+        state.linearFilter = c.linear;
+        for (auto &v : sprite.vertices)
+            v.r = v.g = v.b = v.a = 0x80;
+        sprite.vertices[0].x = 3;
+        sprite.vertices[0].y = 4;
+        sprite.vertices[1].x = 3 + 200;
+        sprite.vertices[1].y = 4 + 150;
+        sprite.vertices[0].u = 0;
+        sprite.vertices[0].v = 0;
+        sprite.vertices[1].u = c.u1;
+        sprite.vertices[1].v = c.v1;
+
+        cached.backend.Submit(sprite);
+        plain.backend.Submit(sprite);
+        const std::string label = " tpsm=" + std::to_string(c.tpsm) + " linear=" + std::to_string(c.linear) +
+                                  " clamp=" + std::to_string(c.clamp) + " fbp=" + std::to_string(c.fbp);
+        t.IsTrue(sameVram(cached, plain), "texel cache changed the result:" + label);
+    }
+}
+
+void register_ps2_gs_raster_tests()
+{
+    MiniTest::Case("PS2GSRaster", [](TestCase &tc)
+    {
+        tc.Run("flat sprite fast path matches per-pixel writes", [](TestCase &t)
+        {
+            const uint64_t ztestAlways = 1ull << 17;
+            const uint64_t ztestNever = 0ull;
+            const uint64_t ztestGequal = 2ull << 17;
+            const uint64_t ateGreater = 1ull | (6ull << 1) | (0x40ull << 4); // ATE, ATST=GREATER, AREF=0x40
+            for (uint8_t fpsm : {uint8_t(GS_PSM_CT32), uint8_t(GS_PSM_CT24), uint8_t(GS_PSM_CT16)})
+            {
+                for (uint64_t ztest : {ztestAlways, ztestNever, ztestGequal})
+                {
+                    for (uint64_t alphaTest : {0ull, ateGreater, ateGreater | (1ull << 12), ateGreater | (2ull << 12), ateGreater | (3ull << 12)})
+                    {
+                        for (uint8_t alpha : {uint8_t(0x20), uint8_t(0xC0)})
+                        {
+                            for (bool zmask : {false, true})
+                            {
+                                for (bool fge : {false, true})
+                                {
+                                    checkFlatCase(t, {fpsm, ztest | alphaTest, zmask, fge, (fpsm != GS_PSM_CT24) && fge, alpha, 0u, false});
+                                }
+                            }
+                        }
+                    }
+                }
+                checkFlatCase(t, {fpsm, 1ull << 17, true, false, false, 0x80, 0x00FF00FFu, false}); // frame mask
+                checkFlatCase(t, {fpsm, 1ull << 17, true, false, false, 0x80, 0u, true});           // alpha blend
+                checkFlatCase(t, {fpsm, (1ull << 17) | (1ull << 14), true, false, false, 0x80, 0u, false}); // DATE
+            }
+        });
+
+        tc.Run("texel cache returns exactly what uncached sampling returns", [](TestCase &t)
+        {
+            const uint64_t repeat = 0;
+            const uint64_t clamp = 5;
+            const uint64_t regionClamp = 2ull | (2ull << 2) | (7ull << 4) | (230ull << 14) | (5ull << 24) | (200ull << 34);
+            for (uint8_t tpsm : {uint8_t(GS_PSM_CT32), uint8_t(GS_PSM_CT16)})
+            {
+                for (bool linear : {false, true})
+                {
+                    for (uint64_t wrap : {repeat, clamp, regionClamp})
+                    {
+                        // Disjoint from the texture, then a frame buffer inside the texture's own pages.
+                        for (uint32_t fbp : {uint32_t(200), uint32_t(10)})
+                        {
+                            checkTexturedCase(t, {tpsm, linear, wrap, fbp, 200u * 16u, 150u * 16u});
+                            checkTexturedCase(t, {tpsm, linear, wrap, fbp, 255u * 16u, 255u * 16u});
+                            checkTexturedCase(t, {tpsm, linear, wrap, fbp, 90u * 16u, 60u * 16u});
+                        }
+                    }
+                }
+            }
+        });
+    });
+}
