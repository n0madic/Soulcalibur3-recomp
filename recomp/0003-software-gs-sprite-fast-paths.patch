+// Fast path of WritePixel for a constant colour that needs no read of the frame or depth buffer. It follows
+// WritePixel step by step with the per-pixel decisions made once; false means "use WritePixel".
+bool GSCpuBackend::FillFlatRect(const GSDrawState &state, int x0, int y0, int x1, int y1, int z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog)
+{
+    const auto &ctx = state.context;
+    const u32 fpsm = ctx.frame.psm;
+    if (state.prim.abe || ctx.frame.fbmsk != 0)
+        return false;
+
+    const bool destinationAlphaTest = ((ctx.test >> 14) & 0x1u) != 0u;
+    if (destinationAlphaTest && (fpsm == GS_PSM_CT32 || fpsm == GS_PSM_CT16 || fpsm == GS_PSM_CT16S))
+        return false;
+
+    const uint32_t ztestMethod = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+    if (ztestMethod >= 2u)
+        return false;
+
+    if (state.prim.fge)
+    {
+        const uint32_t inverseFog = 255u - fog;
+        auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+        {
+            return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+        };
+        r = applyFog(r, state.fogR);
+        g = applyFog(g, state.fogG);
+        b = applyFog(b, state.fogB);
+    }
+
+    const PixelWriteMask writeMask = classifyAlphaTest(ctx.test, a, static_cast<uint8_t>(fpsm));
+    if (!writeMask.writesAnything() || ztestMethod == 0u)
+        return true; // every pixel is rejected
+    if (writeMask.writeRgb && !writeMask.writeAlpha && fpsm == GS_PSM_CT32)
+        return false; // keeps the destination alpha, which needs a read
+
+    const u32 fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    const u32 fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    const u32 zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    const u32 zpsm = ctx.zbuf.psm;
+
+    const bool writeFrame = writeMask.writesFramebuffer();
+    u32 pixel = 0u;
+    if (writeFrame)
+    {
+        uint8_t storedAlpha = a;
+        if (writeMask.writeAlpha && (ctx.fba & 0x1ull) != 0ull && fpsm != GS_PSM_CT24)
+            storedAlpha = static_cast<uint8_t>(a | 0x80u);
+        pixel = pack32(r, g, b, storedAlpha);
+        if (bitsPerPixel(fpsm) == 16)
+            pixel = Rgba8888ToRgba5551(pixel);
+    }
+    const bool writeZ = writeMask.writeDepth && !ctx.zbuf.zmask;
+
+    const WriteVramFunc writeFrameFunc = m_writeVramFuncs[fpsm & 0x3Fu];
+    const WriteVramFunc writeZFunc = m_writeVramFuncs[zpsm & 0x3Fu];
+    for (int y = y0; y <= y1; ++y)
+    {
+        for (int x = x0; x <= x1; ++x)
+        {
+            if (writeFrame)
+                writeFrameFunc(m_vram, fbp, fbw, x, y, pixel);
+            if (writeZ)
+                writeZFunc(m_vram, zbp, fbw, x, y, static_cast<u32>(z));
+        }
+    }
+    return true;
+}
