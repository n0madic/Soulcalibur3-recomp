+// Whether sprites (rectangles in subpixels) draw the whole display: they span its size (to a few pixels,
+// the blit may leave out the margins) and leave no gap as big as a cell between them. The cells let the
+// seams between the tiles of a blit be, while a tile that is missing is found.
+static bool blit_covers_display(const std::vector<ivec4> &rects, ivec2 display_size)
+{
+	constexpr int cell_bits = 3 + PGS_SUBPIXEL_BITS; // 8x8 pixels
+	constexpr int slack_pixels = 8;
+
+	if (rects.empty())
+		return false;
+
+	ivec2 lo = ivec2(INT32_MAX);
+	ivec2 hi = ivec2(INT32_MIN);
+	for (auto &rect : rects)
+	{
+		lo = muglm::min(lo, rect.xy());
+		hi = muglm::max(hi, rect.zw());
+	}
+
+	ivec2 size = (hi - lo) >> PGS_SUBPIXEL_BITS;
+	if (size.x + slack_pixels < display_size.x || size.y + slack_pixels < display_size.y)
+		return false;
+
+	int cells_x = ((hi.x - lo.x) >> cell_bits) + 1;
+	int cells_y = ((hi.y - lo.y) >> cell_bits) + 1;
+	std::vector<uint8_t> covered(size_t(cells_x) * size_t(cells_y), 0);
+	for (auto &rect : rects)
+	{
+		ivec2 first = (rect.xy() - lo) >> cell_bits;
+		ivec2 last = (rect.zw() - lo - 1) >> cell_bits;
+		for (int y = first.y; y <= last.y; y++)
+			for (int x = first.x; x <= last.x; x++)
+				covered[size_t(y) * size_t(cells_x) + size_t(x)] = 1;
+	}
+
+	// The cells at the far edges are partial; the ones inside the rectangle must all be covered.
+	for (int y = 0; y < cells_y; y++)
+		for (int x = 0; x < cells_x; x++)
+			if (!covered[size_t(y) * size_t(cells_x) + size_t(x)] && x + 1 < cells_x && y + 1 < cells_y)
+				return false;
+
+	return true;
+}
