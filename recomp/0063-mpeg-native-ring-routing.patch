diff --git a/ps2xTest/src/ps2_runtime_expansion_tests.cpp b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
index c68bcc0..167635e 100644
--- a/ps2xTest/src/ps2_runtime_expansion_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
@@ -333,6 +333,52 @@ namespace
         ctx->pc = 0u;
         runtime->requestStop();
     }
+    constexpr uint32_t kSwitchMain = 0x125400u;
+    constexpr uint32_t kSwitchSecond = 0x125410u;
+    constexpr uint32_t kSwitchBack = 0x125420u;
+    constexpr uint32_t kSwitchDone = 0x125430u;
+    constexpr uint32_t kSwitchCallback = 0x125440u;
+    uint32_t switchPendingBefore = 0, switchPendingAfter = 0, switchStage = 0;
+    bool switchUseCache = true;
+    unsigned switchFirstInputCount = 0;
+
+    void testSwitchMain(uint8_t *ram, R5900Context *ctx, PS2Runtime *rt)
+    {
+        setRegU32(*ctx, 4, kMultiMpeg); setRegU32(*ctx, 5, 0x190000u);
+        ctx->pc = kSwitchSecond; ps2_stubs::sceMpegGetPicture(ram,ctx,rt);
+    }
+    void testSwitchSecond(uint8_t *ram, R5900Context *ctx, PS2Runtime *rt)
+    {
+        setRegU32(*ctx, 4, kMultiMpeg+0x1000u); setRegU32(*ctx, 5, 0x1a0000u);
+        ctx->pc = kSwitchBack; ps2_stubs::sceMpegGetPicture(ram,ctx,rt);
+    }
+    void testSwitchBack(uint8_t *ram, R5900Context *ctx, PS2Runtime *rt)
+    {
+        switchStage=1;
+        switchPendingBefore=rt->memory().readIORegister(0x1000b430u);
+        setRegU32(*ctx, 4, kMultiMpeg); setRegU32(*ctx, 5, 0x190000u);
+        ctx->pc = kSwitchDone; ps2_stubs::sceMpegGetPicture(ram,ctx,rt);
+    }
+    void testSwitchDone(uint8_t *, R5900Context *ctx, PS2Runtime *rt)
+    {
+        switchStage=2;
+        switchPendingAfter=rt->memory().readIORegister(0x1000b430u);
+        ctx->pc = 0;rt->requestStop();
+    }
+    void testSwitchCallback(uint8_t *, R5900Context *ctx, PS2Runtime *rt)
+    {
+        const bool first=getRegU32(ctx,4)==kMultiMpeg;
+        auto &mem=rt->memory();
+        mem.writeIORegister(0x1000b400u,0u);
+        if (first) ++switchFirstInputCount;
+        mem.writeIORegister(0x1000b410u,first ? 0x184000u : 0x180000u);
+        const unsigned copies = switchUseCache ? 2u : 1u;
+        mem.writeIORegister(0x1000b420u,first ? (copies*sizeof(kIpuFixtureM2v)+15u)/16u : 0u);
+        mem.writeIORegister(0x1000b430u,0x181000u);
+        mem.writeIORegister(0x1000b400u,first ? 0x101u : 0x105u);
+        ctx->pc = 0;
+    }
+
 #endif
 
 }
@@ -908,6 +954,69 @@ void register_ps2_runtime_expansion_tests()
             t.Equals(Ps2FastRead32(rdram, kMultiMpeg + 0x1000u), 0u, "idle second player stays unused");
             t.Equals(mem.readIORegister(0x1000b420u), 0u, "selected decoder drains pending DMA");
         });
+        tc.Run("switching MPEG players preserves ownership of backpressured DMA", [](TestCase &t)
+        {
+            for (bool cached : {true, false})
+            {
+            switchUseCache = cached;
+            switchFirstInputCount = 0;
+            PS2Runtime rt;
+            t.IsTrue(rt.memory().initialize(), "memory initialization");
+            auto &mem=rt.memory();auto ram=mem.getRDRAM();
+            ps2_stubs::resetMpegStubState();
+            switchStage=0; switchPendingBefore=0; switchPendingAfter=0;
+            for (uint32_t i=0;i<2;++i)
+            {
+                R5900Context ctx{};
+                setRegU32(ctx,4,kMultiMpeg+i*0x1000u);
+                setRegU32(ctx,5,0x150000u+i*0x10000u);setRegU32(ctx,6,0x4000u);
+                ps2_stubs::sceMpegCreate(ram,&ctx,&rt);
+                setRegU32(ctx,4,kMultiMpeg+i*0x1000u);setRegU32(ctx,5,1u);
+                setRegU32(ctx,6,kSwitchCallback);setRegU32(ctx,7,0u);
+                ps2_stubs::sceMpegAddCallback(ram,&ctx,&rt);
+                const uint32_t data = i == 0u ? 0x184000u : 0x180000u;
+                const uint32_t tags = data + 0x1000u;
+                Ps2FastWrite32(ram,kMultiMpeg+i*0x1000u+0x48u,data);
+                Ps2FastWrite32(ram,kMultiMpeg+i*0x1000u+0x4cu,tags | 0x20000000u);
+                Ps2FastWrite32(ram,kMultiMpeg+i*0x1000u+0x60u,0x1000u);
+            }
+            std::memset(ram+0x191000u,0xA5,64u); // red zone after the 32x32 output
+            std::memcpy(ram+0x180000u,kIpuFixture64M2v,sizeof(kIpuFixture64M2v));
+            std::memcpy(ram+0x184000u,kIpuFixtureM2v,sizeof(kIpuFixtureM2v));
+            if (cached)
+                std::memcpy(ram+0x184000u+sizeof(kIpuFixtureM2v),kIpuFixtureM2v,sizeof(kIpuFixtureM2v));
+            const uint32_t qwc=(sizeof(kIpuFixture64M2v)+15u)/16u;
+            for(uint32_t i=0;i<20;++i)
+            {
+                const uint64_t tag=(uint64_t(0x180000u)<<32u)|(uint64_t(i==19?0u:3u)<<28u)|qwc;
+                std::memcpy(ram+0x181000u+i*16u,&tag,8);
+            }
+            rt.registerFunction(kSwitchMain,testSwitchMain);
+            rt.registerFunction(kSwitchSecond,testSwitchSecond);
+            rt.registerFunction(kSwitchBack,testSwitchBack);
+            rt.registerFunction(kSwitchDone,testSwitchDone);
+            rt.registerFunction(kSwitchCallback,testSwitchCallback);
+            rt.registerFunction(kMultiWatchdog,testStopAfterMpegCallback);
+            R5900Context main{};main.pc=kSwitchMain;
+            auto &ee=rt.eeScheduler();ee.reset(ram,main);
+            const int wd=ee.createThread(EeThreadCreateParams{0,kMultiWatchdog,0,0,0,10,0});
+            ee.startThread(wd,0,main,false);ee.run();
+            t.Equals(switchStage,2u,"switching A to B and back must finish");
+            t.IsTrue(switchPendingBefore>0x181000u && switchPendingBefore<0x181140u,"B must have a backpressured chain");
+            if (cached)
+                t.Equals(switchPendingAfter,switchPendingBefore,"returning cached A must leave B's DMA untouched");
+            else
+                t.Equals(switchPendingAfter,0x181000u,"empty A must restore its own input, not consume B's chain");
+            t.Equals(switchFirstInputCount,cached ? 1u : 2u,"only empty A requests its own new input");
+            t.Equals(Ps2FastRead32(ram,kMultiMpeg),32u,"small player keeps its own width");
+            t.Equals(Ps2FastRead32(ram,kMultiMpeg+0x1000u),64u,"large player keeps its own width");
+            bool redZoneIntact = true;
+            for (unsigned i = 0; i < 64u; ++i)
+                redZoneIntact &= ram[0x191000u+i] == 0xA5u;
+            t.IsTrue(redZoneIntact,"larger B picture must never overwrite A's smaller output buffer");
+            }
+        });
+
 #endif
 
         tc.Run("sceMpegCreate clears the end-of-stream word that libmpeg's sceMpegIsEnd reads", [](TestCase &t)
