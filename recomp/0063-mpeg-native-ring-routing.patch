From a0f3d65339f4806ad5b1b7f23a99af29eb1a3a5f Mon Sep 17 00:00:00 2001
From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Sat, 24 Oct 2026 23:50:45 +0300
Subject: [PATCH] MPEG: route native IPU transfers by their source ring

The Single Player menu runs two native Sofdec decoders. Guest code can
restore either one's DMA before its next GetPicture. Routing every byte
to the last requested decoder mixed the streams: a 256x384 preview was
written into a 128x192 buffer, corrupting the MPEG context and main-thread
return address when switching menu items.

Resolve source-chain tags (or MADR for a remainder/normal transfer) and
match the source against validated guest ES-ring descriptors. Preserve
the existing GetPicture fallback for feeders without a recognized ring.

Add a synthetic two-size regression for cached and empty picture queues,
backpressured DMA, and the small output buffer's red zone. It fails with
the previous runtime. The CPU-GS suite runs 530 tests, with 528 passing
and the two previously recorded VIF packet/MPEG callback failures.
---
 ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp    |  49 ++++++++-
 ps2xTest/src/mpeg_ipu_fixture_m2v.h          |  19 ++++
 ps2xTest/src/ps2_runtime_expansion_tests.cpp | 109 +++++++++++++++++++
 3 files changed, 176 insertions(+), 1 deletion(-)

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
index 8da6d28..8e01877 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/MPEG.cpp
@@ -1594,6 +1594,51 @@ namespace ps2_stubs
             return accepting;
         }
 
+        // Sofdec keeps the native ES ring in the libmpeg context: data at
+        // +0x48, its adjacent DMA-tag array at +0x4c and its byte length at
+        // +0x60. Validate that layout before using it; feeders without a
+        // recognized native ring retain the GetPicture-selected fallback.
+        // Called with g_mpeg_stub_mutex held.
+        uint32_t nativeIpuInputOwner(PS2Runtime *runtime, uint32_t fallback)
+        {
+            auto &memory = runtime->memory();
+            const uint32_t chcr = memory.readIORegister(0x1000B400u);
+            uint32_t source = memory.readIORegister(0x1000B410u) & 0x1FFFFFFFu;
+            if (((chcr >> 2u) & 3u) == 1u && memory.readIORegister(0x1000B420u) == 0u)
+            {
+                const uint32_t tagAddr = memory.readIORegister(0x1000B430u) & 0x1FFFFFFFu;
+                if (tagAddr > PS2_RAM_SIZE - 16u)
+                    return fallback;
+                uint64_t tag = 0;
+                std::memcpy(&tag, memory.getRDRAM() + tagAddr, sizeof(tag));
+                const uint32_t id = (tag >> 28u) & 7u;
+                if (id == 0u || id == 3u || id == 4u)
+                    source = static_cast<uint32_t>(tag >> 32u) & 0x1FFFFFFFu;
+                else if (id == 1u || id == 2u || id == 7u)
+                    source = tagAddr + 16u;
+                else
+                    return fallback;
+            }
+            for (const auto &[mpeg, playback] : g_mpeg_stub_state.playbackByMpeg)
+            {
+                if (playback.hleInput || mpeg > PS2_RAM_SIZE - 0x64u)
+                    continue;
+                const uint8_t *mp = memory.getRDRAM() + mpeg;
+                uint32_t data, tags, bytes;
+                std::memcpy(&data, mp + 0x48u, sizeof(data));
+                std::memcpy(&tags, mp + 0x4cu, sizeof(tags));
+                std::memcpy(&bytes, mp + 0x60u, sizeof(bytes));
+                data &= 0x1FFFFFFFu;
+                tags &= 0x1FFFFFFFu;
+                if (data == 0u || data >= PS2_RAM_SIZE || bytes == 0u || bytes > PS2_RAM_SIZE - data ||
+                    tags != data + bytes || (data & 15u) != 0u || (tags & 15u) != 0u)
+                    continue;
+                if (source >= data && source - data < bytes)
+                    return mpeg;
+            }
+            return fallback;
+        }
+
         void installIpuInputSink(PS2Runtime *runtime)
         {
             runtime->memory().setIpuInputSink([runtime](const uint8_t *data, size_t size)
@@ -1601,7 +1646,9 @@ namespace ps2_stubs
                 uint32_t active;
                 {
                     std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
-                    active = g_mpeg_stub_state.ipuInputMpeg;
+                    // A guest can restart a different player's saved DMA before
+                    // calling its GetPicture. Route by the actual source ring.
+                    active = nativeIpuInputOwner(runtime, g_mpeg_stub_state.ipuInputMpeg);
                 }
                 // The hardware FIFO stalls until a decoder consumes it. Creating
                 // another work area does not select that decoder for playback.
