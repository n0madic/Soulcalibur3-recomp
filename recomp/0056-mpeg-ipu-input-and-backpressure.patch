+bool PS2Memory::tryProcessIpuInputDma(uint32_t channelBase, uint32_t chcr)
+{
+    static constexpr uint32_t kToIpuChannel = 0x1000B400u;
+    static constexpr uint32_t kToIpuCause = 4u;
+    static constexpr uint32_t kTagRefe = 0u;
+    static constexpr uint32_t kTagCnt = 1u;
+    static constexpr uint32_t kTagNext = 2u;
+    static constexpr uint32_t kTagRef = 3u;
+    static constexpr uint32_t kTagRefs = 4u;
+    static constexpr uint32_t kTagEnd = 7u;
+    // A ring of tags never ends on its own; stop rather than spin on a malformed chain.
+    static constexpr uint32_t kMaxTags = 0x10000u;
+    if (channelBase != kToIpuChannel || !m_ipuInputSink)
+        return false;
+
+    // A restart can occur while pictures are still queued. Do not consume another
+    // tag (especially past a previous REFE) until the decoder can accept input.
+    if (!m_ipuInputSink(nullptr, 0u))
+        return true;
+
+    const uint32_t mode = (chcr >> 2u) & 0x3u;
+    if (mode > 1u)
+        return false;
+
+    enum class Sent
+    {
+        Fault,
+        More,
+        Full,
+    };
+    // Hands guest memory to the sink, which says whether the IPU input FIFO can take more.
+    auto send = [this](uint32_t addr, uint32_t qwc)
+    {
+        if (qwc == 0u)
+            return Sent::More;
+        uint32_t offset = 0u;
+        try
+        {
+            offset = translateAddress(addr & 0x7FFFFFF0u);
+        }
+        catch (const std::exception &)
+        {
+            return Sent::Fault;
+        }
+        const uint32_t bytes = qwc * 16u;
+        if (offset > PS2_RAM_SIZE || bytes > PS2_RAM_SIZE - offset)
+            return Sent::Fault;
+        return m_ipuInputSink(m_rdram + offset, bytes) ? Sent::More : Sent::Full;
+    };
+
+    uint32_t madr = m_ioRegisters[channelBase + 0x10u] & 0x7FFFFFF0u;
+    const uint32_t remainingQwc = m_ioRegisters[channelBase + 0x20u] & 0xFFFFu;
+    uint32_t tadr = m_ioRegisters[channelBase + 0x30u] & 0x7FFFFFF0u;
+    uint32_t tagUpper = chcr >> 16u;
+
+    // Normal mode, or the rest of a chain transfer that was stopped part way.
+    Sent sent = send(madr, remainingQwc);
+    if (sent == Sent::Fault)
+        return false;
+    madr += remainingQwc * 16u;
+
+    // A chain goes on with the tag at TADR unless that remainder belonged to an end tag.
+    const uint32_t startTagId = (chcr >> 28u) & 0x7u;
+    bool ended = mode == 0u || (remainingQwc != 0u && (startTagId == kTagRefe || startTagId == kTagEnd));
+    for (uint32_t tags = 0u; !ended && sent == Sent::More && tags < kMaxTags; ++tags)
+    {
+        uint32_t tagOffset = 0u;
+        try
+        {
+            tagOffset = translateAddress(tadr);
+        }
+        catch (const std::exception &)
+        {
+            return false;
+        }
+        if (tagOffset > PS2_RAM_SIZE - 16u)
+            return false;
+
+        uint64_t tag = 0u;
+        std::memcpy(&tag, m_rdram + tagOffset, sizeof(tag));
+        const uint32_t tagQwc = static_cast<uint32_t>(tag & 0xFFFFu);
+        const uint32_t tagAddr = static_cast<uint32_t>(tag >> 32u) & 0x7FFFFFF0u;
+        const uint32_t tagId = static_cast<uint32_t>(tag >> 28u) & 0x7u;
+        tagUpper = static_cast<uint32_t>(tag >> 16u) & 0xFFFFu;
+
+        uint32_t dataAddr = tagAddr;
+        uint32_t nextTadr = tadr + 16u;
+        switch (tagId)
+        {
+        case kTagRefe:
+        case kTagRef:
+        case kTagRefs:
+            break;
+        case kTagCnt:
+            dataAddr = tadr + 16u;
+            nextTadr = dataAddr + tagQwc * 16u;
+            break;
+        case kTagNext:
+            dataAddr = tadr + 16u;
+            nextTadr = tagAddr;
+            break;
+        case kTagEnd:
+            dataAddr = tadr + 16u;
+            break;
+        default:
+            return false; // CALL/RET need the address stack, which no IPU feeder uses
+        }
+
+        sent = send(dataAddr, tagQwc);
+        if (sent == Sent::Fault)
+            return false;
+        madr = dataAddr + tagQwc * 16u;
+        tadr = nextTadr;
+
+        const bool irqStop = (chcr & 0x80u) != 0u && (tag & 0x80000000u) != 0u;
+        ended = tagId == kTagRefe || tagId == kTagEnd || irqStop;
+    }
+
+    m_ioRegisters[channelBase + 0x10u] = madr;
+    m_ioRegisters[channelBase + 0x20u] = 0u;
+    if (mode == 1u)
+    {
+        m_ioRegisters[channelBase + 0x30u] = tadr;
+        m_ioRegisters[channelBase] = (chcr & 0xFFFFu) | (tagUpper << 16u); // CHCR.TAG holds the last tag's upper half
+    }
+    // With the FIFO full a chain stalls at a tag boundary and stays running; the guest stops and
+    // restarts it.
+    if (ended || mode == 0u)
+        completeDmacChannel(channelBase, kToIpuCause);
+    return true;
+}
+
