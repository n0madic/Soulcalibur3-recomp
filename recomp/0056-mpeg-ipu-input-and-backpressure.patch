+            bool wakePictureWaiter = false;
+            bool accepting = true;
+            {
+                std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
+                auto it = g_mpeg_stub_state.playbackByMpeg.find(mpegAddr);
+                if (it == g_mpeg_stub_state.playbackByMpeg.end() || it->second.hleInput)
+                {
+                    return true; // the stub already demuxes this stream from the data it was given
+                }
+                MpegPlaybackState &playback = it->second;
+                if (size == 0u)
+                    return playback.decodedFrames.size() < kMaxDecodedPicturesAhead;
+                const size_t framesBefore = playback.decodedFrames.size();
+                feedElementaryStream(playback, data, size);
+                wakePictureWaiter = playback.decodedFrames.size() != framesBefore || playback.decoderFailed;
+                accepting = playback.decodedFrames.size() < kMaxDecodedPicturesAhead;
+            }
+            if (wakePictureWaiter)
