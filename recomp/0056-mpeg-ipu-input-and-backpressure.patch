+            {
+                std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
+                MpegPlaybackState &playback = getPlaybackState(mpegAddr);
+                if (!playback.streamEnded && libmpegInputEnded(rdram, mpegAddr))
