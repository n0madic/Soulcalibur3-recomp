diff --git a/ps2xTest/src/ps2_memory_tests.cpp b/ps2xTest/src/ps2_memory_tests.cpp
index e38b939..60ae1d3 100644
--- a/ps2xTest/src/ps2_memory_tests.cpp
+++ b/ps2xTest/src/ps2_memory_tests.cpp
@@ -2352,6 +2352,154 @@ void register_ps2_memory_tests()
             t.Equals(mem.readIORegister(kFromSpr + 0x00u) & 0x1u, 0u, "fromSPR is a transfer to memory (DIR = 0)");
         });
 
+        tc.Run("toIPU chain DMA hands the REF and REFE sectors to the IPU input sink", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            t.IsTrue(runtime.memory().initialize(), "PS2Memory initialize should succeed");
+
+            // Soulcalibur III's Sofdec (CRI MPV) keeps the video bitstream in a ring of 2 KiB sectors, one
+            // REF tag per sector and a REFE on the last, and starts channel 4 with CHCR = 0x105.
+            constexpr uint32_t kToIpu = 0x1000B400u;
+            constexpr uint32_t kTags = 0x00040000u;
+            constexpr uint32_t kSectorA = 0x00050000u;
+            constexpr uint32_t kSectorB = 0x00051000u;
+            PS2Memory &mem = runtime.memory();
+            uint8_t *rdram = mem.getRDRAM();
+            for (uint32_t i = 0; i < 0x800u; ++i)
+            {
+                rdram[kSectorA + i] = static_cast<uint8_t>(i);
+                rdram[kSectorB + i] = static_cast<uint8_t>(0xFFu - i);
+            }
+            writeDmaTag(rdram, kTags + 0x00u, makeDmaTag(0x80u, 3u, kSectorA)); // REF
+            writeDmaTag(rdram, kTags + 0x10u, makeDmaTag(0x80u, 0u, kSectorB)); // REFE
+
+            std::vector<uint8_t> received;
+            mem.setIpuInputSink([&received](const uint8_t *data, size_t size)
+                                {
+                                    received.insert(received.end(), data, data + size);
+                                    return true;
+                                });
+            t.IsTrue(mem.writeIORegister(kToIpu + 0x30u, kTags), "writing D4_TADR should succeed");
+            t.IsTrue(mem.writeIORegister(kToIpu + 0x20u, 0u), "writing D4_QWC should succeed");
+            t.IsTrue(mem.writeIORegister(kToIpu + 0x00u, 0x105u), "starting D4 should succeed");
+
+            t.Equals(received.size(), static_cast<size_t>(0x1000u), "both sectors should reach the sink");
+            t.IsTrue(received.size() == 0x1000u &&
+                         std::memcmp(received.data(), rdram + kSectorA, 0x800u) == 0 &&
+                         std::memcmp(received.data() + 0x800u, rdram + kSectorB, 0x800u) == 0,
+                     "the sectors should arrive in tag order");
+            t.Equals(mem.readIORegister(kToIpu + 0x00u) & 0x100u, 0u, "the transfer should have ended");
+            t.Equals((mem.readIORegister(kToIpu + 0x00u) >> 28u) & 0x7u, 0u, "CHCR.TAG should hold the REFE");
