From 392b839d9a00782fd58031be85e23b9ddd78fbb4 Mon Sep 17 00:00:00 2001
From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Fri, 23 Oct 2026 17:55:25 +0300
Subject: [PATCH] Pad: read the keyboard alongside a gamepad; Escape no longer
 closes the window

Escape was both the Circle key and raylib's default exit key, so backing
out of a menu quit the game. The keyboard was also ignored whenever a
gamepad was reported as connected. PSPadBackend::readState now takes its
host input queries as a struct so tests can fake them.
---
 ps2xRuntime/include/runtime/ps2_pad.h |  13 +++
 ps2xRuntime/src/lib/ps2_pad.cpp       | 109 ++++++++++++++------------
 ps2xRuntime/src/lib/ps2_runtime.cpp   |   1 +
 ps2xTest/src/pad_input_tests.cpp      |  53 +++++++++++++
 4 files changed, 124 insertions(+), 52 deletions(-)

diff --git a/ps2xRuntime/include/runtime/ps2_pad.h b/ps2xRuntime/include/runtime/ps2_pad.h
index 7755fe6..f44281a 100644
--- a/ps2xRuntime/include/runtime/ps2_pad.h
+++ b/ps2xRuntime/include/runtime/ps2_pad.h
@@ -10,7 +10,20 @@ public:
     PSPadBackend() = default;
     ~PSPadBackend() = default;
 
+    // Host input queries, raylib's by default; tests pass fakes.
+    struct HostInput
+    {
+        bool (*isKeyDown)(int key);
+        bool (*isGamepadAvailable)(int gamepad);
+        bool (*isGamepadButtonDown)(int gamepad, int button);
+        float (*getGamepadAxisMovement)(int gamepad, int axis);
+    };
+
+    // Escape is a pad button, so no key closes the window (raylib KEY_NULL).
+    static constexpr int kHostExitKey = 0;
+
     bool readState(int port, int slot, uint8_t *data, size_t size);
+    static bool readState(const HostInput &input, uint8_t *data, size_t size);
 };
 
 #endif
diff --git a/ps2xRuntime/src/lib/ps2_pad.cpp b/ps2xRuntime/src/lib/ps2_pad.cpp
index 8590f14..a8e3db3 100644
--- a/ps2xRuntime/src/lib/ps2_pad.cpp
+++ b/ps2xRuntime/src/lib/ps2_pad.cpp
@@ -26,6 +26,12 @@ namespace
 }
 
 bool PSPadBackend::readState(int /*port*/, int /*slot*/, uint8_t *data, size_t size)
+{
+    static const HostInput raylibInput{IsKeyDown, IsGamepadAvailable, IsGamepadButtonDown, GetGamepadAxisMovement};
+    return readState(raylibInput, data, size);
+}
+
+bool PSPadBackend::readState(const HostInput &input, uint8_t *data, size_t size)
 {
     if (!data || size < 32)
         return false;
@@ -39,85 +45,84 @@ bool PSPadBackend::readState(int /*port*/, int /*slot*/, uint8_t *data, size_t s
 
     uint16_t btns = 0xFFFFu;
