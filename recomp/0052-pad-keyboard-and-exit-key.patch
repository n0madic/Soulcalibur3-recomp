diff --git a/ps2xTest/src/pad_input_tests.cpp b/ps2xTest/src/pad_input_tests.cpp
index 07f9b7a..508e5bc 100644
--- a/ps2xTest/src/pad_input_tests.cpp
+++ b/ps2xTest/src/pad_input_tests.cpp
@@ -2,6 +2,8 @@
 #include "ps2_stubs.h"
 #include "ps2_syscalls.h"
 #include "Stubs/Pad.h"
+#include "runtime/ps2_pad.h"
+#include "ps2_host_backend.h"
 
 #include <vector>
 #include <cstdint>
@@ -62,12 +64,63 @@ namespace
         const uint8_t *data = rdram.data() + kPadDataAddr;
         return static_cast<uint16_t>(data[2] | (data[3] << 8));
     }
+
+    // Fake host input for PSPadBackend: one gamepad holding Circle, keyboard holding Enter and Up.
+    bool fakeKeyDown(int key)
+    {
+        return key == KEY_ENTER || key == KEY_UP;
+    }
+
+    bool fakeGamepadAvailable(int gamepad)
+    {
+        return gamepad == 0;
+    }
+
+    bool fakeGamepadButtonDown(int /*gamepad*/, int button)
+    {
+        return button == GAMEPAD_BUTTON_RIGHT_FACE_RIGHT;
+    }
+
+    float fakeGamepadAxis(int /*gamepad*/, int /*axis*/)
+    {
+        return 0.0f;
+    }
+
+    bool fakeEscapeDown(int key)
+    {
+        return key == KEY_ESCAPE;
+    }
+
+    bool fakeNoGamepad(int /*gamepad*/)
+    {
+        return false;
+    }
 }
 
 void register_pad_input_tests()
 {
     MiniTest::Case("PadInput", [](TestCase &tc)
                    {
+        tc.Run("keyboard is read while a gamepad is connected", [](TestCase &t)
+               {
+            const PSPadBackend::HostInput input{fakeKeyDown, fakeGamepadAvailable, fakeGamepadButtonDown, fakeGamepadAxis};
+            uint8_t data[32] = {};
+            t.IsTrue(PSPadBackend::readState(input, data, sizeof(data)), "readState should succeed");
+            const uint16_t buttons = static_cast<uint16_t>(data[2] | (data[3] << 8));
+            t.Equals(buttons, static_cast<uint16_t>(0xFFFFu & ~kPadBtnCircle & ~kPadBtnStart & ~kPadBtnUp),
+                     "gamepad Circle and keyboard Enter/Up should all be pressed");
+        });
+
+        tc.Run("Escape is the Circle button, not a quit key", [](TestCase &t)
+               {
+            const PSPadBackend::HostInput input{fakeEscapeDown, fakeNoGamepad, fakeGamepadButtonDown, fakeGamepadAxis};
+            uint8_t data[32] = {};
+            t.IsTrue(PSPadBackend::readState(input, data, sizeof(data)), "readState should succeed");
+            const uint16_t buttons = static_cast<uint16_t>(data[2] | (data[3] << 8));
+            t.Equals(buttons, static_cast<uint16_t>(0xFFFFu & ~kPadBtnCircle), "Escape should press Circle");
+            t.Equals(PSPadBackend::kHostExitKey, static_cast<int>(KEY_NULL), "no key may close the window");
+        });
+
         tc.Run("scePadRead uses override state", [](TestCase &t)
                {
             std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0);
