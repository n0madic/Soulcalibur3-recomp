diff --git a/ps2xRuntime/include/runtime/gs/ps2_display_rect.h b/ps2xRuntime/include/runtime/gs/ps2_display_rect.h
new file mode 100644
index 0000000..a60ddf1
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/ps2_display_rect.h
@@ -0,0 +1,26 @@
+#pragma once
+
+// The PS2 scans its display area out over the whole TV picture whatever the
+// size of the buffer behind it (DISPLAY.MAGH/MAGV magnify it), e.g. a 512x512
+// buffer with MAGH=4 fills a 4:3 PAL screen. The host therefore shows the
+// presented buffer stretched to a picture of the TV's aspect ratio, fitted
+// into the window, instead of keeping the buffer's own pixel aspect.
+struct Ps2HostRect
+{
+    float x;
+    float y;
+    float width;
+    float height;
+};
+
+inline Ps2HostRect ps2FitDisplayRect(float windowWidth, float windowHeight, float aspect = 4.0f / 3.0f)
+{
+    float width = windowWidth;
+    float height = width / aspect;
+    if (height > windowHeight)
+    {
+        height = windowHeight;
+        width = height * aspect;
+    }
+    return {(windowWidth - width) * 0.5f, (windowHeight - height) * 0.5f, width, height};
+}
