From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Tue, 27 Oct 2026 07:28:14 +0200
Subject: [PATCH] Upstream PR #343: DMAC completion handlers run after a store
 of any width

---
 ps2xRuntime/include/runtime/ps2_memory.h     |  7 ++
 ps2xRuntime/src/lib/ps2_memory.cpp           |  3 +
 ps2xRuntime/src/lib/ps2_runtime.cpp          | 13 +++-
 ps2xTest/src/ps2_runtime_interrupt_tests.cpp | 82 ++++++++++++++++++++
 4 files changed, 103 insertions(+), 2 deletions(-)

diff --git a/ps2xRuntime/include/runtime/ps2_memory.h b/ps2xRuntime/include/runtime/ps2_memory.h
index ea86a9c..070d976 100644
--- a/ps2xRuntime/include/runtime/ps2_memory.h
+++ b/ps2xRuntime/include/runtime/ps2_memory.h
@@ -345,6 +345,12 @@ public:
     void processVIF1Data(const uint8_t *data, uint32_t sizeBytes);
     void processPendingTransfers();
     std::vector<uint32_t> consumeCompletedDmacCauses();
+    // True while consumeCompletedDmacCauses has something to return. One
+    // atomic load, so callers can test it after every special-address store.
+    [[nodiscard]] bool hasCompletedDmacCauses() const noexcept
+    {
+        return m_completedDmacPending.load(std::memory_order_acquire);
+    }
 
     int pollDmaRegisters();
 
@@ -423,6 +429,7 @@ public:
     std::vector<PendingTransfer> m_pendingVif1Transfers;
     std::mutex m_completedDmacMutex;
     std::vector<uint32_t> m_completedDmacCauses;
+    std::atomic<bool> m_completedDmacPending{false};
 
     struct CodeRegion
     {
diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index 3f923a2..e752455 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -340,6 +340,7 @@ bool PS2Memory::initialize(size_t ramSize)
     {
         std::lock_guard<std::mutex> lock(m_completedDmacMutex);
         m_completedDmacCauses.clear();
+        m_completedDmacPending.store(false, std::memory_order_release);
     }
     m_codeRegions.clear();
     m_path3Masked = false;
@@ -1926,6 +1927,7 @@ void PS2Memory::queueCompletedDmacCause(uint32_t cause)
 {
     std::lock_guard<std::mutex> lock(m_completedDmacMutex);
     m_completedDmacCauses.push_back(cause);
+    m_completedDmacPending.store(true, std::memory_order_release);
 }
 
 std::vector<uint32_t> PS2Memory::consumeCompletedDmacCauses()
@@ -1933,6 +1935,7 @@ std::vector<uint32_t> PS2Memory::consumeCompletedDmacCauses()
     std::lock_guard<std::mutex> lock(m_completedDmacMutex);
     std::vector<uint32_t> causes;
     causes.swap(m_completedDmacCauses);
+    m_completedDmacPending.store(false, std::memory_order_release);
     return causes;
 }
 
diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index 2aa503a..e8e1c88 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1488,9 +1488,14 @@ void PS2Runtime::handleBreak(uint8_t *rdram, R5900Context *ctx)
 
 void PS2Runtime::drainCompletedDmacHandlers(uint8_t *rdram)
 {
-    for (uint32_t cause : m_memory.consumeCompletedDmacCauses())
+    // This runs after every guest store to a special address, scratchpad
+    // included, so test the queue before taking its lock.
+    if (m_memory.hasCompletedDmacCauses())
     {
-        ps2_syscalls::dispatchDmacHandlersForCause(rdram, this, cause);
+        for (uint32_t cause : m_memory.consumeCompletedDmacCauses())
+        {
+            ps2_syscalls::dispatchDmacHandlersForCause(rdram, this, cause);
+        }
     }
 }
 
@@ -2087,6 +2092,7 @@ void PS2Runtime::Store8(uint8_t *rdram, R5900Context *ctx, uint32_t vaddr, uint8
     try
     {
         m_memory.write8(vaddr, value);
+        drainCompletedDmacHandlers(rdram);
     }
     catch (const std::exception &)
     {
@@ -2100,6 +2106,7 @@ void PS2Runtime::Store16(uint8_t *rdram, R5900Context *ctx, uint32_t vaddr, uint
     try
     {
         m_memory.write16(vaddr, value);
+        drainCompletedDmacHandlers(rdram);
     }
     catch (const std::exception &)
     {
@@ -2127,6 +2134,7 @@ void PS2Runtime::Store64(uint8_t *rdram, R5900Context *ctx, uint32_t vaddr, uint
     try
     {
         m_memory.write64(vaddr, value);
+        drainCompletedDmacHandlers(rdram);
     }
     catch (const std::exception &)
     {
@@ -2142,6 +2150,7 @@ void PS2Runtime::Store128(uint8_t *rdram, R5900Context *ctx, uint32_t vaddr, __m
     try
     {
         m_memory.write128(vaddr, value);
+        drainCompletedDmacHandlers(rdram);
     }
     catch (const std::exception &)
     {
diff --git a/ps2xTest/src/ps2_runtime_interrupt_tests.cpp b/ps2xTest/src/ps2_runtime_interrupt_tests.cpp
index 4261bfa..1707644 100644
--- a/ps2xTest/src/ps2_runtime_interrupt_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_interrupt_tests.cpp
@@ -8,6 +8,7 @@
 #include <cstdint>
 #include <cstring>
 #include <exception>
+#include <string>
 #include <string_view>
 #include <thread>
 #include <utility>
@@ -72,6 +73,17 @@ namespace
     constexpr uint32_t kInvocationQueuePc = 0x00160530u;
     constexpr uint32_t kInvocationQueueResumePc = 0x00160540u;
     constexpr uint32_t kInvocationQueueHandlerPc = 0x00160550u;
+    constexpr uint32_t kStoreKickPc = 0x00160600u;
+    constexpr uint32_t kStoreKickResumePc = 0x00160610u;
+    constexpr uint32_t kStoreKickHandlerPc = 0x00160620u;
+
+    // The to-scratchpad DMA channel completes synchronously when kicked and
+    // raises DMAC cause 9.
+    constexpr uint32_t kToSprChcr = 0x1000D400u;
+    constexpr uint32_t kToSprMadr = 0x1000D410u;
+    constexpr uint32_t kToSprQwc = 0x1000D420u;
+    constexpr uint32_t kToSprSadr = 0x1000D480u;
+    constexpr uint32_t kToSprCause = 9u;
 
     constexpr uint32_t kTimer2Count = 0x10001000u;
     constexpr uint32_t kTimer2Mode = 0x10001010u;
@@ -97,6 +109,9 @@ namespace
     uint32_t g_invocationQueueRuns = 0u;
     uint32_t g_invocationQueueSp = 0u;
     bool g_invocationQueueSpChanged = false;
+    uint32_t g_storeKickWidth = 0u;
+    bool g_storeKickHandlerRan = false;
+    bool g_storeKickHandledBeforeResume = false;
 
     void setRegU32(R5900Context &ctx, int reg, uint32_t value)
     {
@@ -373,6 +388,49 @@ namespace
         ctx->pc = 0u;
         runtime->requestStop();
     }
+
+    void storeKickHandler(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        g_storeKickHandlerRan = true;
+        ctx->pc = 0u;
+    }
+
+    // Starts a one-quadword to-scratchpad DMA and sets CHCR.STR with a store of
+    // g_storeKickWidth bits, the way generated code does for sb/sh/sw/sd/sq.
+    void storeKick(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        runtime->eeScheduler().addIrqHandler(true, kToSprCause, kStoreKickHandlerPc, true, 0u, 0u, 0u);
+        runtime->Store32(rdram, ctx, kToSprMadr, 0x00021000u);
+        runtime->Store32(rdram, ctx, kToSprQwc, 1u);
+        runtime->Store32(rdram, ctx, kToSprSadr, 0u);
+        ctx->pc = kStoreKickResumePc;
+        constexpr uint32_t kChcrStr = 0x100u;
+        switch (g_storeKickWidth)
+        {
+        case 8u:
+            runtime->Store8(rdram, ctx, kToSprChcr + 1u, static_cast<uint8_t>(kChcrStr >> 8u));
+            break;
+        case 16u:
+            runtime->Store16(rdram, ctx, kToSprChcr, static_cast<uint16_t>(kChcrStr));
+            break;
+        case 32u:
+            runtime->Store32(rdram, ctx, kToSprChcr, kChcrStr);
+            break;
+        case 64u:
+            runtime->Store64(rdram, ctx, kToSprChcr, kChcrStr);
+            break;
+        default:
+            runtime->Store128(rdram, ctx, kToSprChcr, _mm_set_epi64x(0, kChcrStr));
+            break;
+        }
+    }
+
+    void storeKickResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        g_storeKickHandledBeforeResume = g_storeKickHandlerRan;
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
 }
 
 void register_ps2_runtime_interrupt_tests()
@@ -572,6 +630,30 @@ void register_ps2_runtime_interrupt_tests()
                      "IRQ handler stack writes must not clobber the registering thread's live frame");
         });
 
+        tc.Run("a DMA kicked by a store of any width delivers its completion interrupt before the guest continues", [](TestCase &t)
+        {
+            for (const uint32_t width : {8u, 16u, 32u, 64u, 128u})
+            {
+                TestEnv env;
+                t.IsTrue(env.runtime.memory().initialize(), "runtime memory initialize should succeed");
+                env.runtime.registerFunction(kStoreKickPc, storeKick);
+                env.runtime.registerFunction(kStoreKickResumePc, storeKickResume);
+                env.runtime.registerFunction(kStoreKickHandlerPc, storeKickHandler);
+                g_storeKickWidth = width;
+                g_storeKickHandlerRan = false;
+                g_storeKickHandledBeforeResume = false;
+
+                R5900Context mainContext{};
+                mainContext.pc = kStoreKickPc;
+                env.runtime.eeScheduler().reset(env.rdram.data(), mainContext);
+                env.runtime.eeScheduler().run();
+
+                t.IsTrue(g_storeKickHandledBeforeResume,
+                         "kicked by a store of " + std::to_string(width) +
+                             " bits, the DMA's DMAC handler should run before the guest continues");
+            }
+        });
+
         tc.Run("pending async callbacks execute sequentially on a reusable invocation stack", [](TestCase &t)
         {
             TestEnv env;
