 {
+    constexpr int kFxaaSize = 32;
+
+    // Draws a black and white picture (white where `white(x, y)`) through FXAA in a hidden window and
+    // returns the result's red channel, row 0 at the top. Empty when no window can be opened.
+    template <typename White>
+    std::optional<std::vector<uint8_t>> renderThroughFxaa(TestCase &t, White white)
+    {
+        SetTraceLogLevel(LOG_WARNING);
+        SetConfigFlags(FLAG_WINDOW_HIDDEN);
+        InitWindow(kFxaaSize, kFxaaSize, "fxaa test");
+        if (!IsWindowReady())
+        {
+            const char *required = std::getenv("PS2_TEST_REQUIRE_GPU");
+            if (required && std::string(required) == "1")
+                t.Fail("a window is required (PS2_TEST_REQUIRE_GPU=1) but cannot be opened");
+            else
+                std::cout << "    skipped: no window" << std::endl;
+            return std::nullopt;
+        }
+
+        Image image = GenImageColor(kFxaaSize, kFxaaSize, BLACK);
+        for (int y = 0; y < kFxaaSize; ++y)
+            for (int x = 0; x < kFxaaSize; ++x)
+                if (white(x, y))
+                    ImageDrawPixel(&image, x, y, WHITE);
+        Texture2D picture = LoadTextureFromImage(image);
+        UnloadImage(image);
+        SetTextureFilter(picture, TEXTURE_FILTER_BILINEAR);
+        SetTextureWrap(picture, TEXTURE_WRAP_CLAMP);
+
+        std::optional<std::vector<uint8_t>> result;
+        Ps2HostFxaa fxaa;
+        if (!fxaa.load())
+        {
+            t.Fail("the FXAA shader does not compile");
+        }
+        else
+        {
+            Image out = LoadImageFromTexture(fxaa.apply(picture));
+            ImageFlipVertical(&out);
+            ImageFormat(&out, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+            const auto *pixels = static_cast<const uint8_t *>(out.data);
+            result.emplace(static_cast<size_t>(kFxaaSize * kFxaaSize));
+            for (size_t i = 0; i < result->size(); ++i)
+                (*result)[i] = pixels[i * 4u];
+            UnloadImage(out);
+            fxaa.unload();
+        }
+        UnloadTexture(picture);
+        CloseWindow();
+        return result;
+    }
