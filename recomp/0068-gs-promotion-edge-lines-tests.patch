From 58e0b128b5532a753c18b23cfb21d6fa88c8c901 Mon Sep 17 00:00:00 2001
From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Mon, 26 Oct 2026 19:01:06 +0200
Subject: [PATCH] Tests: backbuffer promotion survives edge lines drawn after
 the blit

Soulcalibur III shades the first and last line of its display buffer with
untextured one-pixel sprites in the render pass of its final blit. That made
paraLLEl-GS give up promoting the blit's source, so the 16-bit display buffer
with the game's motion trail and alternating line brightness was scanned out.
The fix is the paraLLEl-GS patch recomp/parallel-gs/gs/0001; these tests cover it.
---
 ps2xTest/src/ps2_gs_parallel_tests.cpp | 37 ++++++++++++++++++++++++--
 1 file changed, 35 insertions(+), 2 deletions(-)

diff --git a/ps2xTest/src/ps2_gs_parallel_tests.cpp b/ps2xTest/src/ps2_gs_parallel_tests.cpp
index 35fb620..2e75115 100644
--- a/ps2xTest/src/ps2_gs_parallel_tests.cpp
+++ b/ps2xTest/src/ps2_gs_parallel_tests.cpp
@@ -87,8 +87,16 @@ namespace
     // The way Soulcalibur III builds a frame: it renders into a 640x448 PSMCT32 buffer at page 0, then
     // blits that buffer with a textured sprite into the 512x512 PSMCT16 buffer at page 0x8C, which is
     // what the display circuit reads. The frame is a green triangle with a diagonal edge over black.
-    // The blit follows a vsync, as in the game, so it is a render pass of its own.
-    Presented presentBlittedFrame(TestCase &t, uint32_t superSampling)
+    // The blit follows a vsync, as in the game, so it is a render pass of its own. The game then draws
+    // untextured one-pixel sprites over the first and last line, in the blit's render pass.
+    enum class EdgeLines
+    {
+        None,
+        InBlitPass,
+        OwnPass,
+    };
+
+    Presented presentBlittedFrame(TestCase &t, uint32_t superSampling, EdgeLines edgeLines = EdgeLines::None)
     {
         GsFixture f;
         if (!requireGpuGs(t, f.gs, GSParallelOptions{superSampling}))
@@ -122,6 +130,15 @@ namespace
                              {kRegXyz2, 0u},
                              {kRegUv, (640ull << 4) | ((448ull << 4) << 16)},
                              {kRegXyz2, (512ull << 4) | ((512ull << 4) << 16)}}));
+        if (edgeLines == EdgeLines::OwnPass)
+            f.gs.onVsync(0u);
+        if (edgeLines != EdgeLines::None)
+            send(f.gs, adPacket({{kRegPrim, 6u},
+                                 {kRegRgbaq, 0x80ull << 24},
+                                 {kRegXyz2, 0u},
+                                 {kRegXyz2, (512ull << 4) | ((1ull << 4) << 16)},
+                                 {kRegXyz2, (511ull << 4) << 16},
+                                 {kRegXyz2, (512ull << 4) | ((512ull << 4) << 16)}}));
         f.gs.onVsync(0u);
         f.gs.onVsync(1u); // publishes the previous vsync's picture
         f.gs.latchHostPresentationFrame();
@@ -261,6 +278,22 @@ void register_ps2_gs_parallel_tests()
             t.IsTrue(eight.partlyCoveredPixels > 100u, "8x super-sampling blends the pixels on the edge");
         });
 
+        tc.Run("lines drawn over the frame's edges after the blit keep its source presented (GPU GS)", [](TestCase &t)
+        {
+            const Presented presented = presentBlittedFrame(t, 4u, EdgeLines::InBlitPass);
+            t.Equals(presented.width, 1024u, "twice the display's width");
+            t.Equals(static_cast<uint32_t>(presented.centreGreen), kTriangleGreen,
+                     "the blit's 32-bit source buffer is scanned out, not the 16-bit buffer with the trail");
+        });
+
+        tc.Run("a render pass of edge lines alone presents the display buffer (GPU GS)", [](TestCase &t)
+        {
+            const Presented presented = presentBlittedFrame(t, 4u, EdgeLines::OwnPass);
+            t.Equals(presented.width, 1024u, "twice the display's width");
+            t.Equals(static_cast<uint32_t>(presented.centreGreen), kTriangleGreen & 0xF8u,
+                     "with no blit in the pass the 16-bit display buffer is scanned out");
+        });
+
         tc.Run("the GIF arbiter reports the path each packet came on", [](TestCase &t)
         {
             std::vector<GifPathId> paths;
