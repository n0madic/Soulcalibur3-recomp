From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Tue, 27 Oct 2026 07:28:16 +0200
Subject: [PATCH] EE FPU: CVT.W.S truncates, SQRT.S reads ft

Former patches of the series, merged:
- 0030: CVT.W.S truncates
- 0032: SQRT.S reads ft
---
 ps2xRecomp/src/lib/fpu_translator.cpp      |  3 ++-
 ps2xRuntime/include/ps2_runtime_macros.h   | 13 ++++++++++++-
 ps2xTest/src/ps2_float_semantics_tests.cpp | 22 ++++++++++++++++++++++
 3 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/ps2xRecomp/src/lib/fpu_translator.cpp b/ps2xRecomp/src/lib/fpu_translator.cpp
index dcb05b1..2dac76c 100644
--- a/ps2xRecomp/src/lib/fpu_translator.cpp
+++ b/ps2xRecomp/src/lib/fpu_translator.cpp
@@ -58,7 +58,8 @@ namespace ps2recomp
                                    "ctx->f[{}] = FPU_DIV_S(ctx->f[{}], ctx->f[{}]); }}",
                                    ft, fd, fs, ft);
             case COP1_S_SQRT:
-                return fmt::format("ctx->f[{}] = FPU_SQRT_S(ctx->f[{}]);", fd, fs);
+                // The EE's SQRT.S fd, ft reads ft (fs is 0), unlike MIPS SQRT.S fd, fs.
+                return fmt::format("ctx->f[{}] = FPU_SQRT_S(ctx->f[{}]);", fd, ft);
             case COP1_S_ABS:
                 return fmt::format("ctx->f[{}] = FPU_ABS_S(ctx->f[{}]);", fd, fs);
             case COP1_S_MOV:
diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index 657e9ef..1d3f525 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -4,6 +4,7 @@
 #include <cmath>
 #include <cstring>
 #include <bit>
+#include <limits>
 #if defined(_MSC_VER)
 #include <intrin.h>
 #elif defined(USE_SSE2NEON)
@@ -368,6 +369,16 @@ inline float ps2_fmin(float a, float b)
     return ps2_fflush(ps2_fkey(b) < ps2_fkey(a) ? b : a);
 }
 
+// CVT.W.S always truncates toward zero (GCC uses it for every (int) cast). Magnitudes of 2^31 or
+// more, exponent 255 included, saturate to 0x7FFFFFFF / 0x80000000 by sign.
+inline int32_t ps2_fcvt_w(float a)
+{
+    const uint32_t bits = std::bit_cast<uint32_t>(a);
+    if ((bits & PS2_FLOAT_EXP_MASK) <= 0x4E800000u)
+        return static_cast<int32_t>(a);
+    return (bits & PS2_FLOAT_SIGN_MASK) ? std::numeric_limits<int32_t>::min() : std::numeric_limits<int32_t>::max();
+}
+
 // VU MAX/MINI compare the raw lanes as integers, the larger magnitude winning among two negative
 // values (PCSX2 VUops.cpp fp_max/fp_min). Exponent-255 lanes are numbers here too; nothing is
 // flushed.
@@ -1253,7 +1264,7 @@ inline void ps2_pdivbw(R5900Context *ctx, __m128i rs, __m128i rt)
 #define FPU_FLOOR_W_S(a) ((int32_t)floorf((float)(a)))
 #define FPU_CVT_S_W(a) ((float)(int32_t)(a))
 #define FPU_CVT_S_L(a) ((float)(int64_t)(a))
-#define FPU_CVT_W_S(a) ((int32_t)nearbyintf((float)(a)))
+#define FPU_CVT_W_S(a) ps2_fcvt_w((float)(a))
 #define FPU_CVT_L_S(a) ((int64_t)(float)(a))
 #define FPU_C_F_S(a, b) (0)
 // The R5900 FPU implements only C.F, C.EQ, C.LT and C.LE, on the function codes MIPS gives C.F,
diff --git a/ps2xTest/src/ps2_float_semantics_tests.cpp b/ps2xTest/src/ps2_float_semantics_tests.cpp
index 2866d2b..89a678f 100644
--- a/ps2xTest/src/ps2_float_semantics_tests.cpp
+++ b/ps2xTest/src/ps2_float_semantics_tests.cpp
@@ -178,6 +178,22 @@ void register_ps2_float_semantics_tests()
             t.Equals(bitsOf(FPU_SQRT_S(-0.0f)), bitsOf(0.0f), "sqrt(-0) should be +0");
         });
 
+        tc.Run("FPU CVT.W.S truncates toward zero and saturates out-of-range values", [](TestCase &t)
+        {
+            // GCC for the EE uses CVT.W.S for every (int) cast, so it must truncate like C does.
+            t.Equals(FPU_CVT_W_S(2.75f), 2, "2.75 should truncate to 2");
+            t.Equals(FPU_CVT_W_S(-2.75f), -2, "-2.75 should truncate to -2");
+            t.Equals(FPU_CVT_W_S(0.5f), 0, "0.5 should truncate to 0");
+            t.Equals(FPU_CVT_W_S(1.5f), 1, "1.5 should truncate to 1");
+            t.Equals(FPU_CVT_W_S(floatOf(0x00000001u)), 0, "a denormal should give 0");
+            t.Equals(FPU_CVT_W_S(-2147483648.0f), std::numeric_limits<int32_t>::min(), "-2^31 should convert exactly");
+            t.Equals(FPU_CVT_W_S(2147483520.0f), 2147483520, "the largest float below 2^31 should convert exactly");
+            t.Equals(FPU_CVT_W_S(3.0e9f), std::numeric_limits<int32_t>::max(), "3e9 should saturate to 0x7FFFFFFF");
+            t.Equals(FPU_CVT_W_S(-3.0e9f), std::numeric_limits<int32_t>::min(), "-3e9 should saturate to 0x80000000");
+            t.Equals(FPU_CVT_W_S(floatOf(kPlusMax)), std::numeric_limits<int32_t>::max(), "+max should saturate to 0x7FFFFFFF");
+            t.Equals(FPU_CVT_W_S(floatOf(kMinusMax)), std::numeric_limits<int32_t>::min(), "-max should saturate to 0x80000000");
+        });
+
         tc.Run("VU vector ADD/SUB/MUL follow the same rules in every lane", [](TestCase &t)
         {
             // _mm_set_ps lists lanes 3..0
@@ -223,6 +239,12 @@ void register_ps2_float_semantics_tests()
             const std::string rsqrt = gen.translateInstruction(makeCop1S(COP1_S_RSQRT, 2, 3, 4));
             t.IsTrue(rsqrt.find("ctx->f[2] = FPU_RSQRT_S(ctx->f[3], ctx->f[4])") != std::string::npos,
                      "RSQRT.S should compute fs / sqrt(ft) but got: " + rsqrt);
+
+            // The EE encodes SQRT.S fd, ft with the source in the ft field and fs = 0
+            // (0x46020084 is sqrt.s $f2, $f2 in Soulcalibur III).
+            const std::string sqrt = gen.translateInstruction(makeCop1S(COP1_S_SQRT, 2, 0, 4));
+            t.IsTrue(sqrt.find("ctx->f[2] = FPU_SQRT_S(ctx->f[4])") != std::string::npos,
+                     "SQRT.S should take the square root of ft but got: " + sqrt);
         });
     });
 }
