+bool PS2Memory::pollGsInterruptEdge()
+{
+    // CSR bits 0..4 are the event flags; IMR bits 8..12 mask the same sources.
+    constexpr uint64_t kCsrEventMask = 0x1Fu;
+    const uint64_t events = gs_regs.csr.load(std::memory_order_acquire) & kCsrEventMask;
+    const bool line = (events & ~(gs_regs.imr >> 8u)) != 0u;
+    const bool risingEdge = line && !m_gsInterruptLine;
+    m_gsInterruptLine = line;
+    return risingEdge;
+}
+
+namespace
+{
+    constexpr uint64_t kCsrSignal = 0x1u;
+
+    void applySignal(GSRegisters &regs, uint64_t value)
+    {
+        const uint32_t id = static_cast<uint32_t>(value & 0xFFFFFFFFu);
+        const uint32_t mask = static_cast<uint32_t>(value >> 32);
+        uint32_t lo = static_cast<uint32_t>(regs.siglblid & 0xFFFFFFFFu);
+        lo = (lo & ~mask) | (id & mask);
+        regs.siglblid = (regs.siglblid & 0xFFFFFFFF00000000ull) | lo;
+        regs.csr.fetch_or(kCsrSignal);
+    }
+}
+
+void gsWriteSignal(GSRegisters &regs, uint64_t value)
+{
+    if ((regs.csr.load(std::memory_order_acquire) & kCsrSignal) == 0u)
+    {
+        applySignal(regs, value);
+        return;
+    }
+    if (regs.queuedSignalCount < GSRegisters::kMaxQueuedSignals)
+    {
+        regs.queuedSignals[regs.queuedSignalCount++] = value;
+        return;
+    }
+    RUNTIME_LOG("[gs:signal] queue full, dropping SIGNAL 0x" << std::hex << value << std::dec << std::endl);
+}
+
+void gsApplyQueuedSignal(GSRegisters &regs)
+{
+    if (regs.queuedSignalCount == 0u || (regs.csr.load(std::memory_order_acquire) & kCsrSignal) != 0u)
+        return;
+    const uint64_t value = regs.queuedSignals[0];
+    regs.queuedSignalCount--;
+    std::memmove(regs.queuedSignals, regs.queuedSignals + 1, regs.queuedSignalCount * sizeof(uint64_t));
+    applySignal(regs, value);
+}
