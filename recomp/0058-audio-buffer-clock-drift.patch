From c3e8e6ee6ffd1cde9746e4c0b39636c0fd90af92 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sat, 24 Oct 2026 10:11:24 +0300
Subject: [PATCH] Audio: absorb clock drift without dropping PCM blocks

Replace the abrupt 250 ms to 125 ms queue trim with smoothly bounded rate correction around an 83 ms target. Keep a fractional stereo read cursor and linearly interpolate adjacent samples; both channels share the same phase. Correct at most two percent and smooth the ratio over 250 ms.

The intro previously lost 18003 host PCM frames in 36 seconds despite no output underflow. The corrected manual run keeps missing/dropped frames at zero and a stable queue near 80-90 ms.
---
 ps2xRuntime/src/lib/ps2_audio.cpp | 52 +++++++++++++++++++++----------
 1 file changed, 36 insertions(+), 16 deletions(-)

diff --git a/ps2xRuntime/src/lib/ps2_audio.cpp b/ps2xRuntime/src/lib/ps2_audio.cpp
index 363b694..fcd8ff2 100644
--- a/ps2xRuntime/src/lib/ps2_audio.cpp
+++ b/ps2xRuntime/src/lib/ps2_audio.cpp
@@ -85,7 +85,7 @@ struct PS2AudioBackend::PcmStream
 {
     static constexpr uint32_t kSampleRate = 48000u;
     static constexpr size_t kCapacityFrames = kSampleRate;       // 1 s ring
-    static constexpr size_t kMaxQueuedFrames = kSampleRate / 4u; // drop the oldest beyond 250 ms
+    static constexpr size_t kTargetQueuedFrames = kSampleRate / 12u; // about 83 ms
 
     std::mutex mutex;
     std::vector<int16_t> ring = std::vector<int16_t>(kCapacityFrames * 2u);
@@ -93,6 +93,8 @@ struct PS2AudioBackend::PcmStream
     size_t queuedFrames = 0;
     bool started = false;
     bool primed = false;
+    double readPhase = 0.0;
+    double playbackStep = 1.0;
 #if !defined(PLATFORM_VITA)
     AudioStream stream{};
 #endif
@@ -116,20 +118,43 @@ struct PS2AudioBackend::PcmStream
             return;
         }
         self->primed = true;
-        const size_t available = std::min<size_t>(frames, self->queuedFrames);
-        for (size_t i = 0; i < available; ++i)
+        // IOP and host audio time can drift slightly. Correct it continuously,
+        // rather than deleting a block of PCM whenever latency crosses a limit.
+        const double error = (static_cast<double>(self->queuedFrames) - kTargetQueuedFrames) /
+                             static_cast<double>(kTargetQueuedFrames);
+        const double targetStep = std::clamp(1.0 + error * 0.04, 0.98, 1.02);
+        const double smoothing = std::min(1.0, static_cast<double>(frames) / (kSampleRate * 0.25));
+        self->playbackStep += (targetStep - self->playbackStep) * smoothing;
+
+        size_t written = 0u;
+        double position = self->readPhase;
+        for (; written < frames; ++written)
         {
-            const size_t index = ((self->readFrame + i) % kCapacityFrames) * 2u;
-            out[i * 2u] = self->ring[index];
-            out[i * 2u + 1u] = self->ring[index + 1u];
+            const size_t frame = static_cast<size_t>(position);
+            if (frame >= self->queuedFrames)
+                break;
+            const size_t next = std::min(frame + 1u, self->queuedFrames - 1u);
+            const size_t index = ((self->readFrame + frame) % kCapacityFrames) * 2u;
+            const size_t nextIndex = ((self->readFrame + next) % kCapacityFrames) * 2u;
+            const double fraction = position - frame;
+            for (size_t channel = 0u; channel < 2u; ++channel)
+            {
+                const int32_t a = self->ring[index + channel];
+                const int32_t b = self->ring[nextIndex + channel];
+                out[written * 2u + channel] = static_cast<int16_t>(a + (b - a) * fraction);
+            }
+            position += self->playbackStep;
         }
-        if (available < frames)
+        const size_t consumed = std::min(static_cast<size_t>(position), self->queuedFrames);
+        self->readFrame = (self->readFrame + consumed) % kCapacityFrames;
+        self->queuedFrames -= consumed;
+        self->readPhase = position - consumed;
+        if (written < frames)
         {
-            std::memset(out + available * 2u, 0, (frames - available) * 4u);
+            std::memset(out + written * 2u, 0, (frames - written) * 4u);
             self->primed = false;
+            self->readPhase = 0.0;
         }
-        self->readFrame = (self->readFrame + available) % kCapacityFrames;
-        self->queuedFrames -= available;
     }
 };
 
@@ -168,18 +193,13 @@ void PS2AudioBackend::pushPcm(const int16_t *samples, size_t frames)
         {
             pcm.readFrame = (pcm.readFrame + 1u) % PcmStream::kCapacityFrames;
             --pcm.queuedFrames;
+            pcm.readPhase = 0.0;
         }
         const size_t index = ((pcm.readFrame + pcm.queuedFrames) % PcmStream::kCapacityFrames) * 2u;
         pcm.ring[index] = samples[i * 2u];
         pcm.ring[index + 1u] = samples[i * 2u + 1u];
         ++pcm.queuedFrames;
     }
-    if (pcm.queuedFrames > PcmStream::kMaxQueuedFrames)
-    {
-        const size_t drop = pcm.queuedFrames - PcmStream::kMaxQueuedFrames / 2u;
-        pcm.readFrame = (pcm.readFrame + drop) % PcmStream::kCapacityFrames;
-        pcm.queuedFrames -= drop;
-    }
 #endif
 }
 
