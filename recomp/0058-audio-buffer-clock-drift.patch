diff --git a/ps2xTest/src/ps2_audio_tests.cpp b/ps2xTest/src/ps2_audio_tests.cpp
new file mode 100644
index 0000000..5d8a820
--- /dev/null
+++ b/ps2xTest/src/ps2_audio_tests.cpp
@@ -0,0 +1,131 @@
+#include "MiniTest.h"
+#include "runtime/ps2_pcm_queue.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <vector>
+
+namespace
+{
+    constexpr size_t kBlockFrames = 1024u; // raylib's default audio stream buffer
+
+    std::vector<int16_t> constantFrames(size_t frames, int16_t value)
+    {
+        return std::vector<int16_t>(frames * 2u, value);
+    }
+
+    // Runs `seconds` of host playback with the producer making `producedPerBlock` frames for every
+    // block the host plays. Returns the frames the host got from the queue and tracks the queue size.
+    struct Run
+    {
+        size_t played = 0u;
+        size_t silentAfterStart = 0u;
+        size_t minQueued = SIZE_MAX;
+        size_t maxQueued = 0u;
+        size_t largestDrop = 0u;
+    };
+
+    Run simulate(PcmQueue &queue, double seconds, double producedPerBlock)
+    {
+        Run run;
+        std::vector<int16_t> out(kBlockFrames * 2u);
+        double owed = 0.0;
+        bool started = false;
+        const size_t blocks = static_cast<size_t>(seconds * PcmQueue::kSampleRate / kBlockFrames);
+        for (size_t block = 0; block < blocks; ++block)
+        {
+            owed += producedPerBlock;
+            const size_t produce = static_cast<size_t>(owed);
+            owed -= static_cast<double>(produce);
+            const std::vector<int16_t> input = constantFrames(produce, 1000);
+            queue.push(input.data(), produce);
+
+            const size_t before = queue.queuedFrames();
+            const size_t got = queue.pull(out.data(), kBlockFrames);
+            run.played += got;
+            started = started || got != 0u;
+            if (started)
+                run.silentAfterStart += kBlockFrames - got;
+            // More than one block (plus the 2% speed-up) gone at once is a cut, not playback.
+            if (before > queue.queuedFrames())
+                run.largestDrop = std::max(run.largestDrop, before - queue.queuedFrames());
+            if (started)
+            {
+                run.minQueued = std::min(run.minQueued, queue.queuedFrames());
+                run.maxQueued = std::max(run.maxQueued, queue.queuedFrames());
+            }
+        }
+        return run;
+    }
+}
+
+void register_ps2_audio_tests()
+{
+    MiniTest::Case("PcmQueue", [](TestCase &tc)
+                   {
+        tc.Run("interpolation keeps high frequencies between two samples", [](TestCase &t)
+        {
+            t.Equals(PcmQueue::interpolate(-7, 1234, 99, 5, 0.0), static_cast<int16_t>(1234), "t = 0 is the sample itself");
+            t.Equals(PcmQueue::interpolate(-7, 1234, 99, 5, 1.0), static_cast<int16_t>(99), "t = 1 is the next sample");
+
+            // A 12 kHz tone at 48 kHz read half-way between its samples: linear interpolation keeps
+            // cos(pi / 4) = 71% of it, which is audible as dull sound while the drift correction runs.
+            constexpr double kAmplitude = 10000.0;
+            constexpr double kPi = 3.14159265358979323846;
+            auto tone = [](int n) { return static_cast<int32_t>(std::lround(kAmplitude * std::sin(kPi / 2.0 * n + kPi / 4.0))); };
+            int32_t peak = 0;
+            for (int n = 1; n < 9; ++n)
+                peak = std::max(peak, std::abs(static_cast<int32_t>(
+                                          PcmQueue::interpolate(tone(n - 1), tone(n), tone(n + 1), tone(n + 2), 0.5))));
+            t.IsTrue(peak >= static_cast<int32_t>(0.85 * kAmplitude), "a 12 kHz tone should keep at least 85% of its amplitude");
+        });
+
+        tc.Run("a producer at the host rate plays without gaps or cuts", [](TestCase &t)
+        {
+            PcmQueue queue;
+            const Run run = simulate(queue, 30.0, static_cast<double>(kBlockFrames));
+            t.Equals(run.silentAfterStart, static_cast<size_t>(0u), "no frame should be missing once playback started");
+            t.IsTrue(run.largestDrop <= kBlockFrames * 103u / 100u, "no queued audio should be cut");
+            t.IsTrue(run.maxQueued < PcmQueue::kTrimAboveFrames, "the queue should stay below the trim threshold");
+        });
+
+        tc.Run("a producer 1% fast settles near the target latency without cuts", [](TestCase &t)
+        {
+            PcmQueue queue;
+            const Run run = simulate(queue, 60.0, kBlockFrames * 1.01);
+            t.Equals(run.silentAfterStart, static_cast<size_t>(0u), "no frame should be missing");
+            t.IsTrue(run.largestDrop <= kBlockFrames * 103u / 100u, "drift should be absorbed, not cut");
+            const size_t target = PcmQueue::kTargetQueuedFrames;
+            t.IsTrue(queue.queuedFrames() > target / 2u && queue.queuedFrames() < target * 2u,
+                     "the queue should settle near the 83 ms target");
+            t.IsTrue(queue.playbackStep() > 1.0 && queue.playbackStep() <= 1.02, "the host should play slightly fast");
+        });
+
+        tc.Run("a backlog after a stall is cut to the target once", [](TestCase &t)
+        {
+            PcmQueue queue;
+            const std::vector<int16_t> backlog = constantFrames(PcmQueue::kSampleRate * 9u / 10u, 1000);
+            queue.push(backlog.data(), PcmQueue::kSampleRate * 9u / 10u);
+            std::vector<int16_t> out(kBlockFrames * 2u);
+            t.Equals(queue.pull(out.data(), kBlockFrames), kBlockFrames, "the host should get a full block");
+            t.IsTrue(queue.queuedFrames() <= PcmQueue::kTargetQueuedFrames,
+                     "0.9 s of latency should not be played off over a minute at +2%");
+        });
+
+        tc.Run("an empty queue plays silence and waits for a backlog", [](TestCase &t)
+        {
+            PcmQueue queue;
+            std::vector<int16_t> out(kBlockFrames * 2u, 77);
+            t.Equals(queue.pull(out.data(), kBlockFrames), static_cast<size_t>(0u), "nothing should come from an empty queue");
+            t.IsTrue(std::all_of(out.begin(), out.end(), [](int16_t s) { return s == 0; }), "the block should be silent");
+            const std::vector<int16_t> few = constantFrames(PcmQueue::kPrimeFrames - 1u, 1000);
+            queue.push(few.data(), few.size() / 2u);
+            t.Equals(queue.pull(out.data(), kBlockFrames), static_cast<size_t>(0u), "playback should wait for 50 ms of audio");
+            const std::vector<int16_t> one = constantFrames(1u, 1000);
+            queue.push(one.data(), 1u);
+            t.Equals(queue.pull(out.data(), kBlockFrames), kBlockFrames, "a primed queue should play");
+        });
+    });
+}
