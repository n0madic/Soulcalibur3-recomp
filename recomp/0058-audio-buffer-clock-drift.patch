diff --git a/ps2xRuntime/include/runtime/ps2_pcm_queue.h b/ps2xRuntime/include/runtime/ps2_pcm_queue.h
new file mode 100644
index 0000000..7451cb2
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_pcm_queue.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Stereo PCM produced as IOP time advances (SPU2 output) and consumed by the host audio thread.
+// The two clocks drift apart slightly; the consumer resamples by up to +-2% to hold the queue near
+// its target instead of dropping blocks. Not thread-safe: the caller serializes push and pull.
+class PcmQueue
+{
+public:
+    static constexpr uint32_t kSampleRate = 48000u;
+    static constexpr size_t kCapacityFrames = kSampleRate;              // 1 s ring
+    static constexpr size_t kTargetQueuedFrames = kSampleRate / 12u;    // about 83 ms
+    static constexpr size_t kPrimeFrames = kSampleRate / 20u;           // backlog before (re)starting
+    static constexpr size_t kTrimAboveFrames = kTargetQueuedFrames * 4u; // about 333 ms
+
+    // Appends `frames` interleaved stereo frames; when the ring is full the oldest frames go.
+    void push(const int16_t *samples, size_t frames);
+
+    // Fills `frames` interleaved stereo frames of `out`, zero-filling past the queued audio, and
+    // returns how many frames came from the queue. Running dry stops playback until the queue has
+    // primed again. A backlog beyond kTrimAboveFrames (after a stall or a burst of production) is
+    // cut to the target once rather than slowly played off at +2%.
+    size_t pull(int16_t *out, size_t frames);
+
+    [[nodiscard]] size_t queuedFrames() const noexcept { return m_queuedFrames; }
+    [[nodiscard]] double playbackStep() const noexcept { return m_playbackStep; }
+
+    // Catmull-Rom interpolation between y1 (t = 0) and y2 (t = 1). Unlike linear interpolation it
+    // keeps high frequencies when the read position sits between two samples.
+    static int16_t interpolate(int32_t y0, int32_t y1, int32_t y2, int32_t y3, double t) noexcept;
+
+private:
+    int32_t sampleAt(size_t frame, size_t channel) const noexcept;
+    void drop(size_t frames) noexcept;
+
+    std::vector<int16_t> m_ring = std::vector<int16_t>(kCapacityFrames * 2u);
+    size_t m_readFrame = 0u;
+    size_t m_queuedFrames = 0u;
+    int16_t m_previous[2] = {0, 0}; // the last frame consumed, for the interpolation's left neighbour
+    bool m_primed = false;
+    double m_readPhase = 0.0;
+    double m_playbackStep = 1.0;
+};
