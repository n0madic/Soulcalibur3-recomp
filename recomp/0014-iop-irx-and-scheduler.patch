From: n0madic <800462+n0madic@users.noreply.github.com>
Date: Tue, 27 Oct 2026 07:28:18 +0200
Subject: [PATCH] IOP: IRX argc/argv, sysclib ctype and a FIFO ready queue

Former patches of the series, merged:
- 0054: IOP: pass IRX argc/argv and implement sysclib ctype
- 0060: IOP: keep a FIFO ready queue per thread priority
---
 ps2xIOP/src/emulator/core/iop_kernel.cpp     |  29 +++-
 ps2xIOP/src/emulator/core/iop_kernel.h       |   8 ++
 ps2xIOP/src/emulator/imports/iop_sysclib.cpp |  56 +++++++-
 ps2xIOP/src/emulator/imports/iop_sysclib.h   |   5 +
 ps2xIOP/src/emulator/iop_emulator.cpp        |  66 +++++++--
 ps2xIOP/tests/iop_emulator_tests.cpp         | 139 +++++++++++++++++++
 ps2xIOP/tests/iop_import_tests.cpp           |  68 ++++++++-
 7 files changed, 355 insertions(+), 16 deletions(-)

diff --git a/ps2xIOP/src/emulator/core/iop_kernel.cpp b/ps2xIOP/src/emulator/core/iop_kernel.cpp
index 4832d8f..9f797d3 100644
--- a/ps2xIOP/src/emulator/core/iop_kernel.cpp
+++ b/ps2xIOP/src/emulator/core/iop_kernel.cpp
@@ -32,6 +32,9 @@ namespace ps2x::iop::detail
         m_nextSemaphoreId = 1;
         m_nextEventFlagId = 1;
         m_currentThread = nullptr;
+        m_lastRunThreadId = 0;
+        m_queueHead = 0;
+        m_queueTail = 0;
     }
 
     bool IopKernel::dispatchThreadImport(uint16_t ordinal, IopCpuState &cpu, uint64_t currentCycle)
@@ -99,6 +102,7 @@ namespace ps2x::iop::detail
             thread.cpu.gpr[29] = alignUp(thread.stackBase + thread.stackSize, 16u) - 16u;
             thread.cpu.gpr[31] = kThreadReturnSentinel;
             thread.state = IopThreadState::Ready;
+            thread.queued = false;
             setV0(0);
             return true;
         }
@@ -143,6 +147,7 @@ namespace ps2x::iop::detail
                 return true;
             }
             it->second.priority = std::clamp<uint32_t>(cpu.gpr[5], 1u, 126u);
+            it->second.queued = false; // to the tail of its new priority
             setV0(0);
             return true;
         }
@@ -675,6 +680,14 @@ namespace ps2x::iop::detail
         {
             if (thread.state == IopThreadState::Delay && thread.wakeCycle <= currentCycle)
                 thread.state = IopThreadState::Ready;
+            // A thread that became ready since the last pass joins the tail of its priority.
+            if (thread.state != IopThreadState::Ready)
+                thread.queued = false;
+            else if (!thread.queued)
+            {
+                thread.queued = true;
+                thread.readyOrder = ++m_queueTail;
+            }
         }
 
         IopThread *next = nullptr;
@@ -683,12 +696,18 @@ namespace ps2x::iop::detail
             if (thread.state != IopThreadState::Ready)
                 continue;
             if (next == nullptr || thread.priority < next->priority ||
-                (thread.priority == next->priority && thread.id < next->id))
+                (thread.priority == next->priority && thread.readyOrder < next->readyOrder))
                 next = &thread;
         }
         if (next == nullptr)
             return nullptr;
 
+        // Interrupt suspension protects the running thread from preemption until the critical section ends.
+        const auto last = m_threads.find(m_lastRunThreadId);
+        if (m_memory.interruptControl() == 0u && last != m_threads.end() && last->second.state == IopThreadState::Ready)
+            next = &last->second;
+
+        m_lastRunThreadId = next->id;
         m_currentThread = next;
         next->state = IopThreadState::Running;
         next->cpu.stopped = false;
@@ -712,7 +731,15 @@ namespace ps2x::iop::detail
         if (thread.cpu.pc == returnSentinel || thread.cpu.stopped)
             thread.state = IopThreadState::Dormant;
         else if (thread.state == IopThreadState::Running)
+        {
+            // A thread still running at the end of a host slice was not descheduled by the guest: it stays
+            // at the head of its priority, also when a higher-priority thread now runs first. Only
+            // RotateThreadReadyQueue/YieldThread (the one way to yield while running) sends it to the tail.
             thread.state = IopThreadState::Ready;
+            thread.queued = !thread.cpu.yielded;
+            if (thread.queued)
+                thread.readyOrder = --m_queueHead;
+        }
         m_currentThread = nullptr;
         cleanupDeadThreads();
     }
