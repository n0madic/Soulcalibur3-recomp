diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index 3700ffb..b1f00db 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -883,6 +883,113 @@ namespace
         std::memcpy(host.guest.data() + address + codeOffset, segment.data(), segment.size());
     }
 
+    // Stores its argc/argv at 0x10200/0x10204 and asks sysclib (ordinals 8 and 9) to classify '5', 'a'
+    // and ' ' (results at 0x10208..0x10210) and for the ctype table itself (0x10214).
+    void writeArgvCtypeIrx(TestHost &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+        constexpr uint32_t importTableOffset = 0x100u;
+        constexpr uint32_t lookStub = loadAddress + importTableOffset + 20u;
+        constexpr uint32_t tableStub = lookStub + 8u;
+        auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); };
+
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu;
+        header.ident[1] = 'E';
+        header.ident[2] = 'L';
+        header.ident[3] = 'F';
+        header.ident[4] = 1u;
+        header.ident[5] = 1u;
+        header.ident[6] = 1u;
+        header.type = 2u;
+        header.machine = 8u;
+        header.version = 1u;
+        header.entry = loadAddress;
+        header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader);
+        header.phentsize = sizeof(ProgramHeader);
+        header.phnum = 1u;
+
+        const uint32_t code[] = {
+            0x27BDFFE0u, // addiu sp, sp, -0x20
+            0xAFBF001Cu, // sw    ra, 0x1c(sp)
+            0x3C080001u, // lui   t0, 1
+            0x35080200u, // ori   t0, t0, 0x200
+            0xAD040000u, // sw    a0, 0(t0)
+            0xAD050004u, // sw    a1, 4(t0)
+            0x24040035u, // addiu a0, zero, '5'
+            jal(lookStub),
+            0x00000000u,
+            0x3C080001u, 0x35080200u,
+            0xAD020008u, // sw    v0, 8(t0)
+            0x24040061u, // addiu a0, zero, 'a'
+            jal(lookStub),
+            0x00000000u,
+            0x3C080001u, 0x35080200u,
+            0xAD02000Cu, // sw    v0, 12(t0)
+            0x24040020u, // addiu a0, zero, ' '
+            jal(lookStub),
+            0x00000000u,
+            0x3C080001u, 0x35080200u,
+            0xAD020010u, // sw    v0, 16(t0)
+            jal(tableStub),
+            0x00000000u,
+            0x3C080001u, 0x35080200u,
+            0xAD020014u, // sw    v0, 20(t0)
+            0x8FBF001Cu, // lw    ra, 0x1c(sp)
+            0x00001021u, // addu  v0, zero, zero
+            0x27BD0020u, // addiu sp, sp, 0x20
+            0x03E00008u, // jr    ra
+            0x00000000u, // nop
+        };
+        static_assert(sizeof(code) <= importTableOffset);
+        const uint32_t importTable[] = {
+            0x41E00000u, // IRX import magic
+            0x00000000u,
+            0x00000101u,
+            0x63737973u, // "sysc"
+            0x0062696Cu, // "lib"
+            0x03E00008u, // jr ra
+            0x24000008u, // look_ctype_table
+            0x03E00008u, // jr ra
+            0x24000009u, // get_ctype_table
+            0x00000000u,
+            0x00000000u,
+        };
+
+        ProgramHeader program{};
+        program.type = 1u;
+        program.offset = codeOffset;
+        program.vaddr = loadAddress;
+        program.paddr = loadAddress;
+        program.filesz = importTableOffset + sizeof(importTable);
+        program.memsz = 0x300u;
+        program.flags = 7u;
+        program.align = 4u;
+
+        std::fill(host.guest.begin() + address, host.guest.end(), 0u);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + codeOffset, code, sizeof(code));
+        std::memcpy(host.guest.data() + address + codeOffset + importTableOffset, importTable, sizeof(importTable));
+    }
+
+    uint32_t readIop32(const IopSubsystem &iop, uint32_t address)
+    {
+        uint32_t value = 0u;
+        (void)iop.readMemory(address, &value, sizeof(value));
+        return value;
+    }
+
+    std::string readIopString(const IopSubsystem &iop, uint32_t address)
+    {
+        std::string text;
+        for (char c = 0; iop.readMemory(address, &c, 1u) && c != '\0'; ++address)
+            text.push_back(c);
+        return text;
+    }
+
     bool expect(bool value, const char *message)
     {
         if (!value)
@@ -1180,5 +1287,37 @@ int main()
                 "sceCdSeek still emitted an unhandled IOP import")) return 1;
 
     std::cout << "ps2xIOP emulator smoke tests passed\n";
+    // Loadfile passes NUL-separated bytes; the IRX entry gets argc/argv with the module name first, empty
+    // arguments kept and a null pointer last. Soulcalibur III starts CRI ADX with "thpri=39" and "spucore=2",
+    // which its option parser reads through sysclib's ctype table.
+    iop.reset();
+    writeArgvCtypeIrx(host, 0x100u);
+    const char adxArguments[] = "thpri=39\0\0spucore=2"; // the second argument is empty
+    const ModuleLoadResult argvModule = iop.loadModuleBuffer(0x100u, adxArguments, sizeof(adxArguments));
+    if (!expect(argvModule.handled && argvModule.startResult == 0, "argc/argv IRX did not start")) return 1;
+    const uint32_t argc = readIop32(iop, 0x10200u);
+    const uint32_t argv = readIop32(iop, 0x10204u);
+    if (!expect(argc == 4u, "argc should count the module name, both options and the empty argument")) return 1;
+    if (!expect(!readIopString(iop, readIop32(iop, argv)).empty(), "argv[0] should name the module")) return 1;
+    if (!expect(readIopString(iop, readIop32(iop, argv + 4u)) == "thpri=39", "argv[1] mismatch")) return 1;
+    if (!expect(readIopString(iop, readIop32(iop, argv + 8u)).empty(), "argv[2] should be the empty argument")) return 1;
+    if (!expect(readIopString(iop, readIop32(iop, argv + 12u)) == "spucore=2", "argv[3] mismatch")) return 1;
+    if (!expect(readIop32(iop, argv + 16u) == 0u, "argv[argc] should be a null pointer")) return 1;
+    if (!expect(readIop32(iop, 0x10208u) == 0x04u, "look_ctype_table('5') should report a digit")) return 1;
+    if (!expect(readIop32(iop, 0x1020Cu) == 0x42u, "look_ctype_table('a') should report lower case and hex")) return 1;
+    if (!expect(readIop32(iop, 0x10210u) == 0x18u, "look_ctype_table(' ') should report space")) return 1;
+    uint8_t upperA = 0u;
+    if (!expect(iop.readMemory(readIop32(iop, 0x10214u) + 'A', &upperA, 1u) && upperA == 0x41u,
+                "get_ctype_table should return the guest table")) return 1;
+
+    iop.reset();
+    writeArgvCtypeIrx(host, 0x100u);
+    const ModuleLoadResult argvAfterReset = iop.loadModuleBuffer(0x100u);
+    if (!expect(argvAfterReset.handled && argvAfterReset.startResult == 0, "argc/argv IRX did not restart")) return 1;
+    if (!expect(readIop32(iop, 0x10200u) == 1u, "with no arguments argc should be 1")) return 1;
+    uint8_t digitZero = 0u;
+    if (!expect(iop.readMemory(readIop32(iop, 0x10214u) + '0', &digitZero, 1u) && digitZero == 0x04u,
+                "the ctype table should be rebuilt after an IOP reset")) return 1;
+
     return 0;
 }
diff --git a/ps2xIOP/tests/iop_import_tests.cpp b/ps2xIOP/tests/iop_import_tests.cpp
index 3035618..fda8343 100644
--- a/ps2xIOP/tests/iop_import_tests.cpp
+++ b/ps2xIOP/tests/iop_import_tests.cpp
@@ -1,6 +1,7 @@
 #include "emulator/core/iop_cpu.h"
 #include "emulator/core/iop_kernel.h"
 #include "emulator/core/iop_memory.h"
+#include "emulator/iop_emulator_const.h"
 #include "emulator/imports/iop_cdvd.h"
 #include "emulator/imports/iop_imports.h"
 #include "emulator/imports/iop_loadcore.h"
@@ -326,12 +327,77 @@ namespace
                expect(executor.lastGp == 0x89AB0u, "timer callback lost the registering module GP") &&
                expect(timrman.nextEventCycle(1000u) == 300u, "timer callback return did not rearm compare");
     }
+    // The IOP runs the highest-priority ready thread, first in first out within a priority. The emulator
+    // splits execution into host slices: the end of one is not a reschedule for the guest. CRI's PCM feeder
+    // threads (priority 39) must not swap between the left and right halves of a queue operation.
+    bool testThreadReadyQueue()
+    {
+        IopMemory memory;
+        IopKernel kernel(memory);
+        kernel.reset();
+        constexpr uint32_t descriptor = 0x3000u;
+        const auto create = [&](uint32_t priority)
+        {
+            memory.write32(descriptor + 0u, 0x02000000u);
+            memory.write32(descriptor + 4u, 0u);
+            memory.write32(descriptor + 8u, 0x4000u);
+            memory.write32(descriptor + 12u, 0x400u);
+            memory.write32(descriptor + 16u, priority);
+            IopCpuState cpu{};
+            cpu.gpr[4] = descriptor;
+            (void)kernel.dispatchThreadImport(4u, cpu, 0u);
+            return static_cast<int>(cpu.gpr[2]);
+        };
+        const auto start = [&](int id)
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = static_cast<uint32_t>(id);
+            (void)kernel.dispatchThreadImport(6u, cpu, 0u);
+        };
+        // Runs one host slice that ends with the thread still running, and returns its id.
+        const auto slice = [&]()
+        {
+            IopThread *thread = kernel.beginNextReady(0u);
+            if (thread == nullptr)
+                return 0;
+            const int id = thread->id;
+            kernel.endTimeslice(*thread, kThreadReturnSentinel);
+            return id;
+        };
