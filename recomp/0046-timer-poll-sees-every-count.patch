-        tc.Run("a timer read lets the EE clock catch up with host time up to the next VBlank", [](TestCase &t)
+        tc.Run("polling a timer lets the EE clock catch up with host time, one count per read, up to the next VBlank", [](TestCase &t)
         {
             // Timer 3 counts scan lines. A first VBlank comes 1/60 s (262 lines) after the
             // reset in NTSC and 1/50 s (312 lines) in PAL; a timer read never runs past it.
+            // Soulcalibur III measures Timer 0 against 256 changes of Timer 3, so a poll
+            // has to see every count, as on hardware, however late the host is.
             constexpr uint32_t kTimer3Count = 0x10001800u;
             for (const bool pal : {false, true})
             {
@@ -651,20 +654,89 @@ void register_ps2_runtime_interrupt_tests()
                 R5900Context mainContext{};
                 env.runtime.eeScheduler().reset(env.rdram.data(), mainContext);
                 const std::string mode = pal ? "PAL" : "NTSC";
-
