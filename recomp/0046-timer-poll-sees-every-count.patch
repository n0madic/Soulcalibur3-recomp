-                t.IsTrue(capped >= field - 1u && capped <= field + 1u,
+                t.IsTrue(count >= field - 1u && count <= field + 1u,
                          mode + ": the clock stops at the first VBlank, " + std::to_string(field) + " lines, got " +
-                             std::to_string(capped));
+                             std::to_string(count));
