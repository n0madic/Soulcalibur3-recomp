+            }
+        });
+
+        tc.Run("Timer 0 timed against 256 Timer 3 counts gives the bus clock ratio while the EE clock catches up", [](TestCase &t)
+        {
+            // Soulcalibur III's start-up calibration: it counts Timer 0 (BUSCLK/256)
+            // over 256 changes of Timer 3 (scan lines), reading Timer 3 once and then
+            // until it changes, and derives its frame period from the result. Each
+            // read is preceded by a checkpoint, as in generated code, so time slices
+            // end during the loop.
+            constexpr uint32_t kTimer0Count = 0x10000000u;
+            constexpr uint32_t kTimer0Mode = 0x10000010u;
+            constexpr uint32_t kTimer3Count = 0x10001800u;
+            TestEnv env;
+            t.IsTrue(env.runtime.memory().initialize(), "runtime memory initialize should succeed");
+            gsSetCrt(env.runtime.memory().gs(), 1u, 3u, 0u);
+            R5900Context mainContext{};
+            env.runtime.eeScheduler().reset(env.rdram.data(), mainContext);
+            env.runtime.memory().writeIORegister(kTimer0Mode, 0x82u);
+            env.runtime.memory().writeIORegister(kTimer0Count, 0u);
+            // The host is now ~300 scan lines ahead of the EE clock.
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+
+            const uint32_t start = env.runtime.memory().readIORegister(kTimer0Count);
+            EeScheduler &scheduler = env.runtime.eeScheduler();
+            auto readTimer3 = [&]()
+            {
+                (void)scheduler.checkpointDue();
+                return env.runtime.memory().readIORegister(kTimer3Count);
+            };
+            int changes = 0;
+            for (int reads = 0; changes < 256 && reads < 10000000; ++changes)
+            {
+                const uint32_t line = readTimer3();
+                while (readTimer3() == line && ++reads < 10000000)
+                {
+                }
             }
+            t.Equals(changes, 256, "Timer 3 should change 256 times before the first VBlank");
+            const uint32_t elapsed = env.runtime.memory().readIORegister(kTimer0Count) - start;
+            const uint32_t expected = 256u * 576000u / 15625u; // 9437
+            t.IsTrue(elapsed >= expected * 98u / 100u && elapsed <= expected * 102u / 100u,
+                     "Timer 0 should count " + std::to_string(expected) + " over 256 PAL scan lines, got " +
+                         std::to_string(elapsed));
+        });
+
+        tc.Run("a time slice ends with the EE clock caught up with host time", [](TestCase &t)
+        {
+            // Without timer reads the clock advances only by the cycles generated code
+            // charges, far slower than real time, which would hold the VBlank back.
+            constexpr uint32_t kTimer3Count = 0x10001800u;
+            TestEnv env;
+            t.IsTrue(env.runtime.memory().initialize(), "runtime memory initialize should succeed");
+            R5900Context mainContext{};
+            env.runtime.eeScheduler().reset(env.rdram.data(), mainContext);
+            std::this_thread::sleep_for(std::chrono::milliseconds(5));
+            (void)env.runtime.eeScheduler().checkpointDue(static_cast<uint32_t>(EeScheduler::kDefaultTimeSliceCycles));
+            const uint32_t lines = env.runtime.memory().readIORegister(kTimer3Count);
+            t.IsTrue(lines >= 75u, "5 ms of host time are at least 75 scan lines, got " + std::to_string(lines));
         });
 
         tc.Run("VBlank deadline resumes the waiter and publishes flag tick and FIELD atomically", [](TestCase &t)
