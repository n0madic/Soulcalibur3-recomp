+                t.IsTrue(count >= 75u, mode + ": 5 ms of host time are at least 75 scan lines, got " + std::to_string(count));
+                t.Equals(largestStep, 1u, mode + ": each read should advance the count by at most one");
                 std::this_thread::sleep_for(std::chrono::milliseconds(40));
-                const uint32_t capped = env.runtime.memory().readIORegister(kTimer3Count);
+                poll(count, largestStep);
