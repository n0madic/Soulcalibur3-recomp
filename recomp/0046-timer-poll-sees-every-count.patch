@@ -402,6 +407,19 @@ bool EeScheduler::checkpointDue(uint32_t cycles) noexcept
         return false;
     }
 
+    // Code that runs long without reading a timer must not hold the VBlank back
+    // either, so a time slice also ends with the clock caught up with host time.
+    // A guest that read a timer during the slice is paced by its reads instead,
+    // which must let it see every count.
+    if (!m_timerReadInSlice)
+        catchUpWithHostTime(std::numeric_limits<uint64_t>::max());
+    m_timerReadInSlice = false;
+    if (nextEventCycle != 0u && m_eeCycle >= nextEventCycle)
+    {
+        m_checkpointPending.store(true, std::memory_order_release);
+        return true;
+    }
+
     const GuestThread *running = currentThread();
     if (running != nullptr && hasReadyAtOrAbovePriority(running->currentPriority))
